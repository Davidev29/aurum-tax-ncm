props":{"codigo":"5310","descricao":"Tecidos de juta ou de outras fibras têxteis liberianas da posição 53.03."}},{"id":"SH4:5311","tipo":"SH4","props":{"codigo":"5311","descricao":null}},{"id":"SH4:5401","tipo":"SH4","props":{"codigo":"5401","descricao":"Linhas para costurar de filamentos sintéticos ou artificiais, mesmo acondicionadas para venda a retalho."}},{"id":"SH4:5402","tipo":"SH4","props":{"codigo":"5402","descricao":"Fios de filamentos sintéticos (exceto linhas para costurar), não acondicionados para venda a retalho, incluindo os monofilamentos sintéticos de título inferior a 67 decitex."}},{"id":"SH4:5403","tipo":"SH4","props":{"codigo":"5403","descricao":"Fios de filamentos artificiais (exceto linhas para costurar), não acondicionados para venda a retalho, incluindo os monofilamentos artificiais de título inferior a 67 decitex."}},{"id":"SH4:5404","tipo":"SH4","props":{"codigo":"5404","descricao":"Monofilamentos sintéticos, de título igual ou superior a 67 decitex e cuja maior dimensão da seção transversal não seja superior a 1 mm; lâminas e formas semelhantes (palha artificial, por exemplo) de matérias têxteis sintéticas, cuja largura aparente não seja superior a 5 mm."}},{"id":"SH4:5405","tipo":"SH4","props":{"codigo":"5405","descricao":null}},{"id":"SH4:5406","tipo":"SH4","props":{"codigo":"5406","descricao":null}},{"id":"SH4:5407","tipo":"SH4","props":{"codigo":"5407","descricao":"Tecidos de fios de filamentos sintéticos, incluindo os tecidos obtidos a partir dos produtos da posição 54.04."}},{"id":"SH4:5408","tipo":"SH4","props":{"codigo":"5408","descricao":"Tecidos de fios de filamentos artificiais, incluindo os tecidos obtidos a partir dos produtos da posição 54.05."}},{"id":"SH4:5501","tipo":"SH4","props":{"codigo":"5501","descricao":"Cabos de filamentos sintéticos."}},{"id":"SH4:5502","tipo":"SH4","props":{"codigo":"5502","descricao":"Cabos de filamentos artificiais."}},{"id":"SH4:5503","tipo":"SH4","props":{"codigo":"5503","descricao":"Fibras sintéticas descontínuas, não cardadas, não penteadas nem transformadas de outro modo para fiação."}},{"id":"SH4:5504","tipo":"SH4","props":{"codigo":"5504","descricao":"Fibras artificiais descontínuas, não cardadas, não penteadas nem transformadas de outro modo para fiação."}},{"id":"SH4:5505","tipo":"SH4","props":{"codigo":"5505","descricao":"Desperdícios de fibras sintéticas ou artificiais (incluindo os desperdícios da penteação, os de fios e os fiapos)."}},{"id":"SH4:5506","tipo":"SH4","props":{"codigo":"5506","descricao":"Fibras sintéticas descontínuas, cardadas, penteadas ou transformadas de outro modo para fiação."}},{"id":"SH4:5507","tipo":"SH4","props":{"codigo":"5507","descricao":null}},{"id":"SH4:5508","tipo":"SH4","props":{"codigo":"5508","descricao":"Linhas para costurar, de fibras sintéticas ou artificiais descontínuas, mesmo acondicionadas para venda a retalho."}},{"id":"SH4:5509","tipo":"SH4","props":{"codigo":"5509","descricao":"Fios de fibras sintéticas descontínuas (exceto linhas para costurar), não acondicionados para venda a retalho."}},{"id":"SH4:5510","tipo":"SH4","props":{"codigo":"5510","descricao":"Fios de fibras artificiais descontínuas (exceto linhas para costurar), não acondicionados para venda a retalho."}},{"id":"SH4:5511","tipo":"SH4","props":{"codigo":"5511","descricao":"Fios de fibras sintéticas ou artificiais, descontínuas (exceto linhas para costurar), acondicionados para venda a retalho."}},{"id":"SH4:5512","tipo":"SH4","props":{"codigo":"5512","descricao":"Tecidos de fibras sintéticas descontínuas, que contenham pelo menos 85 %, em peso, destas fibras."}},{"id":"SH4:5513","tipo":"SH4","props":{"codigo":"5513","descricao":"Tecidos de fibras sintéticas descontínuas, que contenham menos de 85 %, em peso, destas fibras, combinados, principal ou unicamente, com algodão, de peso não superior a 170 g/m<sup>2</sup>."}},{"id":"SH4:5514","tipo":"SH4","props":{"codigo":"5514","descricao":"Tecidos de fibras sintéticas descontínuas, que contenham menos de 85 %, em peso, destas fibras, combinados, principal ou unicamente, com algodão, de peso superior a 170 g/m<sup>2</sup>."}},{"id":"SH4:5515","tipo":"SH4","props":{"codigo":"5515","descricao":"Outros tecidos de fibras sintéticas descontínuas."}},{"id":"SH4:5516","tipo":"SH4","props":{"codigo":"5516","descricao":"Tecidos de fibras artificiais descontínuas."}},{"id":"SH4:5601","tipo":"SH4","props":{"codigo":"5601","descricao":"Pastas (<i>ouates</i>) de matérias têxteis e artigos destas pastas (<i>ouates</i>); fibras têxteis de comprimento não superior a 5 mm (<i>tontisses</i>), nós e bolotas (borbotos*) de matérias têxteis."}},{"id":"SH4:5602","tipo":"SH4","props":{"codigo":"5602","descricao":"Feltros, mesmo impregnados, revestidos, recobertos ou estratificados."}},{"id":"SH4:5603","tipo":"SH4","props":{"codigo":"5603","descricao":"Falsos tecidos (tecidos não tecidos), mesmo impregnados, revestidos, recobertos ou estratificados."}},{"id":"SH4:5604","tipo":"SH4","props":{"codigo":"5604","descricao":"Fios e cordas, de borracha, recobertos de têxteis; fios têxteis, lâminas e formas semelhantes das posições 54.04 ou 54.05, impregnados, revestidos, recobertos ou embainhados de borracha ou de plástico."}},{"id":"SH4:5605","tipo":"SH4","props":{"codigo":"5605","descricao":null}},{"id":"SH4:5606","tipo":"SH4","props":{"codigo":"5606","descricao":null}},{"id":"SH4:5607","tipo":"SH4","props":{"codigo":"5607","descricao":"Cordéis, cordas e cabos, entrançados ou não, mesmo impregnados, revestidos, recobertos ou embainhados de borracha ou de plástico."}},{"id":"SH4:5608","tipo":"SH4","props":{"codigo":"5608","descricao":"Redes de malhas com nós, em panos ou em peça, obtidas a partir de cordéis, cordas ou cabos; redes confeccionadas para a pesca e outras redes confeccionadas, de matérias têxteis."}},{"id":"SH4:5609","tipo":"SH4","props":{"codigo":"5609","descricao":null}},{"id":"SH4:5701","tipo":"SH4","props":{"codigo":"5701","descricao":"Tapetes de matérias têxteis, de pontos nodados ou enrolados, mesmo confeccionados."}},{"id":"SH4:5702","tipo":"SH4","props":{"codigo":"5702","descricao":"Tapetes e outros revestimentos para pisos (pavimentos), de matérias têxteis, tecidos, não tufados nem flocados, mesmo confeccionados, incluindo os tapetes denominados <i>Kelim</i> ou <i>Kilim</i>, <i>Schumacks</i> ou <i>Soumak</i>, <i>Karamanie</i> e tapetes semelhantes tecidos à mão."}},{"id":"SH4:5703","tipo":"SH4","props":{"codigo":"5703","descricao":"Tapetes e outros revestimentos para pisos (pavimentos), de matérias têxteis (incluindo a grama (relva)), tufados, mesmo confeccionados."}},{"id":"SH4:5704","tipo":"SH4","props":{"codigo":"5704","descricao":"Tapetes e outros revestimentos para pisos (pavimentos), de feltro, exceto os tufados e os flocados, mesmo confeccionados."}},{"id":"SH4:5705","tipo":"SH4","props":{"codigo":"5705","descricao":null}},{"id":"SH4:5801","tipo":"SH4","props":{"codigo":"5801","descricao":"Veludos e pelúcias tecidos e tecidos de froco (<i>chenille</i>), exceto os artigos das posições 58.02 ou 58.06."}},{"id":"SH4:5802","tipo":"SH4","props":{"codigo":"5802","descricao":"Tecidos atoalhados (turcos), exceto os artigos da posição 58.06; tecidos tufados, exceto os artigos da posição 57.03."}},{"id":"SH4:5803","tipo":"SH4","props":{"codigo":"5803","descricao":null}},{"id":"SH4:5804","tipo":"SH4","props":{"codigo":"5804","descricao":"Tules, filó e tecidos de malhas com nós; rendas em peça, em tiras ou em motivos, para aplicar, exceto os produtos das posições 60.02 a 60.06."}},{"id":"SH4:5805","tipo":"SH4","props":{"codigo":"5805","descricao":null}},{"id":"SH4:5806","tipo":"SH4","props":{"codigo":"5806","descricao":"Fitas, exceto os artigos da posição 58.07; fitas sem trama, de fios ou fibras paralelizados e colados (<i>bolducs</i>)."}},{"id":"SH4:5807","tipo":"SH4","props":{"codigo":"5807","descricao":"Etiquetas, emblemas e artigos semelhantes de matérias têxteis, em peça, em fitas ou recortados em forma própria, não bordados."}},{"id":"SH4:5808","tipo":"SH4","props":{"codigo":"5808","descricao":"Tranças em peça; artigos de passamanaria e artigos ornamentais análogos, em peça, não bordados, exceto de malha; borlas, pompons e artigos semelhantes."}},{"id":"SH4:5809","tipo":"SH4","props":{"codigo":"5809","descricao":null}},{"id":"SH4:5810","tipo":"SH4","props":{"codigo":"5810","descricao":"Bordados em peça, em tiras ou em motivos."}},{"id":"SH4:5811","tipo":"SH4","props":{"codigo":"5811","descricao":null}},{"id":"SH4:5901","tipo":"SH4","props":{"codigo":"5901","descricao":"Tecidos revestidos de cola ou de matérias amiláceas, do tipo utilizado na encadernação, cartonagem ou usos semelhantes; telas para decalque e telas transparentes para desenho; telas preparadas para pintura; entretelas e tecidos rígidos semelhantes, do tipo utilizado em chapéus e artigos de uso semelhante."}},{"id":"SH4:5902","tipo":"SH4","props":{"codigo":"5902","descricao":"Telas para pneumáticos fabricadas com fios de alta tenacidade de náilon ou de outras poliamidas, de poliésteres ou de raiom viscose."}},{"id":"SH4:5903","tipo":"SH4","props":{"codigo":"5903","descricao":"Tecidos impregnados, revestidos, recobertos ou estratificados, com plástico, exceto os da posição 59.02."}},{"id":"SH4:5904","tipo":"SH4","props":{"codigo":"5904","descricao":"Linóleos, mesmo recortados; revestimentos para pisos (pavimentos) constituídos por um revestimento ou recobrimento aplicado sobre suporte têxtil, mesmo recortados."}},{"id":"SH4:5905","tipo":"SH4","props":{"codigo":"5905","descricao":null}},{"id":"SH4:5906","tipo":"SH4","props":{"codigo":"5906","descricao":"Tecidos com borracha, exceto os da posição 59.02."}},{"id":"SH4:5907","tipo":"SH4","props":{"codigo":"5907","descricao":null}},{"id":"SH4:5908","tipo":"SH4","props":{"codigo":"5908","descricao":null}},{"id":"SH4:5909","tipo":"SH4","props":{"codigo":"5909","descricao":null}},{"id":"SH4:5910","tipo":"SH4","props":{"codigo":"5910","descricao":null}},{"id":"SH4:5911","tipo":"SH4","props":{"codigo":"5911","descricao":"Produtos e artigos, de matérias têxteis, para usos técnicos, indicados na Nota 8 do presente Capítulo."}},{"id":"SH4:6001","tipo":"SH4","props":{"codigo":"6001","descricao":"Veludos e pelúcias (incluindo os tecidos denominados de \"felpa longa\" ou \"pelo comprido\") e tecidos de anéis, de malha."}},{"id":"SH4:6002","tipo":"SH4","props":{"codigo":"6002","descricao":"Tecidos de malha de largura não superior a 30 cm, que contenham, em peso, 5 % ou mais de fios de elastômeros ou de fios de borracha, exceto os da posição 60.01."}},{"id":"SH4:6003","tipo":"SH4","props":{"codigo":"6003","descricao":"Tecidos de malha de largura não superior a 30 cm, exceto os das posições 60.01 e 60.02."}},{"id":"SH4:6004","tipo":"SH4","props":{"codigo":"6004","descricao":"Tecidos de malha de largura superior a 30 cm, que contenham, em peso, 5 % ou mais de fios de elastômeros ou de fios de borracha, exceto os da posição 60.01."}},{"id":"SH4:6005","tipo":"SH4","props":{"codigo":"6005","descricao":"Tecidos de malha-urdidura (incluindo os fabricados em teares para galões), exceto os das posições 60.01 a 60.04."}},{"id":"SH4:6006","tipo":"SH4","props":{"codigo":"6006","descricao":"Outros tecidos de malha."}},{"id":"SH4:6101","tipo":"SH4","props":{"codigo":"6101","descricao":"Sobretudos, japonas, gabões, capas, anoraques, casacos (blusões*) e semelhantes, de malha, de uso masculino, exceto os artigos da posição 61.03."}},{"id":"SH4:6102","tipo":"SH4","props":{"codigo":"6102","descricao":"Mantôs (Casacos compridos*), capas, anoraques, casacos (blusões*) e semelhantes, de malha, de uso feminino, exceto os artigos da posição 61.04."}},{"id":"SH4:6103","tipo":"SH4","props":{"codigo":"6103","descricao":"Ternos (Fatos*), conjuntos, paletós (casacos*), calças, jardineiras, bermudas e <i>shorts</i> (calções) (exceto de banho), de malha, de uso masculino."}},{"id":"SH4:6104","tipo":"SH4","props":{"codigo":"6104","descricao":"<i>Tailleurs</i> (Fatos de saia-casaco*), conjuntos, <i>blazers</i> (casacos*), vestidos, saias, saias-calças, calças, jardineiras, bermudas e <i>shorts</i> (calções) (exceto de banho), de malha, de uso feminino."}},{"id":"SH4:6105","tipo":"SH4","props":{"codigo":"6105","descricao":"Camisas de malha, de uso masculino."}},{"id":"SH4:6106","tipo":"SH4","props":{"codigo":"6106","descricao":"Camisas (Camiseiros*), blusas, blusas <i>chemisiers</i> (blusas-camiseiros*), de malha, de uso feminino."}},{"id":"SH4:6107","tipo":"SH4","props":{"codigo":"6107","descricao":"Cuecas, ceroulas, camisolões (camisas de noite*), pijamas, roupões de banho, robes e semelhantes, de malha, de uso masculino."}},{"id":"SH4:6108","tipo":"SH4","props":{"codigo":"6108","descricao":"Combinações, anáguas (saiotes), calcinhas, camisolas (camisas de noite*), pijamas, <i>déshabillés</i>, roupões de banho, penhoares (robes de quarto*) e semelhantes, de malha, de uso feminino."}},{"id":"SH4:6109","tipo":"SH4","props":{"codigo":"6109","descricao":"Camisetas (<i>T-shirts</i>), camisetas interiores (camisolas interiores*), e artigos semelhantes, de malha."}},{"id":"SH4:6110","tipo":"SH4","props":{"codigo":"6110","descricao":"Suéteres (Camisolas*), pulôveres, cardigãs, coletes e artigos semelhantes, de malha."}},{"id":"SH4:6111","tipo":"SH4","props":{"codigo":"6111","descricao":"Vestuário e seus acessórios, de malha, para bebês."}},{"id":"SH4:6112","tipo":"SH4","props":{"codigo":"6112","descricao":"Abrigos (Fatos de treino*) para esporte, macacões (fatos-macacos*) e conjuntos, de esqui, maiôs (fatos de banho*), biquínis, <i>shorts</i> (calções) e sungas (<i>slips</i>), de banho, de malha."}},{"id":"SH4:6113","tipo":"SH4","props":{"codigo":"6113","descricao":null}},{"id":"SH4:6114","tipo":"SH4","props":{"codigo":"6114","descricao":"Outro vestuário de malha."}},{"id":"SH4:6115","tipo":"SH4","props":{"codigo":"6115","descricao":"Meias-calças, meias acima do joelho, meias até o joelho e artigos semelhantes, incluindo as meias-calças, meias acima do joelho e meias até o joelho, de compressão degressiva (as meias para varizes, por exemplo), de malha."}},{"id":"SH4:6116","tipo":"SH4","props":{"codigo":"6116","descricao":"Luvas, mitenes e semelhantes, de malha."}},{"id":"SH4:6117","tipo":"SH4","props":{"codigo":"6117","descricao":"Outros acessórios de vestuário, confeccionados, de malha; partes de vestuário ou de seus acessórios, de malha."}},{"id":"SH4:6201","tipo":"SH4","props":{"codigo":"6201","descricao":"Sobretudos, japonas, gabões, capas, anoraques, casacos (blusões*) e semelhantes, de uso masculino, exceto os artigos da posição 62.03."}},{"id":"SH4:6202","tipo":"SH4","props":{"codigo":"6202","descricao":"Mantôs (Casacos compridos*), capas, anoraques, casacos (blusões*) e semelhantes, de uso feminino, exceto os artigos da posição 62.04."}},{"id":"SH4:6203","tipo":"SH4","props":{"codigo":"6203","descricao":"Ternos (Fatos*), conjuntos, paletós (casacos*), calças, jardineiras, bermudas e <i>shorts</i> (calções) (exceto de banho), de uso masculino."}},{"id":"SH4:6204","tipo":"SH4","props":{"codigo":"6204","descricao":"<i>Tailleurs</i> (Fatos de saia-casaco*), conjuntos, <i>blazers</i> (casacos*), vestidos, saias, saias-calças, calças, jardineiras, bermudas e <i>shorts</i> (calções) (exceto de banho), de uso feminino."}},{"id":"SH4:6205","tipo":"SH4","props":{"codigo":"6205","descricao":"Camisas de uso masculino."}},{"id":"SH4:6206","tipo":"SH4","props":{"codigo":"6206","descricao":"Camisas (Camiseiros*), blusas, blusas <i>chemisiers</i> (blusas-camiseiros*), de uso feminino."}},{"id":"SH4:6207","tipo":"SH4","props":{"codigo":"6207","descricao":"Camisetas interiores (Camisolas interiores*), cuecas, ceroulas, camisolões (camisas de noite*), pijamas, roupões de banho, robes, e artigos semelhantes, de uso masculino."}},{"id":"SH4:6208","tipo":"SH4","props":{"codigo":"6208","descricao":"Corpetes (Camisolas interiores*), combinações, anáguas (saiotes), calcinhas, camisolas (camisas de noite*), pijamas, <i>déshabillés</i>, roupões de banho, penhoares (robes de quarto*), e artigos semelhantes, de uso feminino."}},{"id":"SH4:6209","tipo":"SH4","props":{"codigo":"6209","descricao":"Vestuário e seus acessórios, para bebês."}},{"id":"SH4:6210","tipo":"SH4","props":{"codigo":"6210","descricao":"Vestuário confeccionado com as matérias das posições 56.02, 56.03, 59.03, 59.06 ou 59.07."}},{"id":"SH4:6211","tipo":"SH4","props":{"codigo":"6211","descricao":"Abrigos (Fatos de treino*) para esporte, macacões (fatos-macacos*) e conjuntos, de esqui, maiôs (fatos de banho*), biquínis, <i>shorts</i> (calções) e sungas (<i>slips</i>), de banho; outro vestuário."}},{"id":"SH4:6212","tipo":"SH4","props":{"codigo":"6212","descricao":"Sutiãs, cintas, espartilhos, suspensórios, ligas e artigos semelhantes, e suas partes, mesmo de malha."}},{"id":"SH4:6213","tipo":"SH4","props":{"codigo":"6213","descricao":"Lenços de assoar e de bolso."}},{"id":"SH4:6214","tipo":"SH4","props":{"codigo":"6214","descricao":"Xales, echarpes, lenços de pescoço, cachenês, cachecóis, mantilhas, véus e artigos semelhantes."}},{"id":"SH4:6215","tipo":"SH4","props":{"codigo":"6215","descricao":"Gravatas, gravatas-borboletas (laços*) e plastrões."}},{"id":"SH4:6216","tipo":"SH4","props":{"codigo":"6216","descricao":null}},{"id":"SH4:6217","tipo":"SH4","props":{"codigo":"6217","descricao":"Outros acessórios confeccionados de vestuário; partes de vestuário ou dos seus acessórios, exceto as da posição 62.12."}},{"id":"SH4:6301","tipo":"SH4","props":{"codigo":"6301","descricao":"Cobertores e mantas."}},{"id":"SH4:6302","tipo":"SH4","props":{"codigo":"6302","descricao":"Roupa de cama, mesa, toucador ou cozinha."}},{"id":"SH4:6303","tipo":"SH4","props":{"codigo":"6303","descricao":"Cortinados, cortinas, reposteiros e estores; sanefas."}},{"id":"SH4:6304","tipo":"SH4","props":{"codigo":"6304","descricao":"Outros artigos para guarnição de interiores, exceto os da posição 94.04."}},{"id":"SH4:6305","tipo":"SH4","props":{"codigo":"6305","descricao":"Sacos de quaisquer dimensões, para embalagem."}},{"id":"SH4:6306","tipo":"SH4","props":{"codigo":"6306","descricao":"Encerados e toldos; tendas (incluindo os gazebos temporários e artigos semelhantes); velas para embarcações, para pranchas à vela ou para carros à vela; artigos para acampamento."}},{"id":"SH4:6307","tipo":"SH4","props":{"codigo":"6307","descricao":"Outros artigos confeccionados, incluindo os moldes para vestuário."}},{"id":"SH4:6308","tipo":"SH4","props":{"codigo":"6308","descricao":null}},{"id":"SH4:6309","tipo":"SH4","props":{"codigo":"6309","descricao":null}},{"id":"SH4:6310","tipo":"SH4","props":{"codigo":"6310","descricao":"Trapos, cordéis, cordas e cabos, de matérias têxteis, em forma de desperdícios ou de artigos inutilizados."}},{"id":"SH4:6401","tipo":"SH4","props":{"codigo":"6401","descricao":"Calçado impermeável de sola exterior e parte superior de borracha ou plástico, em que a parte superior não tenha sido reunida à sola exterior por costura ou por meio de rebites, pregos, parafusos, espigões ou dispositivos semelhantes, nem formada por diferentes partes reunidas pelos mesmos processos."}},{"id":"SH4:6402","tipo":"SH4","props":{"codigo":"6402","descricao":"Outro calçado com sola exterior e parte superior de borracha ou plástico."}},{"id":"SH4:6403","tipo":"SH4","props":{"codigo":"6403","descricao":"Calçado com sola exterior de borracha, plástico, couro natural ou reconstituído e parte superior de couro natural."}},{"id":"SH4:6404","tipo":"SH4","props":{"codigo":"6404","descricao":"Calçado com sola exterior de borracha, plástico, couro natural ou reconstituído e parte superior de matérias têxteis."}},{"id":"SH4:6405","tipo":"SH4","props":{"codigo":"6405","descricao":"Outro calçado."}},{"id":"SH4:6406","tipo":"SH4","props":{"codigo":"6406","descricao":"Partes de calçado (incluindo as partes superiores, mesmo fixadas a solas que não sejam as solas exteriores); palmilhas, reforços interiores e artigos semelhantes, amovíveis; polainas, perneiras e artigos semelhantes, e suas partes."}},{"id":"SH4:6501","tipo":"SH4","props":{"codigo":"6501","descricao":null}},{"id":"SH4:6502","tipo":"SH4","props":{"codigo":"6502","descricao":null}},{"id":"SH4:6504","tipo":"SH4","props":{"codigo":"6504","descricao":null}},{"id":"SH4:6505","tipo":"SH4","props":{"codigo":"6505","descricao":null}},{"id":"SH4:6506","tipo":"SH4","props":{"codigo":"6506","descricao":"Outros chapéus e artigos de uso semelhante, mesmo guarnecidos."}},{"id":"SH4:6507","tipo":"SH4","props":{"codigo":"6507","descricao":null}},{"id":"SH4:6601","tipo":"SH4","props":{"codigo":"6601","descricao":"Guarda-chuvas, sombrinhas e guarda-sóis (incluindo as bengalas-guarda-chuvas e os guarda-sóis de jardim e semelhantes)."}},{"id":"SH4:6602","tipo":"SH4","props":{"codigo":"6602","descricao":null}},{"id":"SH4:6603","tipo":"SH4","props":{"codigo":"6603","descricao":"Partes, guarnições e acessórios, para os artigos das posições 66.01 ou 66.02."}},{"id":"SH4:6701","tipo":"SH4","props":{"codigo":"6701","descricao":null}},{"id":"SH4:6702","tipo":"SH4","props":{"codigo":"6702","descricao":"Flores, folhagem e frutos, artificiais, e suas partes; artigos confeccionados com flores, folhagem e frutos, artificiais."}},{"id":"SH4:6703","tipo":"SH4","props":{"codigo":"6703","descricao":null}},{"id":"SH4:6704","tipo":"SH4","props":{"codigo":"6704","descricao":"Perucas, barbas, sobrancelhas, pestanas, madeixas e artigos semelhantes, de cabelo, pelos ou de matérias têxteis; outras obras de cabelo não especificadas nem compreendidas noutras posições."}},{"id":"SH4:6801","tipo":"SH4","props":{"codigo":"6801","descricao":null}},{"id":"SH4:6802","tipo":"SH4","props":{"codigo":"6802","descricao":"Pedras de cantaria ou de construção (exceto de ardósia) trabalhadas e obras destas pedras, exceto as da posição 68.01; cubos, pastilhas e artigos semelhantes, para mosaicos, de pedra natural (incluindo a ardósia), mesmo com suporte; grânulos, fragmentos e pós, de pedra natural (incluindo a ardósia), corados artificialmente."}},{"id":"SH4:6803","tipo":"SH4","props":{"codigo":"6803","descricao":null}},{"id":"SH4:6804","tipo":"SH4","props":{"codigo":"6804","descricao":"Mós e artigos semelhantes, sem armação, para moer, desfibrar, triturar, amolar, polir, retificar ou cortar; pedras para amolar ou para polir, manualmente, e suas partes, de pedras naturais, de abrasivos naturais ou artificiais aglomerados ou de cerâmica, mesmo com partes de outras matérias."}},{"id":"SH4:6805","tipo":"SH4","props":{"codigo":"6805","descricao":"Abrasivos naturais ou artificiais, em pó ou em grãos, aplicados sobre matérias têxteis, papel, cartão ou outras matérias, mesmo recortados, costurados ou reunidos de outro modo."}},{"id":"SH4:6806","tipo":"SH4","props":{"codigo":"6806","descricao":"Lãs de escórias de altos-fornos, lãs de outras escórias, lã de rocha e lãs minerais semelhantes; vermiculita e argilas, expandidas, espuma de escórias e produtos minerais semelhantes, expandidos; misturas e obras de matérias minerais para isolamento do calor e do som ou para absorção do som, exceto as das posições 68.11, 68.12 ou do Capítulo 69."}},{"id":"SH4:6807","tipo":"SH4","props":{"codigo":"6807","descricao":"Obras de asfalto ou de produtos semelhantes (por exemplo, breu ou pez)."}},{"id":"SH4:6808","tipo":"SH4","props":{"codigo":"6808","descricao":null}},{"id":"SH4:6809","tipo":"SH4","props":{"codigo":"6809","descricao":"Obras de gesso ou de composições à base de gesso."}},{"id":"SH4:6810","tipo":"SH4","props":{"codigo":"6810","descricao":"Obras de cimento, de concreto (betão) ou de pedra artificial, mesmo armadas."}},{"id":"SH4:6811","tipo":"SH4","props":{"codigo":"6811","descricao":"Obras de fibrocimento, cimento-celulose ou produtos semelhantes."}},{"id":"SH4:6812","tipo":"SH4","props":{"codigo":"6812","descricao":"Amianto trabalhado, em fibras; misturas à base de amianto ou à base de amianto e carbonato de magnésio; obras destas misturas ou de amianto (por exemplo, fios, tecidos, vestuário, chapéus e artigos de uso semelhante, calçado, juntas), mesmo armadas, exceto as das posições 68.11 ou 68.13."}},{"id":"SH4:6813","tipo":"SH4","props":{"codigo":"6813","descricao":"Guarnições de fricção (por exemplo, placas, rolos, tiras, segmentos, discos, anéis, pastilhas), não montadas, para freios (travões), embreagens ou qualquer outro mecanismo de fricção, à base de amianto, de outras substâncias minerais ou de celulose, mesmo combinadas com têxteis ou outras matérias."}},{"id":"SH4:6814","tipo":"SH4","props":{"codigo":"6814","descricao":"Mica trabalhada e obras de mica, incluindo a mica aglomerada ou reconstituída, mesmo com suporte de papel, de cartão ou de outras matérias."}},{"id":"SH4:6815","tipo":"SH4","props":{"codigo":"6815","descricao":"Obras de pedra ou de outras matérias minerais (incluindo as fibras de carbono, as obras destas matérias e as de turfa), não especificadas nem compreendidas noutras posições."}},{"id":"SH4:6901","tipo":"SH4","props":{"codigo":"6901","descricao":null}},{"id":"SH4:6902","tipo":"SH4","props":{"codigo":"6902","descricao":"Tijolos, placas (lajes), ladrilhos e peças cerâmicas semelhantes, para construção, refratários, que não sejam de farinhas siliciosas fósseis nem de terras siliciosas semelhantes."}},{"id":"SH4:6903","tipo":"SH4","props":{"codigo":"6903","descricao":"Outros produtos cerâmicos refratários (por exemplo, retortas, cadinhos, muflas, bocais, tampões, suportes, copelas, tubos, mangas, varetas, \"portas\" deslizantes (<i>slide gates</i>)) que não sejam de farinhas siliciosas fósseis nem de terras siliciosas semelhantes."}},{"id":"SH4:6904","tipo":"SH4","props":{"codigo":"6904","descricao":"Tijolos para construção, tijoleiras, tapa-vigas e produtos semelhantes, de cerâmica."}},{"id":"SH4:6905","tipo":"SH4","props":{"codigo":"6905","descricao":"Telhas, elementos de chaminés, condutores de fumaça (fumo), ornamentos arquitetônicos, de cerâmica, e outros produtos cerâmicos para construção."}},{"id":"SH4:6906","tipo":"SH4","props":{"codigo":"6906","descricao":null}},{"id":"SH4:6907","tipo":"SH4","props":{"codigo":"6907","descricao":"Ladrilhos e placas (lajes), para pavimentação ou revestimento, de cerâmica; cubos, pastilhas e artigos semelhantes, para mosaicos, de cerâmica, mesmo com suporte; peças de acabamento, de cerâmica."}},{"id":"SH4:6909","tipo":"SH4","props":{"codigo":"6909","descricao":"Aparelhos e artigos para usos químicos ou para outros usos técnicos, de cerâmica; alguidares, gamelas e outros recipientes semelhantes para usos rurais, de cerâmica; bilhas e outras vasilhas próprias para transporte ou embalagem, de cerâmica."}},{"id":"SH4:6910","tipo":"SH4","props":{"codigo":"6910","descricao":"Pias, lavatórios, colunas para lavatórios, banheiras, bidés, sanitários, caixas de descarga (autoclismos*), mictórios e aparelhos fixos semelhantes para usos sanitários, de cerâmica."}},{"id":"SH4:6911","tipo":"SH4","props":{"codigo":"6911","descricao":"Serviços de mesa, artigos de cozinha, outros artigos de uso doméstico e artigos de higiene ou de toucador, de porcelana."}},{"id":"SH4:6912","tipo":"SH4","props":{"codigo":"6912","descricao":null}},{"id":"SH4:6913","tipo":"SH4","props":{"codigo":"6913","descricao":"Estatuetas e outros objetos de ornamentação, de cerâmica."}},{"id":"SH4:6914","tipo":"SH4","props":{"codigo":"6914","descricao":"Outras obras de cerâmica."}},{"id":"SH4:7001","tipo":"SH4","props":{"codigo":"7001","descricao":null}},{"id":"SH4:7002","tipo":"SH4","props":{"codigo":"7002","descricao":"Vidro em esferas (exceto as microsferas da posição 70.18), barras, varetas ou tubos, não trabalhado."}},{"id":"SH4:7003","tipo":"SH4","props":{"codigo":"7003","descricao":"Vidro vazado ou laminado, em chapas, folhas ou perfis, mesmo com camada absorvente, refletora ou não, mas não trabalhado de outro modo."}},{"id":"SH4:7004","tipo":"SH4","props":{"codigo":"7004","descricao":"Vidro estirado ou soprado, em folhas, mesmo com camada absorvente, refletora ou não, mas não trabalhado de outro modo."}},{"id":"SH4:7005","tipo":"SH4","props":{"codigo":"7005","descricao":"Vidro flotado e vidro desbastado ou polido numa ou em ambas as faces, em chapas ou em folhas, mesmo com camada absorvente, refletora ou não, mas não trabalhado de outro modo."}},{"id":"SH4:7006","tipo":"SH4","props":{"codigo":"7006","descricao":null}},{"id":"SH4:7007","tipo":"SH4","props":{"codigo":"7007","descricao":"Vidros de segurança consistindo em vidros temperados ou formados por folhas contracoladas."}},{"id":"SH4:7008","tipo":"SH4","props":{"codigo":"7008","descricao":null}},{"id":"SH4:7009","tipo":"SH4","props":{"codigo":"7009","descricao":"Espelhos de vidro, mesmo emoldurados, incluindo os espelhos retrovisores."}},{"id":"SH4:7010","tipo":"SH4","props":{"codigo":"7010","descricao":"Garrafões, garrafas, frascos, boiões, vasos, embalagens tubulares, ampolas e outros recipientes de vidro próprios para transporte ou embalagem; boiões de vidro para conservas; rolhas, tampas e outros dispositivos para fechar recipientes, de vidro."}},{"id":"SH4:7011","tipo":"SH4","props":{"codigo":"7011","descricao":"Ampolas e invólucros, mesmo tubulares, abertos, e suas partes, de vidro, sem guarnições, para lâmpadas e fontes de luz, elétricas, tubos catódicos ou semelhantes."}},{"id":"SH4:7013","tipo":"SH4","props":{"codigo":"7013","descricao":"Objetos de vidro para serviço de mesa, cozinha, toucador, escritório, ornamentação de interiores ou usos semelhantes (exceto os das posições 70.10 ou 70.18)."}},{"id":"SH4:7014","tipo":"SH4","props":{"codigo":"7014","descricao":null}},{"id":"SH4:7015","tipo":"SH4","props":{"codigo":"7015","descricao":"Vidros de relojoaria e vidros semelhantes, vidros para lentes, mesmo corretivas, curvos ou arqueados, ocos ou semelhantes, não trabalhados opticamente; esferas ocas e segmentos de esferas, de vidro, para fabricação desses vidros."}},{"id":"SH4:7016","tipo":"SH4","props":{"codigo":"7016","descricao":"Blocos, placas, tijolos, ladrilhos, telhas e outros artigos, de vidro prensado ou moldado, mesmo armado, para construção; cubos, pastilhas e outros artigos semelhantes, de vidro, mesmo com suporte, para mosaicos ou decorações semelhantes; vitrais de vidro; vidro denominado \"multicelular\" ou \"espuma\" de vidro, em blocos, painéis, chapas e conchas ou formas semelhantes."}},{"id":"SH4:7017","tipo":"SH4","props":{"codigo":"7017","descricao":"Artigos de vidro para laboratório, higiene ou farmácia, mesmo graduados ou calibrados."}},{"id":"SH4:7018","tipo":"SH4","props":{"codigo":"7018","descricao":"Contas, imitações de pérolas naturais ou cultivadas, imitações de pedras preciosas ou semipreciosas e artigos semelhantes, de vidro e suas obras, exceto bijuterias; olhos de vidro, exceto de prótese; estatuetas e outros objetos de ornamentação, de vidro trabalhado a maçarico, exceto bijuterias; microsferas de vidro, de diâmetro não superior a 1 mm."}},{"id":"SH4:7019","tipo":"SH4","props":{"codigo":"7019","descricao":"Fibras de vidro (incluindo a lã de vidro) e suas obras (por exemplo, fios, mechas ligeiramente torcidas (<i>rovings</i>), tecidos)."}},{"id":"SH4:7020","tipo":"SH4","props":{"codigo":"7020","descricao":null}},{"id":"SH4:7101","tipo":"SH4","props":{"codigo":"7101","descricao":"Pérolas naturais ou cultivadas, mesmo trabalhadas ou combinadas, mas não enfiadas, nem montadas, nem engastadas; pérolas naturais ou cultivadas, enfiadas temporariamente para facilidade de transporte."}},{"id":"SH4:7102","tipo":"SH4","props":{"codigo":"7102","descricao":"Diamantes, mesmo trabalhados, mas não montados nem engastados."}},{"id":"SH4:7103","tipo":"SH4","props":{"codigo":"7103","descricao":"Pedras preciosas (exceto diamantes) ou semipreciosas, mesmo trabalhadas ou combinadas, mas não enfiadas, nem montadas, nem engastadas; pedras preciosas (exceto diamantes) ou semipreciosas, não combinadas, enfiadas temporariamente para facilidade de transporte."}},{"id":"SH4:7104","tipo":"SH4","props":{"codigo":"7104","descricao":"Pedras sintéticas ou reconstituídas, mesmo trabalhadas ou combinadas, mas não enfiadas, nem montadas, nem engastadas; pedras sintéticas ou reconstituídas, não combinadas, enfiadas temporariamente para facilidade de transporte."}},{"id":"SH4:7105","tipo":"SH4","props":{"codigo":"7105","descricao":"Pó de diamantes, de pedras preciosas ou semipreciosas ou de pedras sintéticas."}},{"id":"SH4:7106","tipo":"SH4","props":{"codigo":"7106","descricao":"Prata (incluindo a prata dourada ou platinada), em formas brutas ou semimanufaturadas, ou em pó."}},{"id":"SH4:7107","tipo":"SH4","props":{"codigo":"7107","descricao":null}},{"id":"SH4:7108","tipo":"SH4","props":{"codigo":"7108","descricao":"Ouro (incluindo o ouro platinado), em formas brutas ou semimanufaturadas, ou em pó."}},{"id":"SH4:7109","tipo":"SH4","props":{"codigo":"7109","descricao":null}},{"id":"SH4:7110","tipo":"SH4","props":{"codigo":"7110","descricao":"Platina, em formas brutas ou semimanufaturadas, ou em pó."}},{"id":"SH4:7111","tipo":"SH4","props":{"codigo":"7111","descricao":null}},{"id":"SH4:7112","tipo":"SH4","props":{"codigo":"7112","descricao":"Desperdícios e resíduos de metais preciosos ou de metais folheados ou chapeados de metais preciosos (plaquê); outros desperdícios e resíduos que contenham metais preciosos ou compostos de metais preciosos, do tipo utilizado principalmente para a recuperação de metais preciosos, exceto os produtos da posição 85.49."}},{"id":"SH4:7113","tipo":"SH4","props":{"codigo":"7113","descricao":"Artigos de joalheria e suas partes, de metais preciosos ou de metais folheados ou chapeados de metais preciosos (plaquê)."}},{"id":"SH4:7114","tipo":"SH4","props":{"codigo":"7114","descricao":"Artigos de ourivesaria e suas partes, de metais preciosos ou de metais folheados ou chapeados de metais preciosos (plaquê)."}},{"id":"SH4:7115","tipo":"SH4","props":{"codigo":"7115","descricao":"Outras obras de metais preciosos ou de metais folheados ou chapeados de metais preciosos (plaquê)."}},{"id":"SH4:7116","tipo":"SH4","props":{"codigo":"7116","descricao":"Obras de pérolas naturais ou cultivadas, de pedras preciosas ou semipreciosas ou de pedras sintéticas ou reconstituídas."}},{"id":"SH4:7117","tipo":"SH4","props":{"codigo":"7117","descricao":"Bijuterias."}},{"id":"SH4:7118","tipo":"SH4","props":{"codigo":"7118","descricao":"Moedas."}},{"id":"SH4:7201","tipo":"SH4","props":{"codigo":"7201","descricao":"Ferro fundido bruto e ferro <i>spiegel</i> (especular), em lingotes, linguados ou outras formas primárias."}},{"id":"SH4:7202","tipo":"SH4","props":{"codigo":"7202","descricao":"Ferroligas."}},{"id":"SH4:7203","tipo":"SH4","props":{"codigo":"7203","descricao":"Produtos ferrosos obtidos por redução direta dos minérios de ferro e outros produtos ferrosos esponjosos, em pedaços, esferas ou formas semelhantes; ferro de pureza mínima, em peso, de 99,94 %, em pedaços, esferas ou formas semelhantes."}},{"id":"SH4:7204","tipo":"SH4","props":{"codigo":"7204","descricao":"Desperdícios e resíduos, e sucata, de ferro fundido, ferro ou aço; desperdícios e resíduos, em lingotes, de ferro ou aço."}},{"id":"SH4:7205","tipo":"SH4","props":{"codigo":"7205","descricao":"Granalhas e pós de ferro fundido bruto, de ferro <i>spiegel</i> (especular), de ferro ou aço."}},{"id":"SH4:7206","tipo":"SH4","props":{"codigo":"7206","descricao":"Ferro e aço não ligado, em lingotes ou outras formas primárias, exceto o ferro da posição 72.03."}},{"id":"SH4:7207","tipo":"SH4","props":{"codigo":"7207","descricao":"Produtos semimanufaturados de ferro ou aço não ligado."}},{"id":"SH4:7208","tipo":"SH4","props":{"codigo":"7208","descricao":"Produtos laminados planos, de ferro ou aço não ligado, de largura igual ou superior a 600 mm, laminados a quente, não folheados ou chapeados, nem revestidos."}},{"id":"SH4:7209","tipo":"SH4","props":{"codigo":"7209","descricao":"Produtos laminados planos, de ferro ou aço não ligado, de largura igual ou superior a 600 mm, laminados a frio, não folheados ou chapeados, nem revestidos."}},{"id":"SH4:7210","tipo":"SH4","props":{"codigo":"7210","descricao":"Produtos laminados planos, de ferro ou aço não ligado, de largura igual ou superior a 600 mm, folheados ou chapeados, ou revestidos."}},{"id":"SH4:7211","tipo":"SH4","props":{"codigo":"7211","descricao":"Produtos laminados planos, de ferro ou aço não ligado, de largura inferior a 600 mm, não folheados ou chapeados, nem revestidos."}},{"id":"SH4:7212","tipo":"SH4","props":{"codigo":"7212","descricao":"Produtos laminados planos, de ferro ou aço não ligado, de largura inferior a 600 mm, folheados ou chapeados, ou revestidos."}},{"id":"SH4:7213","tipo":"SH4","props":{"codigo":"7213","descricao":"Fio-máquina de ferro ou aço não ligado."}},{"id":"SH4:7214","tipo":"SH4","props":{"codigo":"7214","descricao":"Barras de ferro ou aço não ligado, simplesmente forjadas, laminadas, estiradas ou extrudadas, a quente, incluindo as que tenham sido submetidas a torção após laminagem."}},{"id":"SH4:7215","tipo":"SH4","props":{"codigo":"7215","descricao":"Outras barras de ferro ou aço não ligado."}},{"id":"SH4:7216","tipo":"SH4","props":{"codigo":"7216","descricao":"Perfis de ferro ou aço não ligado."}},{"id":"SH4:7217","tipo":"SH4","props":{"codigo":"7217","descricao":"Fios de ferro ou aço não ligado."}},{"id":"SH4:7218","tipo":"SH4","props":{"codigo":"7218","descricao":"Aço inoxidável em lingotes ou outras formas primárias; produtos semimanufaturados de aço inoxidável."}},{"id":"SH4:7219","tipo":"SH4","props":{"codigo":"7219","descricao":"Produtos laminados planos de aço inoxidável, de largura igual ou superior a 600 mm."}},{"id":"SH4:7220","tipo":"SH4","props":{"codigo":"7220","descricao":"Produtos laminados planos de aço inoxidável, de largura inferior a 600 mm."}},{"id":"SH4:7221","tipo":"SH4","props":{"codigo":"7221","descricao":null}},{"id":"SH4:7222","tipo":"SH4","props":{"codigo":"7222","descricao":"Barras e perfis, de aço inoxidável."}},{"id":"SH4:7223","tipo":"SH4","props":{"codigo":"7223","descricao":null}},{"id":"SH4:7224","tipo":"SH4","props":{"codigo":"7224","descricao":"Outras ligas de aço, em lingotes ou outras formas primárias; produtos semimanufaturados, de outras ligas de aço."}},{"id":"SH4:7225","tipo":"SH4","props":{"codigo":"7225","descricao":"Produtos laminados planos, de outras ligas de aço, de largura igual ou superior a 600 mm."}},{"id":"SH4:7226","tipo":"SH4","props":{"codigo":"7226","descricao":"Produtos laminados planos, de outras ligas de aço, de largura inferior a 600 mm."}},{"id":"SH4:7227","tipo":"SH4","props":{"codigo":"7227","descricao":"Fio-máquina de outras ligas de aço."}},{"id":"SH4:7228","tipo":"SH4","props":{"codigo":"7228","descricao":"Barras e perfis, de outras ligas de aço; barras ocas para perfuração, de ligas de aço ou de aço não ligado."}},{"id":"SH4:7229","tipo":"SH4","props":{"codigo":"7229","descricao":"Fios de outras ligas de aço."}},{"id":"SH4:7301","tipo":"SH4","props":{"codigo":"7301","descricao":"Estacas-pranchas de ferro ou aço, mesmo perfuradas ou feitas com elementos montados; perfis obtidos por soldadura, de ferro ou aço."}},{"id":"SH4:7302","tipo":"SH4","props":{"codigo":"7302","descricao":"Elementos de vias férreas, de ferro fundido, ferro ou aço: trilhos (carris), contratrilhos (contracarris) e cremalheiras, agulhas, cróssimas, alavancas para comando de agulhas e outros elementos de cruzamentos e desvios, dormentes, talas de junção (eclissas*), coxins de trilho (carril), cantoneiras, placas de apoio ou assentamento, placas de aperto, placas e tirantes de separação e outras peças próprias para a fixação, articulação, apoio ou junção de trilhos (carris)."}},{"id":"SH4:7303","tipo":"SH4","props":{"codigo":"7303","descricao":null}},{"id":"SH4:7304","tipo":"SH4","props":{"codigo":"7304","descricao":"Tubos e perfis ocos, sem costura, de ferro ou aço."}},{"id":"SH4:7305","tipo":"SH4","props":{"codigo":"7305","descricao":"Outros tubos (por exemplo, soldados ou rebitados), de seção circular, de diâmetro exterior superior a 406,4 mm, de ferro ou aço."}},{"id":"SH4:7306","tipo":"SH4","props":{"codigo":"7306","descricao":"Outros tubos e perfis ocos (por exemplo, soldados, rebitados, grampeados ou com as bordas simplesmente aproximadas), de ferro ou aço."}},{"id":"SH4:7307","tipo":"SH4","props":{"codigo":"7307","descricao":"Acessórios para tubos (por exemplo, uniões, cotovelos, luvas (mangas*)), de ferro fundido, ferro ou aço."}},{"id":"SH4:7308","tipo":"SH4","props":{"codigo":"7308","descricao":"Construções e suas partes (por exemplo, pontes e elementos de pontes, comportas, torres, pórticos, pilares, colunas, armações, estruturas para telhados, portas e janelas, e seus caixilhos, alizares e soleiras, portas de correr, balaustradas), de ferro fundido, ferro ou aço, exceto as construções pré-fabricadas da posição 94.06; chapas, barras, perfis, tubos e semelhantes, de ferro fundido, ferro ou aço, próprios para construções."}},{"id":"SH4:7309","tipo":"SH4","props":{"codigo":"7309","descricao":null}},{"id":"SH4:7310","tipo":"SH4","props":{"codigo":"7310","descricao":"Reservatórios, barris, tambores, latas, caixas e recipientes semelhantes para quaisquer matérias (exceto gases comprimidos ou liquefeitos), de ferro fundido, ferro ou aço, de capacidade não superior a 300 l, sem dispositivos mecânicos ou térmicos, mesmo com revestimento interior ou calorífugo."}},{"id":"SH4:7311","tipo":"SH4","props":{"codigo":"7311","descricao":null}},{"id":"SH4:7312","tipo":"SH4","props":{"codigo":"7312","descricao":"Cordas, cabos, tranças (entrançados*), lingas e artigos semelhantes, de ferro ou aço, não isolados para usos elétricos."}},{"id":"SH4:7313","tipo":"SH4","props":{"codigo":"7313","descricao":null}},{"id":"SH4:7314","tipo":"SH4","props":{"codigo":"7314","descricao":"Telas metálicas (incluindo as telas contínuas ou sem fim), grades e redes, de fios de ferro ou aço; chapas e tiras, distendidas, de ferro ou aço."}},{"id":"SH4:7315","tipo":"SH4","props":{"codigo":"7315","descricao":"Correntes, cadeias, e suas partes, de ferro fundido, ferro ou aço."}},{"id":"SH4:7316","tipo":"SH4","props":{"codigo":"7316","descricao":null}},{"id":"SH4:7317","tipo":"SH4","props":{"codigo":"7317","descricao":null}},{"id":"SH4:7318","tipo":"SH4","props":{"codigo":"7318","descricao":"Parafusos, pinos ou pernos, roscados, porcas, tira-fundos, ganchos roscados, rebites, chavetas, contrapinos ou troços, arruelas (anilhas) (incluindo as de pressão) e artigos semelhantes, de ferro fundido, ferro ou aço."}},{"id":"SH4:7319","tipo":"SH4","props":{"codigo":"7319","descricao":"Agulhas de costura, agulhas de tricô, agulhas-passadoras, agulhas de crochê, furadores para bordar e artigos semelhantes, para uso manual, de ferro ou aço; alfinetes de segurança e outros alfinetes, de ferro ou aço, não especificados nem compreendidos noutras posições."}},{"id":"SH4:7320","tipo":"SH4","props":{"codigo":"7320","descricao":"Molas e folhas de molas, de ferro ou aço."}},{"id":"SH4:7321","tipo":"SH4","props":{"codigo":"7321","descricao":"Aquecedores de ambiente (fogões de sala), caldeiras de fornalha, fogões de cozinha (incluindo os que possam ser utilizados acessoriamente no aquecimento central), churrasqueiras (grelhadores), braseiras, fogareiros a gás, aquecedores de pratos, e aparelhos não elétricos semelhantes, de uso doméstico, e suas partes, de ferro fundido, ferro ou aço."}},{"id":"SH4:7322","tipo":"SH4","props":{"codigo":"7322","descricao":"Radiadores para aquecimento central, não elétricos, e suas partes, de ferro fundido, ferro ou aço; geradores e distribuidores de ar quente (incluindo os distribuidores que possam também funcionar como distribuidores de ar frio ou condicionado), não elétricos, munidos de ventilador ou fole com motor, e suas partes, de ferro fundido, ferro ou aço."}},{"id":"SH4:7323","tipo":"SH4","props":{"codigo":"7323","descricao":"Serviços de mesa, artigos de cozinha e outros artigos de uso doméstico, e suas partes, de ferro fundido, ferro ou aço; palha de ferro ou aço; esponjas, esfregões, luvas e artigos semelhantes para limpeza, polimento ou usos semelhantes, de ferro ou aço."}},{"id":"SH4:7324","tipo":"SH4","props":{"codigo":"7324","descricao":"Artigos de higiene ou de toucador, e suas partes, de ferro fundido, ferro ou aço."}},{"id":"SH4:7325","tipo":"SH4","props":{"codigo":"7325","descricao":"Outras obras moldadas, de ferro fundido, ferro ou aço."}},{"id":"SH4:7326","tipo":"SH4","props":{"codigo":"7326","descricao":"Outras obras de ferro ou aço."}},{"id":"SH4:7401","tipo":"SH4","props":{"codigo":"7401","descricao":null}},{"id":"SH4:7402","tipo":"SH4","props":{"codigo":"7402","descricao":null}},{"id":"SH4:7403","tipo":"SH4","props":{"codigo":"7403","descricao":"Cobre refinado (afinado) e ligas de cobre em formas brutas."}},{"id":"SH4:7404","tipo":"SH4","props":{"codigo":"7404","descricao":null}},{"id":"SH4:7405","tipo":"SH4","props":{"codigo":"7405","descricao":null}},{"id":"SH4:7406","tipo":"SH4","props":{"codigo":"7406","descricao":"Pós e escamas, de cobre."}},{"id":"SH4:7407","tipo":"SH4","props":{"codigo":"7407","descricao":"Barras e perfis, de cobre."}},{"id":"SH4:7408","tipo":"SH4","props":{"codigo":"7408","descricao":"Fios de cobre."}},{"id":"SH4:7409","tipo":"SH4","props":{"codigo":"7409","descricao":"Chapas e tiras, de cobre, de espessura superior a 0,15 mm."}},{"id":"SH4:7410","tipo":"SH4","props":{"codigo":"7410","descricao":"Folhas e tiras, delgadas, de cobre (mesmo impressas ou com suporte de papel, cartão, plástico ou semelhantes), de espessura não superior a 0,15 mm (excluindo o suporte)."}},{"id":"SH4:7411","tipo":"SH4","props":{"codigo":"7411","descricao":"Tubos de cobre."}},{"id":"SH4:7412","tipo":"SH4","props":{"codigo":"7412","descricao":"Acessórios para tubos (por exemplo, uniões, cotovelos, luvas (mangas*)), de cobre."}},{"id":"SH4:7413","tipo":"SH4","props":{"codigo":"7413","descricao":null}},{"id":"SH4:7415","tipo":"SH4","props":{"codigo":"7415","descricao":"Tachas, pregos, percevejos, escápulas (pregos para tacos) e artigos semelhantes, de cobre ou de ferro ou aço com cabeça de cobre; parafusos, pinos ou pernos, roscados, porcas, ganchos roscados, rebites, chavetas, cavilhas, contrapinos ou troços, arruelas (anilhas) (incluindo as de pressão), e artigos semelhantes, de cobre."}},{"id":"SH4:7418","tipo":"SH4","props":{"codigo":"7418","descricao":"Serviços de mesa, artigos de cozinha e outros artigos de uso doméstico, e suas partes, de cobre; esponjas, esfregões, luvas e artigos semelhantes, para limpeza, polimento ou usos semelhantes, de cobre; artigos de higiene ou de toucador, e suas partes, de cobre."}},{"id":"SH4:7419","tipo":"SH4","props":{"codigo":"7419","descricao":"Outras obras de cobre."}},{"id":"SH4:7501","tipo":"SH4","props":{"codigo":"7501","descricao":"Mates de níquel, <i>sinters</i> de óxidos de níquel e outros produtos intermediários da metalurgia do níquel."}},{"id":"SH4:7502","tipo":"SH4","props":{"codigo":"7502","descricao":"Níquel em formas brutas."}},{"id":"SH4:7503","tipo":"SH4","props":{"codigo":"7503","descricao":null}},{"id":"SH4:7504","tipo":"SH4","props":{"codigo":"7504","descricao":null}},{"id":"SH4:7505","tipo":"SH4","props":{"codigo":"7505","descricao":"Barras, perfis e fios, de níquel."}},{"id":"SH4:7506","tipo":"SH4","props":{"codigo":"7506","descricao":"Chapas, tiras e folhas, de níquel."}},{"id":"SH4:7507","tipo":"SH4","props":{"codigo":"7507","descricao":"Tubos e seus acessórios (por exemplo, uniões, cotovelos, luvas (mangas*)), de níquel."}},{"id":"SH4:7508","tipo":"SH4","props":{"codigo":"7508","descricao":"Outras obras de níquel."}},{"id":"SH4:7601","tipo":"SH4","props":{"codigo":"7601","descricao":"Alumínio em formas brutas."}},{"id":"SH4:7602","tipo":"SH4","props":{"codigo":"7602","descricao":null}},{"id":"SH4:7603","tipo":"SH4","props":{"codigo":"7603","descricao":"Pós e escamas, de alumínio."}},{"id":"SH4:7604","tipo":"SH4","props":{"codigo":"7604","descricao":"Barras e perfis, de alumínio."}},{"id":"SH4:7605","tipo":"SH4","props":{"codigo":"7605","descricao":"Fios de alumínio."}},{"id":"SH4:7606","tipo":"SH4","props":{"codigo":"7606","descricao":"Chapas e tiras, de alumínio, de espessura superior a 0,2 mm."}},{"id":"SH4:7607","tipo":"SH4","props":{"codigo":"7607","descricao":"Folhas e tiras, delgadas, de alumínio (mesmo impressas ou com suporte de papel, cartão, plástico ou semelhantes), de espessura não superior a 0,2 mm (excluindo o suporte)."}},{"id":"SH4:7608","tipo":"SH4","props":{"codigo":"7608","descricao":"Tubos de alumínio."}},{"id":"SH4:7609","tipo":"SH4","props":{"codigo":"7609","descricao":null}},{"id":"SH4:7610","tipo":"SH4","props":{"codigo":"7610","descricao":"Construções e suas partes (por exemplo, pontes e elementos de pontes, torres, pórticos ou pilones, pilares, colunas, armações, estruturas para telhados, portas e janelas, e seus caixilhos, alizares e soleiras, balaustradas), de alumínio, exceto as construções pré-fabricadas da posição 94.06; chapas, barras, perfis, tubos e semelhantes, de alumínio, próprios para construções."}},{"id":"SH4:7611","tipo":"SH4","props":{"codigo":"7611","descricao":null}},{"id":"SH4:7612","tipo":"SH4","props":{"codigo":"7612","descricao":"Reservatórios, barris, tambores, latas, caixas e recipientes semelhantes (incluindo os recipientes tubulares, rígidos ou flexíveis) para quaisquer matérias (exceto gases comprimidos ou liquefeitos), de alumínio, de capacidade não superior a 300 l, sem dispositivos mecânicos ou térmicos, mesmo com revestimento interior ou calorífugo."}},{"id":"SH4:7613","tipo":"SH4","props":{"codigo":"7613","descricao":null}},{"id":"SH4:7614","tipo":"SH4","props":{"codigo":"7614","descricao":"Cordas, cabos, tranças (entrançados*) e semelhantes, de alumínio, não isolados para usos elétricos."}},{"id":"SH4:7615","tipo":"SH4","props":{"codigo":"7615","descricao":"Serviços de mesa, artigos de cozinha e outros artigos de uso doméstico, e suas partes, de alumínio; esponjas, esfregões, luvas e artigos semelhantes, para limpeza, polimento ou usos semelhantes, de alumínio; artigos de higiene ou de toucador, e suas partes, de alumínio."}},{"id":"SH4:7616","tipo":"SH4","props":{"codigo":"7616","descricao":"Outras obras de alumínio."}},{"id":"SH4:7801","tipo":"SH4","props":{"codigo":"7801","descricao":"Chumbo em formas brutas."}},{"id":"SH4:7802","tipo":"SH4","props":{"codigo":"7802","descricao":null}},{"id":"SH4:7804","tipo":"SH4","props":{"codigo":"7804","descricao":"Chapas, folhas e tiras, de chumbo; pós e escamas, de chumbo."}},{"id":"SH4:7806","tipo":"SH4","props":{"codigo":"7806","descricao":null}},{"id":"SH4:7901","tipo":"SH4","props":{"codigo":"7901","descricao":"Zinco em formas brutas."}},{"id":"SH4:7902","tipo":"SH4","props":{"codigo":"7902","descricao":null}},{"id":"SH4:7903","tipo":"SH4","props":{"codigo":"7903","descricao":"Poeiras, pós e escamas, de zinco."}},{"id":"SH4:7904","tipo":"SH4","props":{"codigo":"7904","descricao":null}},{"id":"SH4:7905","tipo":"SH4","props":{"codigo":"7905","descricao":null}},{"id":"SH4:7907","tipo":"SH4","props":{"codigo":"7907","descricao":null}},{"id":"SH4:8001","tipo":"SH4","props":{"codigo":"8001","descricao":"Estanho em formas brutas."}},{"id":"SH4:8002","tipo":"SH4","props":{"codigo":"8002","descricao":null}},{"id":"SH4:8003","tipo":"SH4","props":{"codigo":"8003","descricao":null}},{"id":"SH4:8007","tipo":"SH4","props":{"codigo":"8007","descricao":null}},{"id":"SH4:8101","tipo":"SH4","props":{"codigo":"8101","descricao":"Tungstênio (volfrâmio) e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8102","tipo":"SH4","props":{"codigo":"8102","descricao":"Molibdênio e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8103","tipo":"SH4","props":{"codigo":"8103","descricao":"Tântalo e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8104","tipo":"SH4","props":{"codigo":"8104","descricao":"Magnésio e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8105","tipo":"SH4","props":{"codigo":"8105","descricao":"Mates de cobalto e outros produtos intermediários da metalurgia do cobalto; cobalto e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8106","tipo":"SH4","props":{"codigo":"8106","descricao":"Bismuto e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8108","tipo":"SH4","props":{"codigo":"8108","descricao":"Titânio e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8109","tipo":"SH4","props":{"codigo":"8109","descricao":"Zircônio e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8110","tipo":"SH4","props":{"codigo":"8110","descricao":"Antimônio e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8111","tipo":"SH4","props":{"codigo":"8111","descricao":null}},{"id":"SH4:8112","tipo":"SH4","props":{"codigo":"8112","descricao":"Berílio, cromo, háfnio (céltio), rênio, tálio, cádmio, germânio, vanádio, gálio, índio e nióbio (colômbio), e suas obras, incluindo os desperdícios e resíduos, e sucata."}},{"id":"SH4:8113","tipo":"SH4","props":{"codigo":"8113","descricao":null}},{"id":"SH4:8201","tipo":"SH4","props":{"codigo":"8201","descricao":"Pás, alviões, picaretas, enxadas, sachos, forcados, forquilhas, ancinhos e raspadeiras; machados, podões e ferramentas semelhantes com gume; tesouras de podar de qualquer tipo; foices e foicinhas, facas para feno ou para palha, tesouras para sebes, cunhas e outras ferramentas manuais para agricultura, horticultura ou silvicultura."}},{"id":"SH4:8202","tipo":"SH4","props":{"codigo":"8202","descricao":"Serras manuais; folhas de serras de qualquer tipo (incluindo as fresas-serras e as folhas não dentadas para serrar)."}},{"id":"SH4:8203","tipo":"SH4","props":{"codigo":"8203","descricao":"Limas, grosas, alicates (mesmo cortantes), tenazes, pinças, cisalhas para metais, corta-tubos, corta-pinos, saca-bocados e ferramentas semelhantes, manuais."}},{"id":"SH4:8204","tipo":"SH4","props":{"codigo":"8204","descricao":"Chaves de porcas, manuais (incluindo as chaves dinamométricas); chaves de caixa intercambiáveis, mesmo com cabos."}},{"id":"SH4:8205","tipo":"SH4","props":{"codigo":"8205","descricao":"Ferramentas manuais (incluindo os corta-vidros (diamantes de vidraceiro)) não especificadas nem compreendidas noutras posições; lâmpadas ou lamparinas de soldar (maçaricos) e semelhantes; tornos de apertar, sargentos e semelhantes, exceto os acessórios ou partes de máquinas-ferramentas ou de máquinas de corte a jato de água; bigornas; forjas portáteis; mós com armação, manuais ou de pedal."}},{"id":"SH4:8206","tipo":"SH4","props":{"codigo":"8206","descricao":null}},{"id":"SH4:8207","tipo":"SH4","props":{"codigo":"8207","descricao":"Ferramentas intercambiáveis para ferramentas manuais, mesmo mecânicas, ou para máquinas-ferramentas (por exemplo, de embutir, estampar, puncionar, roscar (incluindo atarraxar), furar, escarear, mandrilar, brochar, fresar, tornear, aparafusar), incluindo as fieiras de estiramento ou de extrusão, para metais, e as ferramentas de perfuração ou de sondagem."}},{"id":"SH4:8208","tipo":"SH4","props":{"codigo":"8208","descricao":"Facas e lâminas cortantes, para máquinas ou para aparelhos mecânicos."}},{"id":"SH4:8209","tipo":"SH4","props":{"codigo":"8209","descricao":null}},{"id":"SH4:8210","tipo":"SH4","props":{"codigo":"8210","descricao":null}},{"id":"SH4:8211","tipo":"SH4","props":{"codigo":"8211","descricao":"Facas (exceto as da posição 82.08) de lâmina cortante ou serrilhada, incluindo as podadeiras de lâmina móvel, e suas lâminas."}},{"id":"SH4:8212","tipo":"SH4","props":{"codigo":"8212","descricao":"Navalhas e aparelhos, de barbear, e suas lâminas (incluindo os esboços em tiras)."}},{"id":"SH4:8213","tipo":"SH4","props":{"codigo":"8213","descricao":null}},{"id":"SH4:8214","tipo":"SH4","props":{"codigo":"8214","descricao":"Outros artigos de cutelaria (por exemplo, máquinas de cortar o cabelo ou tosquiar, fendeleiras, cutelos, incluindo os de açougue (talho) e de cozinha, e espátulas (corta-papéis)); utensílios e sortidos de utensílios de manicuros ou de pedicuros (incluindo as limas para unhas)."}},{"id":"SH4:8215","tipo":"SH4","props":{"codigo":"8215","descricao":"Colheres, garfos, conchas, escumadeiras, pás para tortas, facas especiais para peixe ou para manteiga, pinças para açúcar e artigos semelhantes."}},{"id":"SH4:8301","tipo":"SH4","props":{"codigo":"8301","descricao":"Cadeados, fechaduras e ferrolhos (de chave, de segredo ou elétricos), de metais comuns; fechos e armações com fecho, com fechadura, de metais comuns; chaves para estes artigos, de metais comuns."}},{"id":"SH4:8302","tipo":"SH4","props":{"codigo":"8302","descricao":"Guarnições, ferragens e artigos semelhantes, de metais comuns, para móveis, portas, escadas, janelas, persianas, carroçarias, artigos de seleiro, malas, cofres, caixas de segurança e outras obras semelhantes; pateras, porta-chapéus, cabides e artigos semelhantes, de metais comuns; rodízios com armação de metais comuns; fechos automáticos para portas, de metais comuns."}},{"id":"SH4:8303","tipo":"SH4","props":{"codigo":"8303","descricao":null}},{"id":"SH4:8304","tipo":"SH4","props":{"codigo":"8304","descricao":null}},{"id":"SH4:8305","tipo":"SH4","props":{"codigo":"8305","descricao":"Ferragens para encadernação de folhas soltas ou para classificadores, prendedores (molas*) para papéis, cantos para cartas, clipes, indicadores para fichas ou cavaleiros e objetos semelhantes de escritório, de metais comuns; grampos (agrafos*) apresentados em barretas (por exemplo, de escritório, para atapetar, para embalagem), de metais comuns."}},{"id":"SH4:8306","tipo":"SH4","props":{"codigo":"8306","descricao":"Sinos, campainhas, gongos e artigos semelhantes, não elétricos, de metais comuns; estatuetas e outros objetos de ornamentação, de metais comuns; molduras para fotografias, gravuras ou semelhantes, de metais comuns; espelhos de metais comuns."}},{"id":"SH4:8307","tipo":"SH4","props":{"codigo":"8307","descricao":"Tubos flexíveis de metais comuns, mesmo com acessórios."}},{"id":"SH4:8308","tipo":"SH4","props":{"codigo":"8308","descricao":"Fechos, armações com fecho, fivelas, fivelas-fecho, grampos, colchetes, ilhoses e artigos semelhantes, de metais comuns, para vestuário ou acessórios de vestuário, calçado, joalheria, relógios de pulso, livros, encerados, artigos de couro, artigos de seleiro, artigos de viagem, ou para outras confecções; rebites tubulares ou de haste fendida, de metais comuns; contas e lantejoulas, de metais comuns."}},{"id":"SH4:8309","tipo":"SH4","props":{"codigo":"8309","descricao":"Rolhas, tampas e cápsulas para garrafas (incluindo as cápsulas de coroa, as rolhas e cápsulas, de rosca, e as rolhas vertedoras), batoques ou tampões roscados, protetores de batoques ou de tampões, selos de garantia e outros acessórios para embalagem, de metais comuns."}},{"id":"SH4:8310","tipo":"SH4","props":{"codigo":"8310","descricao":null}},{"id":"SH4:8311","tipo":"SH4","props":{"codigo":"8311","descricao":"Fios, varetas, tubos, chapas, eletrodos e artigos semelhantes, de metais comuns ou de carbonetos metálicos, revestidos interior ou exteriormente de decapantes ou de fundentes, para soldadura ou depósito de metal ou de carbonetos metálicos; fios e varetas, de pós de metais comuns aglomerados, para metalização por projeção."}},{"id":"SH4:8401","tipo":"SH4","props":{"codigo":"8401","descricao":"Reatores nucleares; elementos combustíveis (cartuchos) não irradiados, para reatores nucleares; máquinas e aparelhos para a separação de isótopos."}},{"id":"SH4:8402","tipo":"SH4","props":{"codigo":"8402","descricao":"Caldeiras de vapor (geradores de vapor), excluindo as caldeiras para aquecimento central concebidas para produção de água quente e vapor de baixa pressão; caldeiras denominadas \"de água superaquecida\"."}},{"id":"SH4:8403","tipo":"SH4","props":{"codigo":"8403","descricao":"Caldeiras para aquecimento central, exceto as da posição 84.02."}},{"id":"SH4:8404","tipo":"SH4","props":{"codigo":"8404","descricao":"Aparelhos auxiliares para caldeiras das posições 84.02 ou 84.03 (por exemplo, economizadores, superaquecedores, aparelhos de limpeza de tubos ou de recuperação de gás); condensadores para máquinas a vapor."}},{"id":"SH4:8405","tipo":"SH4","props":{"codigo":"8405","descricao":"Geradores de gás de ar (gás pobre) ou de gás de água, mesmo com depuradores; geradores de acetileno e geradores semelhantes de gás, operados a água, mesmo com depuradores."}},{"id":"SH4:8406","tipo":"SH4","props":{"codigo":"8406","descricao":"Turbinas a vapor."}},{"id":"SH4:8407","tipo":"SH4","props":{"codigo":"8407","descricao":"Motores de pistão, alternativo ou rotativo, de ignição por centelha (faísca) (motores de explosão)."}},{"id":"SH4:8408","tipo":"SH4","props":{"codigo":"8408","descricao":"Motores de pistão, de ignição por compressão (motores diesel ou semidiesel)."}},{"id":"SH4:8409","tipo":"SH4","props":{"codigo":"8409","descricao":"Partes reconhecíveis como exclusiva ou principalmente destinadas aos motores das posições 84.07 ou 84.08."}},{"id":"SH4:8410","tipo":"SH4","props":{"codigo":"8410","descricao":"Turbinas hidráulicas, rodas hidráulicas, e seus reguladores."}},{"id":"SH4:8411","tipo":"SH4","props":{"codigo":"8411","descricao":"Turborreatores, turbopropulsores e outras turbinas a gás."}},{"id":"SH4:8412","tipo":"SH4","props":{"codigo":"8412","descricao":"Outros motores e máquinas motrizes."}},{"id":"SH4:8413","tipo":"SH4","props":{"codigo":"8413","descricao":"Bombas para líquidos, mesmo com dispositivo medidor; elevadores de líquidos."}},{"id":"SH4:8414","tipo":"SH4","props":{"codigo":"8414","descricao":"Bombas de ar ou de vácuo, compressores de ar ou de outros gases e ventiladores; coifas aspirantes (exaustores) para extração ou reciclagem, com ventilador incorporado, mesmo filtrantes; cabinas (câmaras) de segurança biológica estanques aos gases, mesmo filtrantes."}},{"id":"SH4:8415","tipo":"SH4","props":{"codigo":"8415","descricao":"Máquinas e aparelhos de ar-condicionado que contenham um ventilador motorizado e dispositivos próprios para modificar a temperatura e a umidade, incluindo as máquinas e aparelhos em que a umidade não seja regulável separadamente."}},{"id":"SH4:8416","tipo":"SH4","props":{"codigo":"8416","descricao":"Queimadores para alimentação de fornalhas de combustíveis líquidos, combustíveis sólidos pulverizados ou de gás; fornalhas automáticas, incluindo as antefornalhas, grelhas mecânicas, descarregadores mecânicos de cinzas e dispositivos semelhantes."}},{"id":"SH4:8417","tipo":"SH4","props":{"codigo":"8417","descricao":"Fornos industriais ou de laboratório, incluindo os incineradores, não elétricos."}},{"id":"SH4:8418","tipo":"SH4","props":{"codigo":"8418","descricao":"Refrigeradores, congeladores (<i>freezers</i>) e outros materiais, máquinas e aparelhos, para a produção de frio, com equipamento elétrico ou outro; bombas de calor, exceto as máquinas e aparelhos de ar-condicionado da posição 84.15."}},{"id":"SH4:8419","tipo":"SH4","props":{"codigo":"8419","descricao":"Aparelhos, dispositivos ou equipamentos de laboratório, mesmo aquecidos eletricamente (exceto os fornos e outros aparelhos da posição 85.14), para tratamento de matérias por meio de operações que impliquem mudança de temperatura, tais como aquecimento, cozimento, torrefação, destilação, retificação, esterilização, pasteurização, estufagem, secagem, evaporação, vaporização, condensação ou arrefecimento, exceto os de uso doméstico; aquecedores de água não elétricos, de aquecimento instantâneo ou de acumulação."}},{"id":"SH4:8420","tipo":"SH4","props":{"codigo":"8420","descricao":"Calandras e laminadores, exceto os destinados ao tratamento de metais ou vidro, e seus cilindros."}},{"id":"SH4:8421","tipo":"SH4","props":{"codigo":"8421","descricao":"Centrifugadores, incluindo os secadores centrífugos; aparelhos para filtrar ou depurar líquidos ou gases."}},{"id":"SH4:8422","tipo":"SH4","props":{"codigo":"8422","descricao":"Máquinas de lavar louça; máquinas e aparelhos para limpar ou secar garrafas ou outros recipientes; máquinas e aparelhos para encher, fechar, arrolhar ou rotular garrafas, caixas, latas, sacos ou outros recipientes; máquinas e aparelhos para capsular garrafas, vasos, tubos e recipientes semelhantes; outras máquinas e aparelhos para empacotar ou embalar mercadorias (incluindo as máquinas e aparelhos para embalar com película termorretrátil); máquinas e aparelhos para gaseificar bebidas."}},{"id":"SH4:8423","tipo":"SH4","props":{"codigo":"8423","descricao":"Aparelhos e instrumentos de pesagem, incluindo as básculas e balanças para verificar peças usinadas (fabricadas*), excluindo as balanças sensíveis a pesos não superiores a 5 cg; pesos para quaisquer balanças."}},{"id":"SH4:8424","tipo":"SH4","props":{"codigo":"8424","descricao":"Aparelhos mecânicos (mesmo manuais) para projetar, dispersar ou pulverizar líquidos ou pós; extintores, mesmo carregados; pistolas aerográficas e aparelhos semelhantes; máquinas e aparelhos de jato de areia, de jato de vapor e aparelhos de jato semelhantes."}},{"id":"SH4:8425","tipo":"SH4","props":{"codigo":"8425","descricao":"Talhas, cadernais e moitões; guinchos e cabrestantes; macacos."}},{"id":"SH4:8426","tipo":"SH4","props":{"codigo":"8426","descricao":"Cábreas; guindastes, incluindo os de cabo; pontes rolantes, pórticos de descarga ou de movimentação, pontes-guindastes, carros-pórticos e carros-guindastes."}},{"id":"SH4:8427","tipo":"SH4","props":{"codigo":"8427","descricao":"Empilhadeiras; outros veículos para movimentação de carga e semelhantes, equipados com dispositivos de elevação."}},{"id":"SH4:8428","tipo":"SH4","props":{"codigo":"8428","descricao":"Outras máquinas e aparelhos de elevação, de carga, de descarga ou de movimentação (por exemplo, elevadores, escadas rolantes, transportadores, teleféricos)."}},{"id":"SH4:8429","tipo":"SH4","props":{"codigo":"8429","descricao":"<i>Bulldozers</i>, <i>angledozers</i>, niveladores, raspo-transportadores (<i>scrapers</i>), pás mecânicas, escavadores, carregadores e pás carregadoras, compactadores e rolos ou cilindros compressores, autopropulsados."}},{"id":"SH4:8430","tipo":"SH4","props":{"codigo":"8430","descricao":"Outras máquinas e aparelhos de terraplenagem, nivelamento, raspagem, escavação, compactação, extração ou perfuração da terra, de minerais ou minérios; bate-estacas e arranca-estacas; limpa-neves."}},{"id":"SH4:8431","tipo":"SH4","props":{"codigo":"8431","descricao":"Partes reconhecíveis como exclusiva ou principalmente destinadas às máquinas e aparelhos das posições 84.25 a 84.30."}},{"id":"SH4:8432","tipo":"SH4","props":{"codigo":"8432","descricao":"Máquinas e aparelhos de uso agrícola, hortícola ou florestal, para preparação ou trabalho do solo ou para cultura; rolos para gramados (relvados) ou para campos de esporte."}},{"id":"SH4:8433","tipo":"SH4","props":{"codigo":"8433","descricao":"Máquinas e aparelhos para colheita ou debulha de produtos agrícolas, incluindo as enfardadeiras de palha ou forragem; cortadores de grama (relva) e ceifeiras; máquinas para limpar ou selecionar ovos, fruta ou outros produtos agrícolas, exceto as da posição 84.37."}},{"id":"SH4:8434","tipo":"SH4","props":{"codigo":"8434","descricao":"Máquinas de ordenhar e máquinas e aparelhos para a indústria de laticínios."}},{"id":"SH4:8435","tipo":"SH4","props":{"codigo":"8435","descricao":"Prensas, esmagadores e máquinas e aparelhos semelhantes, para fabricação de vinho, sidra, sucos (sumos) de fruta ou bebidas semelhantes."}},{"id":"SH4:8436","tipo":"SH4","props":{"codigo":"8436","descricao":"Outras máquinas e aparelhos para agricultura, horticultura, silvicultura, avicultura ou apicultura, incluindo os germinadores equipados com dispositivos mecânicos ou térmicos e as chocadeiras e criadeiras para avicultura."}},{"id":"SH4:8437","tipo":"SH4","props":{"codigo":"8437","descricao":"Máquinas para limpeza, seleção ou peneiração de grãos ou de produtos hortícolas secos; máquinas e aparelhos para a indústria de moagem ou tratamento de cereais ou de produtos hortícolas secos, exceto do tipo utilizado em fazendas."}},{"id":"SH4:8438","tipo":"SH4","props":{"codigo":"8438","descricao":"Máquinas e aparelhos não especificados nem compreendidos noutras posições do presente Capítulo, para preparação ou fabricação industrial de alimentos ou de bebidas, exceto as máquinas e aparelhos para extração ou preparação de óleos ou gorduras vegetais ou de origem microbiana, fixos, ou de animais."}},{"id":"SH4:8439","tipo":"SH4","props":{"codigo":"8439","descricao":"Máquinas e aparelhos para fabricação de pasta de matérias fibrosas celulósicas ou para fabricação ou acabamento de papel ou cartão."}},{"id":"SH4:8440","tipo":"SH4","props":{"codigo":"8440","descricao":"Máquinas e aparelhos para brochura ou encadernação, incluindo as máquinas de costurar cadernos."}},{"id":"SH4:8441","tipo":"SH4","props":{"codigo":"8441","descricao":"Outras máquinas e aparelhos para o trabalho de pasta de papel, papel ou cartão, incluindo as cortadeiras de qualquer tipo."}},{"id":"SH4:8442","tipo":"SH4","props":{"codigo":"8442","descricao":"Máquinas, aparelhos e equipamentos (exceto as máquinas das posições 84.56 a 84.65), para preparação ou fabricação de clichês, placas, cilindros ou outros elementos de impressão; clichês, placas, cilindros e outros elementos de impressão; pedras litográficas, placas e cilindros, preparados para impressão (por exemplo, aplainados, granulados ou polidos)."}},{"id":"SH4:8443","tipo":"SH4","props":{"codigo":"8443","descricao":"Máquinas e aparelhos de impressão por meio de placas, cilindros e outros elementos de impressão da posição 84.42; outras impressoras, aparelhos de copiar e aparelhos de telecopiar (fax), mesmo combinados entre si; partes e acessórios."}},{"id":"SH4:8444","tipo":"SH4","props":{"codigo":"8444","descricao":null}},{"id":"SH4:8445","tipo":"SH4","props":{"codigo":"8445","descricao":"Máquinas para preparação de matérias têxteis; máquinas para fiação, dobragem ou torção, de matérias têxteis e outras máquinas e aparelhos para fabricação de fios têxteis; máquinas de bobinar (incluindo as bobinadoras de trama) ou de dobar matérias têxteis e máquinas para preparação de fios têxteis para a sua utilização nas máquinas das posições 84.46 ou 84.47."}},{"id":"SH4:8446","tipo":"SH4","props":{"codigo":"8446","descricao":"Teares para tecidos."}},{"id":"SH4:8447","tipo":"SH4","props":{"codigo":"8447","descricao":"Teares para fabricar malhas, máquinas de costura por entrelaçamento (<i>couture-tricotage</i>), máquinas para fabricar guipuras, tules, rendas, bordados, passamanarias, galões ou redes e máquinas para inserir tufos."}},{"id":"SH4:8448","tipo":"SH4","props":{"codigo":"8448","descricao":"Máquinas e aparelhos auxiliares para as máquinas das posições 84.44, 84.45, 84.46 ou 84.47 (por exemplo, ratieras (maquinetas*), mecanismos Jacquard, quebra-urdiduras e quebra-tramas, mecanismos troca-lançadeiras); partes e acessórios reconhecíveis como exclusiva ou principalmente destinados às máquinas da presente posição ou das posições 84.44, 84.45, 84.46 ou 84.47 (por exemplo, fusos, aletas, guarnições de cardas, pentes, barras, fieiras, lançadeiras, liços e quadros de liços, agulhas, platinas, ganchos)."}},{"id":"SH4:8449","tipo":"SH4","props":{"codigo":"8449","descricao":null}},{"id":"SH4:8450","tipo":"SH4","props":{"codigo":"8450","descricao":"Máquinas de lavar roupa, mesmo com dispositivos de secagem."}},{"id":"SH4:8451","tipo":"SH4","props":{"codigo":"8451","descricao":"Máquinas e aparelhos (exceto as máquinas da posição 84.50) para lavar, limpar, espremer, secar, passar, prensar (incluindo as prensas de transferência térmica ou de fusão), branquear, tingir, para apresto e acabamento, para revestir ou impregnar fios, tecidos ou obras de matérias têxteis e máquinas para revestir tecidos-base ou outros suportes utilizados na fabricação de revestimentos para pisos (pavimentos), tais como linóleo; máquinas para enrolar, desenrolar, dobrar, cortar ou dentear tecidos."}},{"id":"SH4:8452","tipo":"SH4","props":{"codigo":"8452","descricao":"Máquinas de costura, exceto as de costurar cadernos da posição 84.40; móveis, bases e tampas, próprios para máquinas de costura; agulhas para máquinas de costura."}},{"id":"SH4:8453","tipo":"SH4","props":{"codigo":"8453","descricao":"Máquinas e aparelhos para preparar, curtir ou trabalhar couros ou peles, ou para fabricar ou consertar calçado e outras obras de couro ou de pele, exceto máquinas de costura."}},{"id":"SH4:8454","tipo":"SH4","props":{"codigo":"8454","descricao":"Conversores, cadinhos ou colheres de fundição, lingoteiras e máquinas de vazar (moldar), para metalurgia, aciaria ou fundição."}},{"id":"SH4:8455","tipo":"SH4","props":{"codigo":"8455","descricao":"Laminadores de metais e seus cilindros."}},{"id":"SH4:8456","tipo":"SH4","props":{"codigo":"8456","descricao":"Máquinas-ferramentas que trabalhem por eliminação de qualquer matéria, que operem por laser ou por outro feixe de luz ou de fótons, por ultrassom, por eletroerosão, por processos eletroquímicos, por feixes de elétrons, por feixes iônicos ou por jato de plasma; máquinas de corte a jato de água."}},{"id":"SH4:8457","tipo":"SH4","props":{"codigo":"8457","descricao":"Centros de usinagem (fabricação*), máquinas de sistema monostático (<i>single station</i>) e máquinas de estações múltiplas, para trabalhar metais."}},{"id":"SH4:8458","tipo":"SH4","props":{"codigo":"8458","descricao":"Tornos (incluindo os centros de torneamento) para metais."}},{"id":"SH4:8459","tipo":"SH4","props":{"codigo":"8459","descricao":"Máquinas-ferramentas (incluindo as unidades com cabeça deslizante) para furar, mandrilar, fresar, roscar interior ou exteriormente metais, por eliminação de matéria, exceto os tornos (incluindo os centros de torneamento) da posição 84.58."}},{"id":"SH4:8460","tipo":"SH4","props":{"codigo":"8460","descricao":"Máquinas-ferramentas para rebarbar, afiar, amolar, retificar, brunir, polir ou realizar outras operações de acabamento em metais ou <i>cermets</i> por meio de mós, de abrasivos ou de produtos polidores, exceto as máquinas de cortar ou acabar engrenagens da posição 84.61."}},{"id":"SH4:8461","tipo":"SH4","props":{"codigo":"8461","descricao":"Máquinas-ferramentas para aplainar, plainas-limadoras, máquinas-ferramentas para escatelar, brochar, cortar ou acabar engrenagens, serrar, seccionar e outras máquinas-ferramentas que trabalhem por eliminação de metal ou de <i>cermets</i>, não especificadas nem compreendidas noutras posições."}},{"id":"SH4:8462","tipo":"SH4","props":{"codigo":"8462","descricao":"Máquinas-ferramentas (incluindo as prensas) para forjar ou estampar, martelos, martelos-pilões e martinetes, para trabalhar metais (excluindo os laminadores); máquinas-ferramentas (incluindo as prensas, as linhas de corte longitudinal e as linhas de corte transversal) para enrolar, arquear, dobrar, endireitar, aplanar, cisalhar, puncionar, chanfrar ou mordiscar metais (excluindo as bancas para estirar); prensas para trabalhar metais ou carbonetos metálicos, não especificadas acima."}},{"id":"SH4:8463","tipo":"SH4","props":{"codigo":"8463","descricao":"Outras máquinas-ferramentas para trabalhar metais ou <i>cermets</i>, que trabalhem sem eliminação de matéria."}},{"id":"SH4:8464","tipo":"SH4","props":{"codigo":"8464","descricao":"Máquinas-ferramentas para trabalhar pedra, produtos cerâmicos, concreto (betão), fibrocimento ou matérias minerais semelhantes, ou para o trabalho a frio do vidro."}},{"id":"SH4:8465","tipo":"SH4","props":{"codigo":"8465","descricao":"Máquinas-ferramentas (incluindo as máquinas para pregar, grampear, colar ou reunir por qualquer outro modo) para trabalhar madeira, cortiça, osso, borracha endurecida, plástico duro ou matérias duras semelhantes."}},{"id":"SH4:8466","tipo":"SH4","props":{"codigo":"8466","descricao":"Partes e acessórios reconhecíveis como exclusiva ou principalmente destinados às máquinas das posições 84.56 a 84.65, incluindo os porta-peças e porta-ferramentas, as fieiras de abertura automática, os dispositivos divisores e outros dispositivos especiais, para estas máquinas; porta-ferramentas para ferramentas manuais de qualquer tipo."}},{"id":"SH4:8467","tipo":"SH4","props":{"codigo":"8467","descricao":"Ferramentas pneumáticas, hidráulicas ou com motor (elétrico ou não elétrico) incorporado, de uso manual."}},{"id":"SH4:8468","tipo":"SH4","props":{"codigo":"8468","descricao":"Máquinas e aparelhos para soldar, mesmo de corte, exceto os da posição 85.15; máquinas e aparelhos a gás, para têmpera superficial."}},{"id":"SH4:8470","tipo":"SH4","props":{"codigo":"8470","descricao":"Máquinas de calcular e máquinas de bolso que permitam gravar, reproduzir e visualizar informações, com função de cálculo incorporada; máquinas de contabilidade, máquinas de franquear, de emitir bilhetes e máquinas semelhantes, com dispositivo de cálculo incorporado; caixas registradoras."}},{"id":"SH4:8471","tipo":"SH4","props":{"codigo":"8471","descricao":"Máquinas automáticas para processamento de dados e suas unidades; leitores magnéticos ou ópticos, máquinas para registrar dados em suporte sob forma codificada, e máquinas para processamento desses dados, não especificadas nem compreendidas noutras posições."}},{"id":"SH4:8472","tipo":"SH4","props":{"codigo":"8472","descricao":"Outras máquinas e aparelhos de escritório (por exemplo, duplicadores hectográficos ou a estêncil, máquinas para imprimir endereços, distribuidores automáticos de notas (papéis-moeda), máquinas para selecionar, contar ou empacotar moedas, máquinas apontadoras de lápis (apara-lápis), perfuradores ou grampeadores (agrafadores*))."}},{"id":"SH4:8473","tipo":"SH4","props":{"codigo":"8473","descricao":"Partes e acessórios (exceto estojos, capas e semelhantes) reconhecíveis como exclusiva ou principalmente destinados às máquinas ou aparelhos das posições 84.70 a 84.72."}},{"id":"SH4:8474","tipo":"SH4","props":{"codigo":"8474","descricao":"Máquinas e aparelhos para selecionar, peneirar, separar, lavar, esmagar, moer, misturar ou amassar terras, pedras, minérios ou outras substâncias minerais sólidas (incluindo os pós e pastas); máquinas para aglomerar ou moldar combustíveis minerais sólidos, pastas cerâmicas, cimento, gesso ou outras matérias minerais em pó ou em pasta; máquinas para fazer moldes de areia para fundição."}},{"id":"SH4:8475","tipo":"SH4","props":{"codigo":"8475","descricao":"Máquinas para montagem de lâmpadas, tubos ou válvulas, elétricos ou eletrônicos, ou de lâmpadas de luz relâmpago (<i>flash</i>), que tenham invólucro de vidro; máquinas para fabricação ou trabalho a quente do vidro ou das suas obras."}},{"id":"SH4:8476","tipo":"SH4","props":{"codigo":"8476","descricao":"Máquinas automáticas de venda de produtos (por exemplo, selos, cigarros, alimentos ou bebidas), incluindo as máquinas de trocar dinheiro."}},{"id":"SH4:8477","tipo":"SH4","props":{"codigo":"8477","descricao":"Máquinas e aparelhos para trabalhar borracha ou plástico ou para fabricação de produtos dessas matérias, não especificados nem compreendidos noutras posições deste Capítulo."}},{"id":"SH4:8478","tipo":"SH4","props":{"codigo":"8478","descricao":"Máquinas e aparelhos para preparar ou transformar tabaco, não especificados nem compreendidos noutras posições deste Capítulo."}},{"id":"SH4:8479","tipo":"SH4","props":{"codigo":"8479","descricao":"Máquinas e aparelhos mecânicos com função própria, não especificados nem compreendidos noutras posições deste Capítulo."}},{"id":"SH4:8480","tipo":"SH4","props":{"codigo":"8480","descricao":"Caixas de fundição; placas de fundo para moldes; modelos para moldes; moldes para metais (exceto lingoteiras), carbonetos metálicos, vidro, matérias minerais, borracha ou plástico."}},{"id":"SH4:8481","tipo":"SH4","props":{"codigo":"8481","descricao":"Torneiras, válvulas (incluindo as redutoras de pressão e as termostáticas) e dispositivos semelhantes, para canalizações, caldeiras, reservatórios, cubas e outros recipientes."}},{"id":"SH4:8482","tipo":"SH4","props":{"codigo":"8482","descricao":"Rolamentos de esferas, de roletes ou de agulhas."}},{"id":"SH4:8483","tipo":"SH4","props":{"codigo":"8483","descricao":"Árvores (veios) de transmissão (incluindo as árvores de cames e virabrequins (cambotas)) e manivelas; mancais (chumaceiras) e \"bronzes\"; engrenagens e rodas de fricção; eixos de esferas ou de roletes; redutores, multiplicadores, caixas de transmissão e variadores de velocidade, incluindo os conversores de torque (binários*); volantes e polias, incluindo as polias para cadernais; embreagens e dispositivos de acoplamento, incluindo as juntas de articulação."}},{"id":"SH4:8484","tipo":"SH4","props":{"codigo":"8484","descricao":"Juntas metaloplásticas; jogos ou sortidos de juntas de composições diferentes, apresentados em bolsas, envelopes ou embalagens semelhantes; juntas de vedação mecânicas."}},{"id":"SH4:8485","tipo":"SH4","props":{"codigo":"8485","descricao":"Máquinas para fabricação aditiva."}},{"id":"SH4:8486","tipo":"SH4","props":{"codigo":"8486","descricao":"Máquinas e aparelhos do tipo utilizado exclusiva ou principalmente na fabricação de <i>boules</i> ou <i>wafers</i> de material semicondutor, dispositivos semicondutores, circuitos integrados eletrônicos ou de dispositivos de visualização de tela (ecrã*) plana; máquinas e aparelhos especificados na Nota 11 C) do presente Capítulo; partes e acessórios."}},{"id":"SH4:8487","tipo":"SH4","props":{"codigo":"8487","descricao":"Partes de máquinas ou de aparelhos, não especificadas nem compreendidas noutras posições do presente Capítulo, que não contenham conexões elétricas, partes isoladas eletricamente, bobinas, contatos nem quaisquer outros elementos com características elétricas."}},{"id":"SH4:8501","tipo":"SH4","props":{"codigo":"8501","descricao":"Motores e geradores, elétricos, exceto os grupos eletrogêneos."}},{"id":"SH4:8502","tipo":"SH4","props":{"codigo":"8502","descricao":"Grupos eletrogêneos e conversores rotativos elétricos."}},{"id":"SH4:8503","tipo":"SH4","props":{"codigo":"8503","descricao":null}},{"id":"SH4:8504","tipo":"SH4","props":{"codigo":"8504","descricao":"Transformadores elétricos, conversores elétricos estáticos (retificadores, por exemplo), bobinas de reatância e de autoindução."}},{"id":"SH4:8505","tipo":"SH4","props":{"codigo":"8505","descricao":"Eletroímãs; ímãs permanentes e artigos destinados a tornarem-se ímãs permanentes após magnetização; placas, mandris e dispositivos semelhantes, magnéticos ou eletromagnéticos, de fixação; acoplamentos, embreagens, variadores de velocidade e freios (travões), eletromagnéticos; cabeças de elevação eletromagnéticas."}},{"id":"SH4:8506","tipo":"SH4","props":{"codigo":"8506","descricao":"Pilhas e baterias de pilhas, elétricas."}},{"id":"SH4:8507","tipo":"SH4","props":{"codigo":"8507","descricao":"Acumuladores elétricos e seus separadores, mesmo de forma quadrada ou retangular."}},{"id":"SH4:8508","tipo":"SH4","props":{"codigo":"8508","descricao":"Aspiradores."}},{"id":"SH4:8509","tipo":"SH4","props":{"codigo":"8509","descricao":"Aparelhos eletromecânicos com motor elétrico incorporado, de uso doméstico, exceto os aspiradores da posição 85.08."}},{"id":"SH4:8510","tipo":"SH4","props":{"codigo":"8510","descricao":"Aparelhos ou máquinas de barbear, máquinas de cortar o cabelo ou de tosquiar e aparelhos de depilar, com motor elétrico incorporado."}},{"id":"SH4:8511","tipo":"SH4","props":{"codigo":"8511","descricao":"Aparelhos e dispositivos elétricos de ignição ou de arranque para motores de ignição por centelha (faísca) ou por compressão (por exemplo, magnetos, dínamos-magnetos, bobinas de ignição, velas de ignição ou de aquecimento, motores de arranque); geradores (por exemplo, dínamos e alternadores) e conjuntores-disjuntores utilizados com estes motores."}},{"id":"SH4:8512","tipo":"SH4","props":{"codigo":"8512","descricao":"Aparelhos elétricos de iluminação ou de sinalização (exceto os da posição 85.39), limpadores de para-brisas, degeladores e desembaçadores elétricos, do tipo utilizado em ciclos ou automóveis."}},{"id":"SH4:8513","tipo":"SH4","props":{"codigo":"8513","descricao":"Lanternas elétricas portáteis concebidas para funcionar por meio de sua própria fonte de energia (por exemplo, de pilhas, de acumuladores, de magnetos), excluindo os aparelhos de iluminação da posição 85.12."}},{"id":"SH4:8514","tipo":"SH4","props":{"codigo":"8514","descricao":"Fornos elétricos industriais ou de laboratório, incluindo os que funcionam por indução ou por perdas dielétricas; outros aparelhos industriais ou de laboratório para tratamento térmico de matérias por indução ou por perdas dielétricas."}},{"id":"SH4:8515","tipo":"SH4","props":{"codigo":"8515","descricao":"Máquinas e aparelhos para soldar (mesmo de corte) elétricos (incluindo os a gás aquecido eletricamente), a laser ou outros feixes de luz ou de fótons, a ultrassom, a feixes de elétrons, a impulsos magnéticos ou a jato de plasma; máquinas e aparelhos elétricos para projeção a quente de metais ou de <i>cermets</i>."}},{"id":"SH4:8516","tipo":"SH4","props":{"codigo":"8516","descricao":"Aquecedores elétricos de água, incluindo os de imersão; aparelhos elétricos para aquecimento de ambientes, do solo ou para usos semelhantes; aparelhos eletrotérmicos para arranjos do cabelo (por exemplo, secadores de cabelo, frisadores, aquecedores de ferros de frisar) ou para secar as mãos; ferros elétricos de passar; outros aparelhos eletrotérmicos de uso doméstico; resistências de aquecimento, exceto as da posição 85.45."}},{"id":"SH4:8517","tipo":"SH4","props":{"codigo":"8517","descricao":"Aparelhos telefônicos, incluindo os telefones inteligentes (<i>smartphones</i>) e outros telefones para redes celulares ou para outras redes sem fio; outros aparelhos para a transmissão ou recepção de voz, imagens ou outros dados, incluindo os aparelhos para comunicação em redes por fio ou redes sem fio (tal como uma rede local (LAN) ou uma rede de área estendida (longa distância) (WAN)), exceto os aparelhos das posições 84.43, 85.25, 85.27 ou 85.28."}},{"id":"SH4:8518","tipo":"SH4","props":{"codigo":"8518","descricao":"Microfones e seus suportes; alto-falantes (altifalantes), mesmo montados nas suas caixas (colunas); fones de ouvido (auscultadores e auriculares*), mesmo combinados com um microfone, e conjuntos ou sortidos constituídos por um microfone e um ou mais alto-falantes (altifalantes); amplificadores elétricos de audiofrequência; aparelhos elétricos de amplificação de som."}},{"id":"SH4:8519","tipo":"SH4","props":{"codigo":"8519","descricao":"Aparelhos de gravação de som; aparelhos de reprodução de som; aparelhos de gravação e de reprodução de som."}},{"id":"SH4:8521","tipo":"SH4","props":{"codigo":"8521","descricao":"Aparelhos de gravação ou de reprodução de vídeo, mesmo incorporando um receptor de televisão."}},{"id":"SH4:8522","tipo":"SH4","props":{"codigo":"8522","descricao":"Partes e acessórios reconhecíveis como sendo exclusiva ou principalmente destinados aos aparelhos das posições 85.19 ou 85.21."}},{"id":"SH4:8523","tipo":"SH4","props":{"codigo":"8523","descricao":"Discos, fitas, dispositivos de armazenamento de dados não voláteis à base de semicondutores, \"cartões inteligentes\" e outros suportes para gravação de som ou para gravações semelhantes, mesmo gravados, incluindo as matrizes e moldes galvânicos para fabricação de discos, exceto os produtos do Capítulo 37."}},{"id":"SH4:8524","tipo":"SH4","props":{"codigo":"8524","descricao":"Módulos de visualização de tela (ecrã*) plana, mesmo que incorporem telas sensíveis ao toque (ecrãs tácteis*)."}},{"id":"SH4:8525","tipo":"SH4","props":{"codigo":"8525","descricao":"Aparelhos transmissores (emissores) para radiodifusão ou televisão, mesmo que incorporem um aparelho receptor ou um aparelho de gravação ou de reprodução de som; câmeras de televisão, câmeras fotográficas digitais e câmeras de vídeo."}},{"id":"SH4:8526","tipo":"SH4","props":{"codigo":"8526","descricao":"Aparelhos de radiodetecção e de radiossondagem (radar), aparelhos de radionavegação e aparelhos de radiotelecomando."}},{"id":"SH4:8527","tipo":"SH4","props":{"codigo":"8527","descricao":"Aparelhos receptores para radiodifusão, mesmo combinados num mesmo invólucro, com um aparelho de gravação ou de reprodução de som, ou com um relógio."}},{"id":"SH4:8528","tipo":"SH4","props":{"codigo":"8528","descricao":"Monitores e projetores, que não incorporem aparelho receptor de televisão; aparelhos receptores de televisão, mesmo que incorporem um aparelho receptor de radiodifusão ou um aparelho de gravação ou de reprodução de som ou de imagens."}},{"id":"SH4:8529","tipo":"SH4","props":{"codigo":"8529","descricao":"Partes reconhecíveis como exclusiva ou principalmente destinadas aos aparelhos das posições 85.24 a 85.28."}},{"id":"SH4:8530","tipo":"SH4","props":{"codigo":"8530","descricao":"Aparelhos elétricos de sinalização (excluindo os de transmissão de mensagens), de segurança, de controle e de comando, para vias férreas ou semelhantes, vias terrestres ou fluviais, para áreas ou parques de estacionamento, instalações portuárias ou para aeródromos (exceto os da posição 86.08)."}},{"id":"SH4:8531","tipo":"SH4","props":{"codigo":"8531","descricao":"Aparelhos elétricos de sinalização acústica ou visual (por exemplo, campainhas, sirenes, painéis indicadores, aparelhos de alarme para proteção contra roubo ou incêndio), exceto os das posições 85.12 ou 85.30."}},{"id":"SH4:8532","tipo":"SH4","props":{"codigo":"8532","descricao":"Condensadores elétricos, fixos, variáveis ou ajustáveis."}},{"id":"SH4:8533","tipo":"SH4","props":{"codigo":"8533","descricao":"Resistências elétricas (incluindo os reostatos e os potenciômetros), exceto de aquecimento."}},{"id":"SH4:8534","tipo":"SH4","props":{"codigo":"8534","descricao":null}},{"id":"SH4:8535","tipo":"SH4","props":{"codigo":"8535","descricao":"Aparelhos para interrupção, seccionamento, proteção, derivação, ligação ou conexão de circuitos elétricos (por exemplo, interruptores, comutadores, corta-circuitos, para-raios, limitadores de tensão, supressores de picos de tensão (eliminadores de onda), tomadas de corrente e outros conectores, caixas de junção), para uma tensão superior a 1.000 V."}},{"id":"SH4:8536","tipo":"SH4","props":{"codigo":"8536","descricao":"Aparelhos para interrupção, seccionamento, proteção, derivação, ligação ou conexão de circuitos elétricos (por exemplo, interruptores, comutadores, relés, corta-circuitos, supressores de picos de tensão (eliminadores de onda), plugues (fichas*) e tomadas de corrente, suportes para lâmpadas e outros conectores, caixas de junção), para uma tensão não superior a 1.000 V; conectores para fibras ópticas, feixes ou cabos de fibras ópticas."}},{"id":"SH4:8537","tipo":"SH4","props":{"codigo":"8537","descricao":"Quadros, painéis, consoles, cabinas, armários e outros suportes com dois ou mais aparelhos das posições 85.35 ou 85.36, para comando elétrico ou distribuição de energia elétrica, incluindo os que incorporem instrumentos ou aparelhos do Capítulo 90, bem como os aparelhos de comando numérico, exceto os aparelhos de comutação da posição 85.17."}},{"id":"SH4:8538","tipo":"SH4","props":{"codigo":"8538","descricao":"Partes reconhecíveis como exclusiva ou principalmente destinadas aos aparelhos das posições 85.35, 85.36 ou 85.37."}},{"id":"SH4:8539","tipo":"SH4","props":{"codigo":"8539","descricao":"Lâmpadas e tubos elétricos de incandescência ou de descarga, incluindo os artigos denominados \"faróis e projetores, em unidades seladas\" e as lâmpadas e tubos de raios ultravioleta ou infravermelhos; lâmpadas de arco; fontes de luz de diodos emissores de luz (LED)."}},{"id":"SH4:8540","tipo":"SH4","props":{"codigo":"8540","descricao":"Lâmpadas, tubos e válvulas, eletrônicos, de cátodo quente, cátodo frio ou fotocátodo (por exemplo, lâmpadas, tubos e válvulas, de vácuo, de vapor ou de gás, ampolas retificadoras de vapor de mercúrio, tubos catódicos, tubos e válvulas para câmeras de televisão), exceto os da posição 85.39."}},{"id":"SH4:8541","tipo":"SH4","props":{"codigo":"8541","descricao":"Dispositivos semicondutores (por exemplo, diodos, transistores, transdutores à base de semicondutores); dispositivos fotossensíveis semicondutores, incluindo as células fotovoltaicas, mesmo montadas em módulos ou em painéis; diodos emissores de luz (LED), mesmo montados com outros diodos emissores de luz (LED); cristais piezelétricos montados."}},{"id":"SH4:8542","tipo":"SH4","props":{"codigo":"8542","descricao":"Circuitos integrados eletrônicos."}},{"id":"SH4:8543","tipo":"SH4","props":{"codigo":"8543","descricao":"Máquinas e aparelhos elétricos com função própria, não especificados nem compreendidos noutras posições do presente Capítulo."}},{"id":"SH4:8544","tipo":"SH4","props":{"codigo":"8544","descricao":"Fios, cabos (incluindo os cabos coaxiais) e outros condutores, isolados para usos elétricos (incluindo os envernizados ou oxidados anodicamente), mesmo com peças de conexão; cabos de fibras ópticas, constituídos por fibras embainhadas individualmente, mesmo com condutores elétricos ou munidos de peças de conexão."}},{"id":"SH4:8545","tipo":"SH4","props":{"codigo":"8545","descricao":"Eletrodos de carvão, escovas de carvão, carvões para lâmpadas ou para pilhas e outros artigos de grafita ou de outro carvão, mesmo com metal, para usos elétricos."}},{"id":"SH4:8546","tipo":"SH4","props":{"codigo":"8546","descricao":"Isoladores elétricos de qualquer matéria."}},{"id":"SH4:8547","tipo":"SH4","props":{"codigo":"8547","descricao":"Peças isolantes inteiramente de matérias isolantes, ou com simples peças metálicas de montagem (suportes roscados, por exemplo) incorporadas na massa, para máquinas, aparelhos e instalações elétricas, exceto os isoladores da posição 85.46; tubos isoladores e suas peças de ligação, de metais comuns, isolados interiormente."}},{"id":"SH4:8548","tipo":"SH4","props":{"codigo":"8548","descricao":null}},{"id":"SH4:8549","tipo":"SH4","props":{"codigo":"8549","descricao":"Desperdícios e resíduos, e sucata, elétricos e eletrônicos."}},{"id":"SH4:8601","tipo":"SH4","props":{"codigo":"8601","descricao":"Locomotivas e locotratores, de fonte externa de eletricidade ou de acumuladores elétricos."}},{"id":"SH4:8602","tipo":"SH4","props":{"codigo":"8602","descricao":"Outras locomotivas e locotratores; tênderes."}},{"id":"SH4:8603","tipo":"SH4","props":{"codigo":"8603","descricao":"Litorinas (automotoras), mesmo para circulação urbana, exceto as da posição 86.04."}},{"id":"SH4:8604","tipo":"SH4","props":{"codigo":"8604","descricao":null}},{"id":"SH4:8605","tipo":"SH4","props":{"codigo":"8605","descricao":null}},{"id":"SH4:8606","tipo":"SH4","props":{"codigo":"8606","descricao":"Vagões para transporte de mercadorias sobre vias férreas."}},{"id":"SH4:8607","tipo":"SH4","props":{"codigo":"8607","descricao":"Partes de veículos para vias férreas ou semelhantes."}},{"id":"SH4:8608","tipo":"SH4","props":{"codigo":"8608","descricao":null}},{"id":"SH4:8609","tipo":"SH4","props":{"codigo":"8609","descricao":null}},{"id":"SH4:8701","tipo":"SH4","props":{"codigo":"8701","descricao":"Tratores (exceto os carros-tratores da posição 87.09)."}},{"id":"SH4:8702","tipo":"SH4","props":{"codigo":"8702","descricao":"Veículos automóveis para transporte de dez pessoas ou mais, incluindo o motorista."}},{"id":"SH4:8703","tipo":"SH4","props":{"codigo":"8703","descricao":"Automóveis de passageiros e outros veículos automóveis principalmente concebidos para transporte de pessoas (exceto os da posição 87.02), incluindo os veículos de uso misto (<i>station wagons</i>) e os automóveis de corrida."}},{"id":"SH4:8704","tipo":"SH4","props":{"codigo":"8704","descricao":"Veículos automóveis para transporte de mercadorias."}},{"id":"SH4:8705","tipo":"SH4","props":{"codigo":"8705","descricao":"Veículos automóveis para usos especiais (por exemplo, autossocorros, caminhões-guindastes, veículos de combate a incêndio, caminhões-betoneiras, veículos para varrer, veículos para espalhar, veículos-oficinas, veículos radiológicos), exceto os concebidos principalmente para transporte de pessoas ou de mercadorias."}},{"id":"SH4:8706","tipo":"SH4","props":{"codigo":"8706","descricao":null}},{"id":"SH4:8707","tipo":"SH4","props":{"codigo":"8707","descricao":"Carroçarias para os veículos automóveis das posições 87.01 a 87.05, incluindo as cabinas."}},{"id":"SH4:8708","tipo":"SH4","props":{"codigo":"8708","descricao":"Partes e acessórios dos veículos automóveis das posições 87.01 a 87.05."}},{"id":"SH4:8709","tipo":"SH4","props":{"codigo":"8709","descricao":"Veículos automóveis sem dispositivo de elevação, do tipo utilizado em fábricas, armazéns, portos ou aeroportos, para transporte de mercadorias a curtas distâncias; carros-tratores do tipo utilizado nas estações ferroviárias; suas partes."}},{"id":"SH4:8710","tipo":"SH4","props":{"codigo":"8710","descricao":null}},{"id":"SH4:8711","tipo":"SH4","props":{"codigo":"8711","descricao":"Motocicletas (incluindo os ciclomotores) e outros ciclos equipados com motor auxiliar, mesmo com carro lateral; carros laterais."}},{"id":"SH4:8712","tipo":"SH4","props":{"codigo":"8712","descricao":null}},{"id":"SH4:8713","tipo":"SH4","props":{"codigo":"8713","descricao":"Cadeiras de rodas e outros veículos para pessoas com incapacidade, mesmo com motor ou outro mecanismo de propulsão."}},{"id":"SH4:8714","tipo":"SH4","props":{"codigo":"8714","descricao":"Partes e acessórios dos veículos das posições 87.11 a 87.13."}},{"id":"SH4:8715","tipo":"SH4","props":{"codigo":"8715","descricao":null}},{"id":"SH4:8716","tipo":"SH4","props":{"codigo":"8716","descricao":"Reboques e semirreboques, para quaisquer veículos; outros veículos não autopropulsados; suas partes."}},{"id":"SH4:8801","tipo":"SH4","props":{"codigo":"8801","descricao":null}},{"id":"SH4:8802","tipo":"SH4","props":{"codigo":"8802","descricao":"Outros veículos aéreos (por exemplo, helicópteros, aviões), exceto veículos aéreos (aeronaves) não tripulados da posição 88.06; veículos espaciais (incluindo os satélites) e seus veículos de lançamento, e veículos suborbitais."}},{"id":"SH4:8804","tipo":"SH4","props":{"codigo":"8804","descricao":null}},{"id":"SH4:8805","tipo":"SH4","props":{"codigo":"8805","descricao":"Aparelhos e dispositivos para lançamento de veículos aéreos; aparelhos e dispositivos para aterrissagem (aterragem) de veículos aéreos em porta-aviões e aparelhos e dispositivos semelhantes; aparelhos de treinamento de voo em terra; suas partes."}},{"id":"SH4:8806","tipo":"SH4","props":{"codigo":"8806","descricao":"Veículos aéreos (aeronaves) não tripulados."}},{"id":"SH4:8807","tipo":"SH4","props":{"codigo":"8807","descricao":"Partes dos aparelhos das posições 88.01, 88.02 ou 88.06."}},{"id":"SH4:8901","tipo":"SH4","props":{"codigo":"8901","descricao":"Transatlânticos, barcos de excursão, <i>ferryboats</i>, cargueiros, chatas e embarcações semelhantes, para o transporte de pessoas ou de mercadorias."}},{"id":"SH4:8902","tipo":"SH4","props":{"codigo":"8902","descricao":null}},{"id":"SH4:8903","tipo":"SH4","props":{"codigo":"8903","descricao":"Iates e outros barcos e embarcações de recreio ou de esporte; barcos a remos e canoas."}},{"id":"SH4:8904","tipo":"SH4","props":{"codigo":"8904","descricao":null}},{"id":"SH4:8905","tipo":"SH4","props":{"codigo":"8905","descricao":"Barcos-faróis, barcos-bombas, dragas, guindastes flutuantes e outras embarcações em que a navegação é acessória da função principal; docas flutuantes; plataformas de perfuração ou de exploração, flutuantes ou submersíveis."}},{"id":"SH4:8906","tipo":"SH4","props":{"codigo":"8906","descricao":"Outras embarcações, incluindo os navios de guerra e os barcos salva-vidas, exceto os barcos a remos."}},{"id":"SH4:8907","tipo":"SH4","props":{"codigo":"8907","descricao":"Outras estruturas flutuantes (por exemplo, balsas, reservatórios, caixões, boias de amarração, boias de sinalização e semelhantes)."}},{"id":"SH4:8908","tipo":"SH4","props":{"codigo":"8908","descricao":null}},{"id":"SH4:9001","tipo":"SH4","props":{"codigo":"9001","descricao":"Fibras ópticas e feixes de fibras ópticas; cabos de fibras ópticas, exceto os da posição 85.44; matérias polarizantes em folhas ou em placas; lentes (incluindo as de contato), prismas, espelhos e outros elementos de óptica, de qualquer matéria, não montados, exceto os de vidro não trabalhado opticamente."}},{"id":"SH4:9002","tipo":"SH4","props":{"codigo":"9002","descricao":"Lentes, prismas, espelhos e outros elementos de óptica, de qualquer matéria, montados, para instrumentos ou aparelhos, exceto os de vidro não trabalhado opticamente."}},{"id":"SH4:9003","tipo":"SH4","props":{"codigo":"9003","descricao":"Armações para óculos e artigos semelhantes, e suas partes."}},{"id":"SH4:9004","tipo":"SH4","props":{"codigo":"9004","descricao":"Óculos para correção, proteção ou outros fins, e artigos semelhantes."}},{"id":"SH4:9005","tipo":"SH4","props":{"codigo":"9005","descricao":"Binóculos, lunetas, incluindo as astronômicas, telescópios ópticos, e suas armações; outros instrumentos de astronomia e suas armações, exceto os aparelhos de radioastronomia."}},{"id":"SH4:9006","tipo":"SH4","props":{"codigo":"9006","descricao":"Câmeras fotográficas; aparelhos e dispositivos, incluindo as lâmpadas e tubos, de luz relâmpago (<i>flash</i>), para fotografia, exceto as lâmpadas e tubos de descarga da posição 85.39."}},{"id":"SH4:9007","tipo":"SH4","props":{"codigo":"9007","descricao":"Câmeras e projetores, cinematográficos, mesmo com aparelhos de gravação ou de reprodução de som incorporados."}},{"id":"SH4:9008","tipo":"SH4","props":{"codigo":"9008","descricao":"Aparelhos de projeção fixa; aparelhos fotográficos de ampliação ou de redução."}},{"id":"SH4:9010","tipo":"SH4","props":{"codigo":"9010","descricao":"Aparelhos e equipamentos para laboratórios fotográficos ou cinematográficos, não especificados nem compreendidos noutras posições do presente Capítulo; negatoscópios; telas para projeção."}},{"id":"SH4:9011","tipo":"SH4","props":{"codigo":"9011","descricao":"Microscópios ópticos, incluindo os microscópios para fotomicrografia, cinefotomicrografia ou microprojeção."}},{"id":"SH4:9012","tipo":"SH4","props":{"codigo":"9012","descricao":"Microscópios, exceto ópticos; difratógrafos."}},{"id":"SH4:9013","tipo":"SH4","props":{"codigo":"9013","descricao":"Lasers, exceto diodos laser; outros aparelhos e instrumentos de óptica, não especificados nem compreendidos noutras posições do presente Capítulo."}},{"id":"SH4:9014","tipo":"SH4","props":{"codigo":"9014","descricao":"Bússolas, incluindo as agulhas de marear; outros instrumentos e aparelhos de navegação."}},{"id":"SH4:9015","tipo":"SH4","props":{"codigo":"9015","descricao":"Instrumentos e aparelhos de geodésia, topografia, agrimensura, nivelamento, fotogrametria, hidrografia, oceanografia, hidrologia, meteorologia ou de geofísica, exceto bússolas; telêmetros."}},{"id":"SH4:9016","tipo":"SH4","props":{"codigo":"9016","descricao":null}},{"id":"SH4:9017","tipo":"SH4","props":{"codigo":"9017","descricao":"Instrumentos de desenho, de traçado ou de cálculo (por exemplo, máquinas de desenhar, pantógrafos, transferidores, estojos de desenho, réguas de cálculo e discos de cálculo); instrumentos de medida de distâncias de uso manual (por exemplo, metros, micrômetros, paquímetros e calibres), não especificados nem compreendidos noutras posições do presente Capítulo."}},{"id":"SH4:9018","tipo":"SH4","props":{"codigo":"9018","descricao":"Instrumentos e aparelhos para medicina, cirurgia, odontologia e veterinária, incluindo os aparelhos para cintilografia e outros aparelhos eletromédicos, bem como os aparelhos para testes visuais."}},{"id":"SH4:9019","tipo":"SH4","props":{"codigo":"9019","descricao":"Aparelhos de mecanoterapia; aparelhos de massagem; aparelhos de psicotécnica; aparelhos de ozonoterapia, de oxigenoterapia, de aerossolterapia, aparelhos respiratórios de reanimação e outros aparelhos de terapia respiratória."}},{"id":"SH4:9020","tipo":"SH4","props":{"codigo":"9020","descricao":null}},{"id":"SH4:9021","tipo":"SH4","props":{"codigo":"9021","descricao":"Artigos e aparelhos ortopédicos, incluindo as cintas e fundas médico-cirúrgicas e as muletas; talas, goteiras e outros artigos e aparelhos para fraturas; artigos e aparelhos de prótese; aparelhos para facilitar a audição dos surdos e outros aparelhos para compensar uma deficiência ou uma incapacidade, destinados a serem transportados à mão ou sobre as pessoas ou a serem implantados no organismo."}},{"id":"SH4:9022","tipo":"SH4","props":{"codigo":"9022","descricao":"Aparelhos de raios X e aparelhos que utilizem radiações alfa, beta, gama ou outras radiações ionizantes, mesmo para usos médicos, cirúrgicos, odontológicos ou veterinários, incluindo os aparelhos de radiofotografia ou de radioterapia, os tubos de raios X e outros dispositivos geradores de raios X, os geradores de tensão, as mesas de comando, as telas de visualização, as mesas, cadeiras e suportes semelhantes para exame ou tratamento."}},{"id":"SH4:9023","tipo":"SH4","props":{"codigo":"9023","descricao":null}},{"id":"SH4:9024","tipo":"SH4","props":{"codigo":"9024","descricao":"Máquinas e aparelhos para ensaios de dureza, tração, compressão, elasticidade ou de outras propriedades mecânicas de materiais (por exemplo, metais, madeira, têxteis, papel, plástico)."}},{"id":"SH4:9025","tipo":"SH4","props":{"codigo":"9025","descricao":"Densímetros, areômetros, pesa-líquidos e instrumentos flutuantes semelhantes, termômetros, pirômetros, barômetros, higrômetros e psicrômetros, registradores ou não, mesmo combinados entre si."}},{"id":"SH4:9026","tipo":"SH4","props":{"codigo":"9026","descricao":"Instrumentos e aparelhos para medida ou controle da vazão (caudal), do nível, da pressão ou de outras características variáveis dos líquidos ou gases (por exemplo, medidores de vazão (caudal), indicadores de nível, manômetros, contadores de calor), exceto os instrumentos e aparelhos das posições 90.14, 90.15, 90.28 ou 90.32."}},{"id":"SH4:9027","tipo":"SH4","props":{"codigo":"9027","descricao":"Instrumentos e aparelhos para análises físicas ou químicas (por exemplo, polarímetros, refratômetros, espectrômetros, analisadores de gás ou de fumaça (fumos)); instrumentos e aparelhos para ensaios de viscosidade, porosidade, dilatação, tensão superficial ou semelhantes ou para medidas calorimétricas, acústicas ou fotométricas (incluindo os indicadores de tempo de exposição); micrótomos."}},{"id":"SH4:9028","tipo":"SH4","props":{"codigo":"9028","descricao":"Contadores de gases, de líquidos ou de eletricidade, incluindo os aparelhos para a sua aferição."}},{"id":"SH4:9029","tipo":"SH4","props":{"codigo":"9029","descricao":"Outros contadores (por exemplo, contadores de voltas, contadores de produção, taxímetros, totalizadores de caminho percorrido, podômetros); indicadores de velocidade e tacômetros, exceto os das posições 90.14 ou 90.15; estroboscópios."}},{"id":"SH4:9030","tipo":"SH4","props":{"codigo":"9030","descricao":"Osciloscópios, analisadores de espectro e outros instrumentos e aparelhos para medida ou controle de grandezas elétricas; instrumentos e aparelhos para medida ou detecção de radiações alfa, beta, gama, X, cósmicas ou outras radiações ionizantes."}},{"id":"SH4:9031","tipo":"SH4","props":{"codigo":"9031","descricao":"Instrumentos, aparelhos e máquinas de medida ou controle, não especificados nem compreendidos noutras posições do presente Capítulo; projetores de perfis."}},{"id":"SH4:9032","tipo":"SH4","props":{"codigo":"9032","descricao":"Instrumentos e aparelhos para regulação ou controle, automáticos."}},{"id":"SH4:9033","tipo":"SH4","props":{"codigo":"9033","descricao":null}},{"id":"SH4:9101","tipo":"SH4","props":{"codigo":"9101","descricao":"Relógios de pulso, relógios de bolso e relógios semelhantes (incluindo os contadores de tempo dos mesmos tipos), com caixa de metais preciosos ou de metais folheados ou chapeados de metais preciosos (plaquê)."}},{"id":"SH4:9102","tipo":"SH4","props":{"codigo":"9102","descricao":"Relógios de pulso, relógios de bolso e relógios semelhantes (incluindo os contadores de tempo dos mesmos tipos), exceto os da posição 91.01."}},{"id":"SH4:9103","tipo":"SH4","props":{"codigo":"9103","descricao":"Despertadores e outros relógios, com mecanismo de pequeno volume."}},{"id":"SH4:9104","tipo":"SH4","props":{"codigo":"9104","descricao":null}},{"id":"SH4:9105","tipo":"SH4","props":{"codigo":"9105","descricao":"Despertadores, relógios de pêndulo (pêndulas), outros relógios e artigos de relojoaria semelhantes, exceto os com mecanismo de pequeno volume."}},{"id":"SH4:9106","tipo":"SH4","props":{"codigo":"9106","descricao":"Aparelhos de controle do tempo e contadores de tempo, com mecanismo de relojoaria ou com motor síncrono (por exemplo, relógios de ponto, relógios datadores, contadores de horas)."}},{"id":"SH4:9107","tipo":"SH4","props":{"codigo":"9107","descricao":null}},{"id":"SH4:9108","tipo":"SH4","props":{"codigo":"9108","descricao":"Mecanismos de pequeno volume para relógios, completos e montados."}},{"id":"SH4:9109","tipo":"SH4","props":{"codigo":"9109","descricao":"Mecanismos de relojoaria, completos e montados, exceto de pequeno volume."}},{"id":"SH4:9110","tipo":"SH4","props":{"codigo":"9110","descricao":"Mecanismos de relojoaria completos, não montados ou parcialmente montados (<i>chablons</i>); mecanismos de relojoaria incompletos, montados; esboços de mecanismos de relojoaria."}},{"id":"SH4:9111","tipo":"SH4","props":{"codigo":"9111","descricao":"Caixas de relógios das posições 91.01 ou 91.02, e suas partes."}},{"id":"SH4:9112","tipo":"SH4","props":{"codigo":"9112","descricao":"Caixas e semelhantes de artigos de relojoaria, e suas partes."}},{"id":"SH4:9113","tipo":"SH4","props":{"codigo":"9113","descricao":"Pulseiras de relógios, e suas partes."}},{"id":"SH4:9114","tipo":"SH4","props":{"codigo":"9114","descricao":"Outras partes de artigos de relojoaria."}},{"id":"SH4:9201","tipo":"SH4","props":{"codigo":"9201","descricao":"Pianos, mesmo automáticos; cravos e outros instrumentos de cordas, com teclado."}},{"id":"SH4:9202","tipo":"SH4","props":{"codigo":"9202","descricao":"Outros instrumentos musicais de cordas (por exemplo, violões (guitarras*), violinos, harpas)."}},{"id":"SH4:9205","tipo":"SH4","props":{"codigo":"9205","descricao":"Instrumentos musicais de sopro (por exemplo, órgãos de tubos e teclado, acordeões, clarinetes, trompetes, gaitas de foles), exceto os órgãos mecânicos de feira e os realejos."}},{"id":"SH4:9206","tipo":"SH4","props":{"codigo":"9206","descricao":null}},{"id":"SH4:9207","tipo":"SH4","props":{"codigo":"9207","descricao":"Instrumentos musicais cujo som é produzido ou amplificado por meios elétricos (por exemplo, órgãos, guitarras, acordeões)."}},{"id":"SH4:9208","tipo":"SH4","props":{"codigo":"9208","descricao":"Caixas de música, órgãos mecânicos de feira, realejos, pássaros cantores mecânicos, serrotes musicais e outros instrumentos musicais não especificados noutra posição do presente Capítulo; chamarizes de qualquer tipo; apitos, berrantes (cornetas*) e outros instrumentos, de boca, para chamada ou sinalização."}},{"id":"SH4:9209","tipo":"SH4","props":{"codigo":"9209","descricao":"Partes (mecanismos de caixas de música, por exemplo) e acessórios (por exemplo, cartões, discos e rolos para instrumentos mecânicos) de instrumentos musicais; metrônomos e diapasões de qualquer tipo."}},{"id":"SH4:9301","tipo":"SH4","props":{"codigo":"9301","descricao":"Armas de guerra, exceto revólveres, pistolas e armas brancas."}},{"id":"SH4:9302","tipo":"SH4","props":{"codigo":"9302","descricao":null}},{"id":"SH4:9303","tipo":"SH4","props":{"codigo":"9303","descricao":"Outras armas de fogo e aparelhos semelhantes que utilizem a deflagração da pólvora (por exemplo, espingardas e carabinas, de caça, armas de fogo carregáveis exclusivamente pela boca, pistolas lança-foguetes e outros aparelhos concebidos apenas para lançar foguetes de sinalização, pistolas e revólveres para tiro de festim (sem bala), pistolas de êmbolo cativo para abater animais, canhões lança-amarras)."}},{"id":"SH4:9304","tipo":"SH4","props":{"codigo":"9304","descricao":null}},{"id":"SH4:9305","tipo":"SH4","props":{"codigo":"9305","descricao":"Partes e acessórios dos artigos das posições 93.01 a 93.04."}},{"id":"SH4:9306","tipo":"SH4","props":{"codigo":"9306","descricao":"Bombas, granadas, torpedos, minas, mísseis, cartuchos e outras munições e projéteis, e suas partes, incluindo os zagalotes, chumbos de caça e buchas para cartuchos."}},{"id":"SH4:9307","tipo":"SH4","props":{"codigo":"9307","descricao":null}},{"id":"SH4:9401","tipo":"SH4","props":{"codigo":"9401","descricao":"Assentos (exceto os da posição 94.02), mesmo transformáveis em camas, e suas partes."}},{"id":"SH4:9402","tipo":"SH4","props":{"codigo":"9402","descricao":"Mobiliário para medicina, cirurgia, odontologia ou veterinária (por exemplo, mesas de operação, mesas de exames, camas dotadas de mecanismos para usos clínicos, cadeiras odontológicas); cadeiras para salões de cabeleireiro e cadeiras semelhantes, com dispositivos de orientação e de elevação; suas partes."}},{"id":"SH4:9403","tipo":"SH4","props":{"codigo":"9403","descricao":"Outros móveis e suas partes."}},{"id":"SH4:9404","tipo":"SH4","props":{"codigo":"9404","descricao":"Suportes para camas (somiês); colchões, edredões, almofadas, pufes, travesseiros e artigos semelhantes, equipados com molas ou guarnecidos interiormente de quaisquer matérias, compreendendo esses artigos de borracha alveolar ou de plástico alveolar, mesmo recobertos."}},{"id":"SH4:9405","tipo":"SH4","props":{"codigo":"9405","descricao":"Luminárias e aparelhos de iluminação (incluindo os projetores), e suas partes, não especificados nem compreendidos noutras posições; anúncios, cartazes ou tabuletas e placas indicadoras, luminosos, e artigos semelhantes, que contenham uma fonte luminosa fixa permanente, e suas partes não especificadas nem compreendidas noutras posições."}},{"id":"SH4:9406","tipo":"SH4","props":{"codigo":"9406","descricao":"Construções pré-fabricadas."}},{"id":"SH4:9503","tipo":"SH4","props":{"codigo":"9503","descricao":null}},{"id":"SH4:9504","tipo":"SH4","props":{"codigo":"9504","descricao":"Consoles e máquinas de jogos de vídeo, jogos de salão, incluindo os jogos com motor ou outro mecanismo, os bilhares, as mesas especiais para jogos de cassino e os jogos de balizas (pinos) automáticos (boliche), os jogos que funcionem por introdução de moedas, notas (papéis-moeda), cartões de banco, fichas ou por outros meios de pagamento."}},{"id":"SH4:9505","tipo":"SH4","props":{"codigo":"9505","descricao":"Artigos para festas, carnaval ou outros divertimentos, incluindo os artigos de magia e artigos-surpresa."}},{"id":"SH4:9506","tipo":"SH4","props":{"codigo":"9506","descricao":"Artigos e equipamentos para cultura física, ginástica, atletismo, outros esportes (incluindo o tênis de mesa), ou jogos ao ar livre, não especificados nem compreendidos noutras posições deste Capítulo; piscinas, incluindo as infantis."}},{"id":"SH4:9507","tipo":"SH4","props":{"codigo":"9507","descricao":"Varas (Canas*) de pesca, anzóis e outros artigos para a pesca à linha; puçás (camaroeiros), redes de borboletas e redes semelhantes; iscas e chamarizes (exceto os das posições 92.08 ou 97.05) e artigos semelhantes de caça."}},{"id":"SH4:9508","tipo":"SH4","props":{"codigo":"9508","descricao":"Circos ambulantes e coleções de animais ambulantes; equipamentos para parques de diversões e equipamentos para parques aquáticos; atrações de parques e feiras, incluindo as instalações de tiro ao alvo; teatros ambulantes."}},{"id":"SH4:9601","tipo":"SH4","props":{"codigo":"9601","descricao":"Marfim, osso, carapaça de tartaruga, chifre, pontas, coral, madrepérola e outras matérias animais para entalhar, trabalhados, e suas obras (incluindo as obras obtidas por moldagem)."}},{"id":"SH4:9602","tipo":"SH4","props":{"codigo":"9602","descricao":null}},{"id":"SH4:9603","tipo":"SH4","props":{"codigo":"9603","descricao":"Vassouras e escovas, mesmo que constituam partes de máquinas, de aparelhos ou de veículos, vassouras mecânicas de uso manual não motorizadas, pincéis e espanadores; cabeças preparadas para escovas, pincéis e artigos semelhantes; <i>pads</i> (talochas) e rolos para pintura; rodos de borracha ou de matérias flexíveis semelhantes."}},{"id":"SH4:9604","tipo":"SH4","props":{"codigo":"9604","descricao":null}},{"id":"SH4:9605","tipo":"SH4","props":{"codigo":"9605","descricao":null}},{"id":"SH4:9606","tipo":"SH4","props":{"codigo":"9606","descricao":"Botões, incluindo os de pressão; formas e outras partes, de botões ou de botões de pressão; esboços de botões."}},{"id":"SH4:9607","tipo":"SH4","props":{"codigo":"9607","descricao":"Fechos ecler (de correr) e suas partes."}},{"id":"SH4:9608","tipo":"SH4","props":{"codigo":"9608","descricao":"Canetas esferográficas; canetas e marcadores, com ponta de feltro ou com outras pontas porosas; canetas-tinteiro (canetas de tinta permanente*) e outras canetas; estiletes para duplicadores; lapiseiras; canetas porta-penas, porta-lápis e artigos semelhantes; suas partes (incluindo as tampas e prendedores), exceto os artigos da posição 96.09."}},{"id":"SH4:9609","tipo":"SH4","props":{"codigo":"9609","descricao":"Lápis, minas, pastéis, carvões, gizes para escrever ou desenhar e gizes de alfaiate."}},{"id":"SH4:9610","tipo":"SH4","props":{"codigo":"9610","descricao":null}},{"id":"SH4:9611","tipo":"SH4","props":{"codigo":"9611","descricao":null}},{"id":"SH4:9612","tipo":"SH4","props":{"codigo":"9612","descricao":"Fitas impressoras para máquinas de escrever e fitas impressoras semelhantes, tintadas ou preparadas de outra forma para imprimir, montadas ou não em carretéis ou cartuchos; almofadas de carimbo, impregnadas ou não, mesmo com caixa."}},{"id":"SH4:9613","tipo":"SH4","props":{"codigo":"9613","descricao":"Isqueiros e outros acendedores, mesmo mecânicos ou elétricos, e suas partes, exceto pedras e pavios."}},{"id":"SH4:9614","tipo":"SH4","props":{"codigo":"9614","descricao":null}},{"id":"SH4:9615","tipo":"SH4","props":{"codigo":"9615","descricao":"Pentes, travessas para cabelo e artigos semelhantes; grampos (ganchos) e alfinetes para cabelo; pinças, onduladores, bobes (bigudis*) e artigos semelhantes para penteados, exceto os da posição 85.16, e suas partes."}},{"id":"SH4:9616","tipo":"SH4","props":{"codigo":"9616","descricao":"Vaporizadores de toucador, suas armações e cabeças de armações; borlas ou esponjas para pós ou para aplicação de outros cosméticos ou de produtos de toucador."}},{"id":"SH4:9617","tipo":"SH4","props":{"codigo":"9617","descricao":null}},{"id":"SH4:9618","tipo":"SH4","props":{"codigo":"9618","descricao":null}},{"id":"SH4:9619","tipo":"SH4","props":{"codigo":"9619","descricao":null}},{"id":"SH4:9620","tipo":"SH4","props":{"codigo":"9620","descricao":null}},{"id":"SH4:9701","tipo":"SH4","props":{"codigo":"9701","descricao":"Quadros, pinturas e desenhos, feitos inteiramente à mão, exceto os desenhos da posição 49.06 e os artigos manufaturados decorados à mão; colagens, mosaicos e quadros decorativos semelhantes."}},{"id":"SH4:9702","tipo":"SH4","props":{"codigo":"9702","descricao":"Gravuras, estampas e litografias, originais."}},{"id":"SH4:9703","tipo":"SH4","props":{"codigo":"9703","descricao":"Produções originais de arte estatuária ou de escultura, de quaisquer matérias."}},{"id":"SH4:9704","tipo":"SH4","props":{"codigo":"9704","descricao":null}},{"id":"SH4:9705","tipo":"SH4","props":{"codigo":"9705","descricao":"Coleções e peças de coleção que apresentem um interesse arqueológico, etnográfico, histórico, zoológico, botânico, mineralógico, anatômico, paleontológico ou numismático."}},{"id":"SH4:9706","tipo":"SH4","props":{"codigo":"9706","descricao":"Antiguidades com mais de 100 anos."}},{"id":"SH6:010121","tipo":"SH6","props":{"codigo":"010121","descricao":null}},{"id":"SH6:010129","tipo":"SH6","props":{"codigo":"010129","descricao":null}},{"id":"SH6:010130","tipo":"SH6","props":{"codigo":"010130","descricao":null}},{"id":"SH6:010190","tipo":"SH6","props":{"codigo":"010190","descricao":null}},{"id":"SH6:010221","tipo":"SH6","props":{"codigo":"010221","descricao":"-- Reprodutores de raça pura"}},{"id":"SH6:010229","tipo":"SH6","props":{"codigo":"010229","descricao":"-- Outros"}},{"id":"SH6:010231","tipo":"SH6","props":{"codigo":"010231","descricao":"-- Reprodutores de raça pura"}},{"id":"SH6:010239","tipo":"SH6","props":{"codigo":"010239","descricao":"-- Outros"}},{"id":"SH6:010290","tipo":"SH6","props":{"codigo":"010290","descricao":null}},{"id":"SH6:010310","tipo":"SH6","props":{"codigo":"010310","descricao":null}},{"id":"SH6:010391","tipo":"SH6","props":{"codigo":"010391","descricao":null}},{"id":"SH6:010392","tipo":"SH6","props":{"codigo":"010392","descricao":null}},{"id":"SH6:010410","tipo":"SH6","props":{"codigo":"010410","descricao":"- Ovinos"}},{"id":"SH6:010420","tipo":"SH6","props":{"codigo":"010420","descricao":"- Caprinos"}},{"id":"SH6:010511","tipo":"SH6","props":{"codigo":"010511","descricao":"-- Aves da espécie <i>Gallus domesticus</i>"}},{"id":"SH6:010512","tipo":"SH6","props":{"codigo":"010512","descricao":null}},{"id":"SH6:010513","tipo":"SH6","props":{"codigo":"010513","descricao":null}},{"id":"SH6:010514","tipo":"SH6","props":{"codigo":"010514","descricao":null}},{"id":"SH6:010515","tipo":"SH6","props":{"codigo":"010515","descricao":null}},{"id":"SH6:010594","tipo":"SH6","props":{"codigo":"010594","descricao":null}},{"id":"SH6:010599","tipo":"SH6","props":{"codigo":"010599","descricao":null}},{"id":"SH6:010611","tipo":"SH6","props":{"codigo":"010611","descricao":null}},{"id":"SH6:010612","tipo":"SH6","p