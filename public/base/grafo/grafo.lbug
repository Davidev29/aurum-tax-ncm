NCM","props":{"codigo":"96170020","descricao":"Partes","vigente":true,"capitulo":"96"}},{"id":"NCM:96180000","tipo":"NCM","props":{"codigo":"96180000","descricao":"Manequins e artigos semelhantes; autômatos e cenas animadas, para vitrines e mostruários.","vigente":true,"capitulo":"96"}},{"id":"NCM:96190000","tipo":"NCM","props":{"codigo":"96190000","descricao":"Absorventes (Pensos*) e tampões higiênicos, cueiros, fraldas e artigos higiênicos semelhantes, de qualquer matéria.","vigente":true,"capitulo":"96"}},{"id":"NCM:96200000","tipo":"NCM","props":{"codigo":"96200000","descricao":"Monopés, bipés, tripés e artigos semelhantes.","vigente":true,"capitulo":"96"}},{"id":"NCM:97012100","tipo":"NCM","props":{"codigo":"97012100","descricao":"-- Quadros, pinturas e desenhos","vigente":true,"capitulo":"97"}},{"id":"NCM:97012200","tipo":"NCM","props":{"codigo":"97012200","descricao":"-- Mosaicos","vigente":true,"capitulo":"97"}},{"id":"NCM:97012900","tipo":"NCM","props":{"codigo":"97012900","descricao":"-- Outros","vigente":true,"capitulo":"97"}},{"id":"NCM:97019100","tipo":"NCM","props":{"codigo":"97019100","descricao":"-- Quadros, pinturas e desenhos","vigente":true,"capitulo":"97"}},{"id":"NCM:97019200","tipo":"NCM","props":{"codigo":"97019200","descricao":"-- Mosaicos","vigente":true,"capitulo":"97"}},{"id":"NCM:97019900","tipo":"NCM","props":{"codigo":"97019900","descricao":"-- Outros","vigente":true,"capitulo":"97"}},{"id":"NCM:97021000","tipo":"NCM","props":{"codigo":"97021000","descricao":"- Com mais de 100 anos","vigente":true,"capitulo":"97"}},{"id":"NCM:97029000","tipo":"NCM","props":{"codigo":"97029000","descricao":"- Outras","vigente":true,"capitulo":"97"}},{"id":"NCM:97031000","tipo":"NCM","props":{"codigo":"97031000","descricao":"- Com mais de 100 anos","vigente":true,"capitulo":"97"}},{"id":"NCM:97039000","tipo":"NCM","props":{"codigo":"97039000","descricao":"- Outras","vigente":true,"capitulo":"97"}},{"id":"NCM:97040000","tipo":"NCM","props":{"codigo":"97040000","descricao":"Selos postais, selos fiscais, marcas postais, envelopes de primeiro dia (<i>first-day covers</i>), inteiros postais e semelhantes, obliterados, ou não obliterados, exceto os artigos da posição 49.07.","vigente":true,"capitulo":"97"}},{"id":"NCM:97051000","tipo":"NCM","props":{"codigo":"97051000","descricao":"- Coleções e peças de coleção que apresentem um interesse arqueológico, etnográfico ou histórico","vigente":true,"capitulo":"97"}},{"id":"NCM:97052100","tipo":"NCM","props":{"codigo":"97052100","descricao":"-- Espécimes humanos e suas partes","vigente":true,"capitulo":"97"}},{"id":"NCM:97052200","tipo":"NCM","props":{"codigo":"97052200","descricao":"-- Espécies extintas ou ameaçadas de extinção, e suas partes","vigente":true,"capitulo":"97"}},{"id":"NCM:97052900","tipo":"NCM","props":{"codigo":"97052900","descricao":"-- Outras","vigente":true,"capitulo":"97"}},{"id":"NCM:97053100","tipo":"NCM","props":{"codigo":"97053100","descricao":"-- Com mais de 100 anos","vigente":true,"capitulo":"97"}},{"id":"NCM:97053900","tipo":"NCM","props":{"codigo":"97053900","descricao":"-- Outras","vigente":true,"capitulo":"97"}},{"id":"NCM:97061000","tipo":"NCM","props":{"codigo":"97061000","descricao":"- Com mais de 250 anos","vigente":true,"capitulo":"97"}},{"id":"NCM:97069000","tipo":"NCM","props":{"codigo":"97069000","descricao":"- Outras","vigente":true,"capitulo":"97"}},{"id":"SH4:0101","tipo":"SH4","props":{"codigo":"0101","descricao":"Cavalos, asininos e muares, vivos."}},{"id":"SH4:0102","tipo":"SH4","props":{"codigo":"0102","descricao":"Animais vivos da espécie bovina."}},{"id":"SH4:0103","tipo":"SH4","props":{"codigo":"0103","descricao":"Animais vivos da espécie suína."}},{"id":"SH4:0104","tipo":"SH4","props":{"codigo":"0104","descricao":"Animais vivos das espécies ovina e caprina."}},{"id":"SH4:0105","tipo":"SH4","props":{"codigo":"0105","descricao":"Aves da espécie <i>Gallus domesticus</i>, patos, gansos, perus, peruas e galinhas-d'angola (pintadas), das espécies domésticas, vivos."}},{"id":"SH4:0106","tipo":"SH4","props":{"codigo":"0106","descricao":"Outros animais vivos."}},{"id":"SH4:0201","tipo":"SH4","props":{"codigo":"0201","descricao":"Carnes de animais da espécie bovina, frescas ou refrigeradas."}},{"id":"SH4:0202","tipo":"SH4","props":{"codigo":"0202","descricao":"Carnes de animais da espécie bovina, congeladas."}},{"id":"SH4:0203","tipo":"SH4","props":{"codigo":"0203","descricao":"Carnes de animais da espécie suína, frescas, refrigeradas ou congeladas."}},{"id":"SH4:0204","tipo":"SH4","props":{"codigo":"0204","descricao":"Carnes de animais das espécies ovina ou caprina, frescas, refrigeradas ou congeladas."}},{"id":"SH4:0205","tipo":"SH4","props":{"codigo":"0205","descricao":null}},{"id":"SH4:0206","tipo":"SH4","props":{"codigo":"0206","descricao":"Miudezas comestíveis de animais das espécies bovina, suína, ovina, caprina, cavalar, asinina e muar, frescas, refrigeradas ou congeladas."}},{"id":"SH4:0207","tipo":"SH4","props":{"codigo":"0207","descricao":"Carnes e miudezas, comestíveis, frescas, refrigeradas ou congeladas, das aves da posição 01.05."}},{"id":"SH4:0208","tipo":"SH4","props":{"codigo":"0208","descricao":"Outras carnes e miudezas comestíveis, frescas, refrigeradas ou congeladas."}},{"id":"SH4:0209","tipo":"SH4","props":{"codigo":"0209","descricao":"Toucinho sem partes magras, gorduras de porco e de aves, não fundidas nem extraídas de outro modo, frescos, refrigerados, congelados, salgados ou em salmoura, secos ou defumados (fumados)."}},{"id":"SH4:0210","tipo":"SH4","props":{"codigo":"0210","descricao":"Carnes e miudezas, comestíveis, salgadas ou em salmoura, secas ou defumadas (fumadas); farinhas e pós, comestíveis, de carnes ou de miudezas."}},{"id":"SH4:0301","tipo":"SH4","props":{"codigo":"0301","descricao":"Peixes vivos."}},{"id":"SH4:0302","tipo":"SH4","props":{"codigo":"0302","descricao":"Peixes frescos ou refrigerados, exceto os filés (filetes) de peixes e outra carne de peixes da posição 03.04."}},{"id":"SH4:0303","tipo":"SH4","props":{"codigo":"0303","descricao":"Peixes congelados, exceto os filés (filetes) de peixes e outra carne de peixes da posição 03.04."}},{"id":"SH4:0304","tipo":"SH4","props":{"codigo":"0304","descricao":"Filés (filetes) de peixes e outra carne de peixes (mesmo picada), frescos, refrigerados ou congelados."}},{"id":"SH4:0305","tipo":"SH4","props":{"codigo":"0305","descricao":"Peixes secos, salgados ou em salmoura; peixes defumados (fumados), mesmo cozidos antes ou durante a defumação."}},{"id":"SH4:0306","tipo":"SH4","props":{"codigo":"0306","descricao":"Crustáceos, mesmo com casca, vivos, frescos, refrigerados, congelados, secos, salgados ou em salmoura; crustáceos, mesmo com casca, defumados (fumados), mesmo cozidos antes ou durante a defumação; crustáceos com casca, cozidos em água ou vapor, mesmo refrigerados, congelados, secos, salgados ou em salmoura."}},{"id":"SH4:0307","tipo":"SH4","props":{"codigo":"0307","descricao":"Moluscos, mesmo com concha, vivos, frescos, refrigerados, congelados, secos, salgados ou em salmoura; moluscos, mesmo com concha, defumados (fumados), mesmo cozidos antes ou durante a defumação."}},{"id":"SH4:0308","tipo":"SH4","props":{"codigo":"0308","descricao":"Invertebrados aquáticos, exceto crustáceos e moluscos, vivos, frescos, refrigerados, congelados, secos, salgados ou em salmoura; invertebrados aquáticos, exceto crustáceos e moluscos, defumados (fumados), mesmo cozidos antes ou durante a defumação."}},{"id":"SH4:0309","tipo":"SH4","props":{"codigo":"0309","descricao":"Farinhas, pós e <i>pellets</i>, de peixe, crustáceos, moluscos e de outros invertebrados aquáticos, próprios para alimentação humana."}},{"id":"SH4:0401","tipo":"SH4","props":{"codigo":"0401","descricao":"Leite e creme de leite (nata), não concentrados nem adicionados de açúcar ou de outros edulcorantes."}},{"id":"SH4:0402","tipo":"SH4","props":{"codigo":"0402","descricao":"Leite e creme de leite (nata), concentrados ou adicionados de açúcar ou de outros edulcorantes."}},{"id":"SH4:0403","tipo":"SH4","props":{"codigo":"0403","descricao":"Iogurte; leitelho, leite e creme de leite (nata) coalhados, quefir e outros leites e cremes de leite (natas) fermentados ou acidificados, mesmo concentrados ou adicionados de açúcar ou de outros edulcorantes, ou aromatizados ou adicionados de fruta ou de cacau."}},{"id":"SH4:0404","tipo":"SH4","props":{"codigo":"0404","descricao":"Soro de leite, mesmo concentrado ou adicionado de açúcar ou de outros edulcorantes; produtos constituídos por componentes naturais do leite, mesmo adicionados de açúcar ou de outros edulcorantes, não especificados nem compreendidos noutras posições."}},{"id":"SH4:0405","tipo":"SH4","props":{"codigo":"0405","descricao":"Manteiga e outras matérias gordas provenientes do leite; pasta de espalhar (barrar) de produtos provenientes do leite."}},{"id":"SH4:0406","tipo":"SH4","props":{"codigo":"0406","descricao":"Queijos e requeijão."}},{"id":"SH4:0407","tipo":"SH4","props":{"codigo":"0407","descricao":"Ovos de aves, com casca, frescos, conservados ou cozidos."}},{"id":"SH4:0408","tipo":"SH4","props":{"codigo":"0408","descricao":"Ovos de aves, sem casca, e gemas de ovos, frescos, secos, cozidos em água ou vapor, moldados, congelados ou conservados de outro modo, mesmo adicionados de açúcar ou de outros edulcorantes."}},{"id":"SH4:0409","tipo":"SH4","props":{"codigo":"0409","descricao":null}},{"id":"SH4:0410","tipo":"SH4","props":{"codigo":"0410","descricao":"Insetos e outros produtos comestíveis de origem animal, não especificados nem compreendidos noutras posições."}},{"id":"SH4:0501","tipo":"SH4","props":{"codigo":"0501","descricao":null}},{"id":"SH4:0502","tipo":"SH4","props":{"codigo":"0502","descricao":"Cerdas de porco ou de javali; pelos de texugo e outros pelos para escovas, pincéis e artigos semelhantes; desperdícios destas cerdas e pelos."}},{"id":"SH4:0504","tipo":"SH4","props":{"codigo":"0504","descricao":null}},{"id":"SH4:0505","tipo":"SH4","props":{"codigo":"0505","descricao":"Peles e outras partes de aves, com as suas penas ou penugem, penas e partes de penas (mesmo aparadas), penugem, em bruto ou simplesmente limpas, desinfetadas ou preparadas tendo em vista a sua conservação; pós e desperdícios de penas ou de partes de penas."}},{"id":"SH4:0506","tipo":"SH4","props":{"codigo":"0506","descricao":"Ossos e núcleos córneos, em bruto, desengordurados ou simplesmente preparados (mas não cortados em forma determinada), acidulados ou degelatinados; pós e desperdícios destas matérias."}},{"id":"SH4:0507","tipo":"SH4","props":{"codigo":"0507","descricao":"Marfim, carapaças de tartaruga, barbas, incluindo as franjas, de baleia ou de outros mamíferos marinhos, chifres, galhadas, cascos, unhas, garras e bicos, em bruto ou simplesmente preparados, mas não cortados em forma determinada; pós e desperdícios destas matérias."}},{"id":"SH4:0508","tipo":"SH4","props":{"codigo":"0508","descricao":null}},{"id":"SH4:0510","tipo":"SH4","props":{"codigo":"0510","descricao":null}},{"id":"SH4:0511","tipo":"SH4","props":{"codigo":"0511","descricao":"Produtos de origem animal, não especificados nem compreendidos noutras posições; animais mortos dos Capítulos 1 ou 3, impróprios para alimentação humana."}},{"id":"SH4:0601","tipo":"SH4","props":{"codigo":"0601","descricao":"Bulbos, tubérculos, raízes tuberosas, cormos, coroas e rizomas, em repouso vegetativo, em vegetação ou em flor; mudas, plantas e raízes de chicória, exceto as raízes da posição 12.12."}},{"id":"SH4:0602","tipo":"SH4","props":{"codigo":"0602","descricao":"Outras plantas vivas (incluindo as suas raízes), estacas e enxertos; micélios de cogumelos."}},{"id":"SH4:0603","tipo":"SH4","props":{"codigo":"0603","descricao":"Flores e botões de flores, cortados, para buquês (ramos*) ou para ornamentação, frescos, secos, branqueados, tingidos, impregnados ou preparados de outro modo."}},{"id":"SH4:0604","tipo":"SH4","props":{"codigo":"0604","descricao":"Folhagem, folhas, ramos e outras partes de plantas, sem flores nem botões de flores, e ervas, musgos e líquenes, para buquês (ramos de flores*) ou para ornamentação, frescos, secos, branqueados, tingidos, impregnados ou preparados de outro modo."}},{"id":"SH4:0701","tipo":"SH4","props":{"codigo":"0701","descricao":"Batatas, frescas ou refrigeradas."}},{"id":"SH4:0702","tipo":"SH4","props":{"codigo":"0702","descricao":null}},{"id":"SH4:0703","tipo":"SH4","props":{"codigo":"0703","descricao":"Cebolas, chalotas, alhos, alhos-porros e outros produtos hortícolas aliáceos, frescos ou refrigerados."}},{"id":"SH4:0704","tipo":"SH4","props":{"codigo":"0704","descricao":"Couves, couve-flor, repolho ou couve frisada, couve-rábano e produtos comestíveis semelhantes do gênero <i>Brassica</i>, frescos ou refrigerados."}},{"id":"SH4:0705","tipo":"SH4","props":{"codigo":"0705","descricao":"Alface (<i>Lactuca sativa</i>) e chicórias (<i>Cichorium</i> spp.), frescas ou refrigeradas."}},{"id":"SH4:0706","tipo":"SH4","props":{"codigo":"0706","descricao":"Cenouras, nabos, beterrabas para salada, cercefi, aipo-rábano, rabanetes e raízes comestíveis semelhantes, frescos ou refrigerados."}},{"id":"SH4:0707","tipo":"SH4","props":{"codigo":"0707","descricao":null}},{"id":"SH4:0708","tipo":"SH4","props":{"codigo":"0708","descricao":"Legumes de vagem, mesmo com vagem, frescos ou refrigerados."}},{"id":"SH4:0709","tipo":"SH4","props":{"codigo":"0709","descricao":"Outros produtos hortícolas, frescos ou refrigerados."}},{"id":"SH4:0710","tipo":"SH4","props":{"codigo":"0710","descricao":"Produtos hortícolas, não cozidos ou cozidos em água ou vapor, congelados."}},{"id":"SH4:0711","tipo":"SH4","props":{"codigo":"0711","descricao":"Produtos hortícolas conservados transitoriamente, mas impróprios para alimentação nesse estado."}},{"id":"SH4:0712","tipo":"SH4","props":{"codigo":"0712","descricao":"Produtos hortícolas secos, mesmo cortados em pedaços ou fatias, ou ainda triturados ou em pó, mas sem qualquer outro preparo."}},{"id":"SH4:0713","tipo":"SH4","props":{"codigo":"0713","descricao":"Legumes de vagem, secos, em grão, mesmo pelados ou partidos."}},{"id":"SH4:0714","tipo":"SH4","props":{"codigo":"0714","descricao":"Raízes de mandioca, de araruta e de salepo, tupinambos, batatas-doces e raízes ou tubérculos semelhantes, com elevado teor de fécula ou de inulina, frescos, refrigerados, congelados ou secos, mesmo cortados em pedaços ou em <i>pellets</i>; medula de sagueiro."}},{"id":"SH4:0801","tipo":"SH4","props":{"codigo":"0801","descricao":"Cocos, castanha-do-brasil (castanha-do-pará) e castanha-de-caju, frescos ou secos, mesmo com casca ou pelados."}},{"id":"SH4:0802","tipo":"SH4","props":{"codigo":"0802","descricao":"Outra fruta de casca rija, fresca ou seca, mesmo com casca ou pelada."}},{"id":"SH4:0803","tipo":"SH4","props":{"codigo":"0803","descricao":"Bananas, incluindo as bananas-da-terra (bananas-pão*) (plátanos*), frescas ou secas."}},{"id":"SH4:0804","tipo":"SH4","props":{"codigo":"0804","descricao":"Tâmaras, figos, abacaxis (ananases), abacates, goiabas, mangas e mangostões, frescos ou secos."}},{"id":"SH4:0805","tipo":"SH4","props":{"codigo":"0805","descricao":"Citros (citrinos), frescos ou secos."}},{"id":"SH4:0806","tipo":"SH4","props":{"codigo":"0806","descricao":"Uvas frescas ou secas (passas)."}},{"id":"SH4:0807","tipo":"SH4","props":{"codigo":"0807","descricao":"Melões, melancias e mamões (papaias), frescos."}},{"id":"SH4:0808","tipo":"SH4","props":{"codigo":"0808","descricao":"Maçãs, peras e marmelos, frescos."}},{"id":"SH4:0809","tipo":"SH4","props":{"codigo":"0809","descricao":"Damascos, cerejas, pêssegos (incluindo as nectarinas), ameixas e abrunhos, frescos."}},{"id":"SH4:0810","tipo":"SH4","props":{"codigo":"0810","descricao":"Outra fruta fresca."}},{"id":"SH4:0811","tipo":"SH4","props":{"codigo":"0811","descricao":"Fruta, não cozida ou cozida em água ou vapor, congelada, mesmo adicionada de açúcar ou de outros edulcorantes."}},{"id":"SH4:0812","tipo":"SH4","props":{"codigo":"0812","descricao":"Fruta conservada transitoriamente, mas imprópria para alimentação nesse estado."}},{"id":"SH4:0813","tipo":"SH4","props":{"codigo":"0813","descricao":"Fruta seca, exceto a das posições 08.01 a 08.06; misturas de fruta seca ou de fruta de casca rija, do presente Capítulo."}},{"id":"SH4:0814","tipo":"SH4","props":{"codigo":"0814","descricao":null}},{"id":"SH4:0901","tipo":"SH4","props":{"codigo":"0901","descricao":"Café, mesmo torrado ou descafeinado; cascas e películas de café; sucedâneos do café que contenham café em qualquer proporção."}},{"id":"SH4:0902","tipo":"SH4","props":{"codigo":"0902","descricao":"Chá, mesmo aromatizado."}},{"id":"SH4:0903","tipo":"SH4","props":{"codigo":"0903","descricao":null}},{"id":"SH4:0904","tipo":"SH4","props":{"codigo":"0904","descricao":"Pimenta do gênero <i>Piper</i>; pimentões (pimentos) e pimentas do gênero <i>Capsicum</i> ou do gênero <i>Pimenta</i>, secos ou triturados ou em pó."}},{"id":"SH4:0905","tipo":"SH4","props":{"codigo":"0905","descricao":"Baunilha."}},{"id":"SH4:0906","tipo":"SH4","props":{"codigo":"0906","descricao":"Canela e flores de caneleira."}},{"id":"SH4:0907","tipo":"SH4","props":{"codigo":"0907","descricao":"Cravo-da-índia (frutos, flores e pedúnculos)."}},{"id":"SH4:0908","tipo":"SH4","props":{"codigo":"0908","descricao":"Noz-moscada, macis, amomos e cardamomos."}},{"id":"SH4:0909","tipo":"SH4","props":{"codigo":"0909","descricao":"Sementes de anis (erva-doce), badiana (anis-estrelado), funcho, coentro, cominho ou alcaravia; bagas de zimbro."}},{"id":"SH4:0910","tipo":"SH4","props":{"codigo":"0910","descricao":"Gengibre, açafrão, cúrcuma, tomilho, louro, caril e outras especiarias."}},{"id":"SH4:1001","tipo":"SH4","props":{"codigo":"1001","descricao":"Trigo e mistura de trigo com centeio (<i>méteil</i>)."}},{"id":"SH4:1002","tipo":"SH4","props":{"codigo":"1002","descricao":"Centeio."}},{"id":"SH4:1003","tipo":"SH4","props":{"codigo":"1003","descricao":"Cevada."}},{"id":"SH4:1004","tipo":"SH4","props":{"codigo":"1004","descricao":"Aveia."}},{"id":"SH4:1005","tipo":"SH4","props":{"codigo":"1005","descricao":"Milho."}},{"id":"SH4:1006","tipo":"SH4","props":{"codigo":"1006","descricao":"Arroz."}},{"id":"SH4:1007","tipo":"SH4","props":{"codigo":"1007","descricao":"Sorgo de grão."}},{"id":"SH4:1008","tipo":"SH4","props":{"codigo":"1008","descricao":"Trigo mourisco, painço e alpiste; outros cereais."}},{"id":"SH4:1101","tipo":"SH4","props":{"codigo":"1101","descricao":null}},{"id":"SH4:1102","tipo":"SH4","props":{"codigo":"1102","descricao":"Farinhas de cereais, exceto de trigo ou de mistura de trigo com centeio (<i>méteil</i>)."}},{"id":"SH4:1103","tipo":"SH4","props":{"codigo":"1103","descricao":"Grumos, sêmolas e <i>pellets</i>, de cereais."}},{"id":"SH4:1104","tipo":"SH4","props":{"codigo":"1104","descricao":"Grãos de cereais trabalhados de outro modo (por exemplo, descascados, esmagados, em flocos, em pérolas, cortados ou partidos), com exclusão do arroz da posição 10.06; germes de cereais, inteiros, esmagados, em flocos ou moídos."}},{"id":"SH4:1105","tipo":"SH4","props":{"codigo":"1105","descricao":"Farinha, sêmola, pó, flocos, grânulos e <i>pellets</i>, de batata."}},{"id":"SH4:1106","tipo":"SH4","props":{"codigo":"1106","descricao":"Farinhas, sêmolas e pós, dos legumes de vagem, secos, da posição 07.13, de sagu ou das raízes ou tubérculos da posição 07.14 e dos produtos do Capítulo 8."}},{"id":"SH4:1107","tipo":"SH4","props":{"codigo":"1107","descricao":"Malte, mesmo torrado."}},{"id":"SH4:1108","tipo":"SH4","props":{"codigo":"1108","descricao":"Amidos e féculas; inulina."}},{"id":"SH4:1109","tipo":"SH4","props":{"codigo":"1109","descricao":null}},{"id":"SH4:1201","tipo":"SH4","props":{"codigo":"1201","descricao":"Soja, mesmo triturada."}},{"id":"SH4:1202","tipo":"SH4","props":{"codigo":"1202","descricao":"Amendoins não torrados nem de outro modo cozidos, mesmo descascados ou triturados."}},{"id":"SH4:1203","tipo":"SH4","props":{"codigo":"1203","descricao":null}},{"id":"SH4:1204","tipo":"SH4","props":{"codigo":"1204","descricao":null}},{"id":"SH4:1205","tipo":"SH4","props":{"codigo":"1205","descricao":"Sementes de nabo silvestre ou de colza, mesmo trituradas."}},{"id":"SH4:1206","tipo":"SH4","props":{"codigo":"1206","descricao":null}},{"id":"SH4:1207","tipo":"SH4","props":{"codigo":"1207","descricao":"Outras sementes e frutos oleaginosos, mesmo triturados."}},{"id":"SH4:1208","tipo":"SH4","props":{"codigo":"1208","descricao":"Farinhas de sementes ou de frutos oleaginosos, exceto farinha de mostarda."}},{"id":"SH4:1209","tipo":"SH4","props":{"codigo":"1209","descricao":"Sementes, frutos e esporos, para semeadura (sementeira)."}},{"id":"SH4:1210","tipo":"SH4","props":{"codigo":"1210","descricao":"Cones de lúpulo, frescos ou secos, mesmo triturados ou moídos ou em <i>pellets</i>; lupulina."}},{"id":"SH4:1211","tipo":"SH4","props":{"codigo":"1211","descricao":"Plantas, partes de plantas, sementes e frutos, das espécies utilizadas principalmente em perfumaria, medicina ou como inseticidas, parasiticidas e semelhantes, frescos, refrigerados, congelados ou secos, mesmo cortados, triturados ou em pó."}},{"id":"SH4:1212","tipo":"SH4","props":{"codigo":"1212","descricao":"Alfarroba, algas, beterraba sacarina e cana-de-açúcar, frescas, refrigeradas, congeladas ou secas, mesmo em pó; caroços e amêndoas de frutos e outros produtos vegetais (incluindo as raízes de chicória não torradas, da variedade <i>Cichorium intybus sativum</i>) utilizados principalmente na alimentação humana, não especificados nem compreendidos noutras posições."}},{"id":"SH4:1213","tipo":"SH4","props":{"codigo":"1213","descricao":null}},{"id":"SH4:1214","tipo":"SH4","props":{"codigo":"1214","descricao":"Rutabagas, beterrabas forrageiras, raízes forrageiras, feno, alfafa (luzerna), trevo, sanfeno, couves forrageiras, tremoço, ervilhaca e produtos forrageiros semelhantes, mesmo em <i>pellets</i>."}},{"id":"SH4:1301","tipo":"SH4","props":{"codigo":"1301","descricao":"Goma-laca; gomas, resinas, gomas-resinas e oleorresinas (bálsamos, por exemplo), naturais."}},{"id":"SH4:1302","tipo":"SH4","props":{"codigo":"1302","descricao":"Sucos e extratos vegetais; matérias pécticas, pectinatos e pectatos; ágar-ágar e outros produtos mucilaginosos e espessantes, derivados dos vegetais, mesmo modificados."}},{"id":"SH4:1401","tipo":"SH4","props":{"codigo":"1401","descricao":"Matérias vegetais das espécies principalmente utilizadas em cestaria ou espartaria (por exemplo, bambus, rotins, canas, juncos, vimes, ráfia, palha de cereais limpa, branqueada ou tingida, casca de tília)."}},{"id":"SH4:1404","tipo":"SH4","props":{"codigo":"1404","descricao":"Produtos vegetais não especificados nem compreendidos noutras posições."}},{"id":"SH4:1501","tipo":"SH4","props":{"codigo":"1501","descricao":"Gorduras de porco (incluindo a banha) e gorduras de aves, exceto as das posições 02.09 ou 15.03."}},{"id":"SH4:1502","tipo":"SH4","props":{"codigo":"1502","descricao":"Gorduras de animais das espécies bovina, ovina ou caprina, exceto as da posição 15.03."}},{"id":"SH4:1503","tipo":"SH4","props":{"codigo":"1503","descricao":null}},{"id":"SH4:1504","tipo":"SH4","props":{"codigo":"1504","descricao":"Gorduras, óleos e respectivas frações, de peixes ou de mamíferos marinhos, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1505","tipo":"SH4","props":{"codigo":"1505","descricao":null}},{"id":"SH4:1506","tipo":"SH4","props":{"codigo":"1506","descricao":null}},{"id":"SH4:1507","tipo":"SH4","props":{"codigo":"1507","descricao":"Óleo de soja e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1508","tipo":"SH4","props":{"codigo":"1508","descricao":"Óleo de amendoim e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1509","tipo":"SH4","props":{"codigo":"1509","descricao":"Azeite de oliva (oliveira) e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1510","tipo":"SH4","props":{"codigo":"1510","descricao":"Outros óleos e respectivas frações, obtidos exclusivamente a partir de azeitonas, mesmo refinados, mas não quimicamente modificados, e misturas desses óleos ou frações com óleos ou frações da posição 15.09."}},{"id":"SH4:1511","tipo":"SH4","props":{"codigo":"1511","descricao":"Óleo de palma (dendê) e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1512","tipo":"SH4","props":{"codigo":"1512","descricao":"Óleos de girassol, de cártamo ou de algodão, e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1513","tipo":"SH4","props":{"codigo":"1513","descricao":"Óleos de coco (copra), de amêndoa de palma (palmiste) (coconote) ou de babaçu, e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1514","tipo":"SH4","props":{"codigo":"1514","descricao":"Óleos de nabo silvestre, de colza ou de mostarda, e respectivas frações, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1515","tipo":"SH4","props":{"codigo":"1515","descricao":"Outras gorduras e óleos vegetais (incluindo o óleo de jojoba) ou de origem microbiana e respectivas frações, fixos, mesmo refinados, mas não quimicamente modificados."}},{"id":"SH4:1516","tipo":"SH4","props":{"codigo":"1516","descricao":"Gorduras e óleos animais, vegetais ou de origem microbiana e respectivas frações, parcial ou totalmente hidrogenados, interesterificados, reesterificados ou elaidinizados, mesmo refinados, mas não preparados de outro modo."}},{"id":"SH4:1517","tipo":"SH4","props":{"codigo":"1517","descricao":"Margarina; misturas ou preparações alimentícias de gorduras ou de óleos animais, vegetais ou de origem microbiana ou de frações das diferentes gorduras ou óleos do presente Capítulo, exceto as gorduras e óleos alimentícios e respectivas frações da posição 15.16."}},{"id":"SH4:1518","tipo":"SH4","props":{"codigo":"1518","descricao":null}},{"id":"SH4:1520","tipo":"SH4","props":{"codigo":"1520","descricao":null}},{"id":"SH4:1521","tipo":"SH4","props":{"codigo":"1521","descricao":"Ceras vegetais (exceto os triglicerídeos), ceras de abelha ou de outros insetos e espermacete, mesmo refinados ou corados."}},{"id":"SH4:1522","tipo":"SH4","props":{"codigo":"1522","descricao":null}},{"id":"SH4:1601","tipo":"SH4","props":{"codigo":"1601","descricao":null}},{"id":"SH4:1602","tipo":"SH4","props":{"codigo":"1602","descricao":"Outras preparações e conservas de carne, miudezas, sangue ou de insetos."}},{"id":"SH4:1603","tipo":"SH4","props":{"codigo":"1603","descricao":null}},{"id":"SH4:1604","tipo":"SH4","props":{"codigo":"1604","descricao":"Preparações e conservas de peixes; caviar e seus sucedâneos preparados a partir de ovas de peixe."}},{"id":"SH4:1605","tipo":"SH4","props":{"codigo":"1605","descricao":"Crustáceos, moluscos e outros invertebrados aquáticos, preparados ou em conservas."}},{"id":"SH4:1701","tipo":"SH4","props":{"codigo":"1701","descricao":"Açúcares de cana ou de beterraba e sacarose quimicamente pura, no estado sólido."}},{"id":"SH4:1702","tipo":"SH4","props":{"codigo":"1702","descricao":"Outros açúcares, incluindo a lactose, maltose, glicose e frutose (levulose), quimicamente puras, no estado sólido; xaropes de açúcares, sem adição de aromatizantes ou de corantes; sucedâneos do mel, mesmo misturados com mel natural; açúcares e melaços caramelizados."}},{"id":"SH4:1703","tipo":"SH4","props":{"codigo":"1703","descricao":"Melaços resultantes da extração ou refinação do açúcar."}},{"id":"SH4:1704","tipo":"SH4","props":{"codigo":"1704","descricao":"Produtos de confeitaria sem cacau (incluindo o chocolate branco)."}},{"id":"SH4:1801","tipo":"SH4","props":{"codigo":"1801","descricao":null}},{"id":"SH4:1802","tipo":"SH4","props":{"codigo":"1802","descricao":null}},{"id":"SH4:1803","tipo":"SH4","props":{"codigo":"1803","descricao":"Pasta de cacau, mesmo desengordurada."}},{"id":"SH4:1804","tipo":"SH4","props":{"codigo":"1804","descricao":null}},{"id":"SH4:1805","tipo":"SH4","props":{"codigo":"1805","descricao":null}},{"id":"SH4:1806","tipo":"SH4","props":{"codigo":"1806","descricao":"Chocolate e outras preparações alimentícias que contenham cacau."}},{"id":"SH4:1901","tipo":"SH4","props":{"codigo":"1901","descricao":"Extratos de malte; preparações alimentícias de farinhas, grumos, sêmolas, amidos, féculas ou de extratos de malte, que não contenham cacau ou que contenham menos de 40 %, em peso, de cacau, calculado sobre uma base totalmente desengordurada, não especificadas nem compreendidas noutras posições; preparações alimentícias de produtos das posições 04.01 a 04.04, que não contenham cacau ou que contenham menos de 5 %, em peso, de cacau, calculado sobre uma base totalmente desengordurada, não especificadas nem compreendidas noutras posições."}},{"id":"SH4:1902","tipo":"SH4","props":{"codigo":"1902","descricao":"Massas alimentícias, mesmo cozidas ou recheadas (de carne ou de outras substâncias) ou preparadas de outro modo, tais como espaguete, macarrão, aletria, lasanha, nhoque, ravióli e canelone; cuscuz, mesmo preparado."}},{"id":"SH4:1903","tipo":"SH4","props":{"codigo":"1903","descricao":null}},{"id":"SH4:1904","tipo":"SH4","props":{"codigo":"1904","descricao":"Produtos à base de cereais, obtidos por expansão ou por torrefação (flocos de milho (<i>corn flakes</i>), por exemplo); cereais (exceto milho) em grãos ou sob a forma de flocos ou de outros grãos trabalhados (com exceção da farinha, do grumo e da sêmola), pré-cozidos ou preparados de outro modo, não especificados nem compreendidos noutras posições."}},{"id":"SH4:1905","tipo":"SH4","props":{"codigo":"1905","descricao":"Produtos de padaria, pastelaria ou da indústria de bolachas e biscoitos, mesmo adicionados de cacau; hóstias, cápsulas vazias para medicamentos, obreias, pastas secas de farinha, amido ou fécula, em folhas, e produtos semelhantes."}},{"id":"SH4:2001","tipo":"SH4","props":{"codigo":"2001","descricao":"Produtos hortícolas, fruta e outras partes comestíveis de plantas, preparados ou conservados em vinagre ou em ácido acético."}},{"id":"SH4:2002","tipo":"SH4","props":{"codigo":"2002","descricao":"Tomates preparados ou conservados, exceto em vinagre ou em ácido acético."}},{"id":"SH4:2003","tipo":"SH4","props":{"codigo":"2003","descricao":"Cogumelos e trufas, preparados ou conservados, exceto em vinagre ou em ácido acético."}},{"id":"SH4:2004","tipo":"SH4","props":{"codigo":"2004","descricao":"Outros produtos hortícolas preparados ou conservados, exceto em vinagre ou em ácido acético, congelados, com exceção dos produtos da posição 20.06."}},{"id":"SH4:2005","tipo":"SH4","props":{"codigo":"2005","descricao":"Outros produtos hortícolas preparados ou conservados, exceto em vinagre ou em ácido acético, não congelados, com exceção dos produtos da posição 20.06."}},{"id":"SH4:2006","tipo":"SH4","props":{"codigo":"2006","descricao":null}},{"id":"SH4:2007","tipo":"SH4","props":{"codigo":"2007","descricao":"Doces, geleias, <i>marmelades</i>, purês e pastas de fruta, obtidos por cozimento, mesmo com adição de açúcar ou de outros edulcorantes."}},{"id":"SH4:2008","tipo":"SH4","props":{"codigo":"2008","descricao":"Fruta e outras partes comestíveis de plantas, preparadas ou conservadas de outro modo, mesmo com adição de açúcar ou de outros edulcorantes ou de álcool, não especificadas nem compreendidas noutras posições."}},{"id":"SH4:2009","tipo":"SH4","props":{"codigo":"2009","descricao":"Sucos (sumos) de fruta (incluindo os mostos de uvas e a água de coco) ou de produtos hortícolas, não fermentados, sem adição de álcool, mesmo com adição de açúcar ou de outros edulcorantes."}},{"id":"SH4:2101","tipo":"SH4","props":{"codigo":"2101","descricao":"Extratos, essências e concentrados de café, chá ou mate e preparações à base destes produtos ou à base de café, chá ou mate; chicória torrada e outros sucedâneos torrados do café e respectivos extratos, essências e concentrados."}},{"id":"SH4:2102","tipo":"SH4","props":{"codigo":"2102","descricao":"Leveduras (vivas ou mortas); outros microrganismos monocelulares mortos (exceto as vacinas da posição 30.02); pós para levedar, preparados."}},{"id":"SH4:2103","tipo":"SH4","props":{"codigo":"2103","descricao":"Preparações para molhos e molhos preparados; condimentos e temperos compostos; farinha de mostarda e mostarda preparada."}},{"id":"SH4:2104","tipo":"SH4","props":{"codigo":"2104","descricao":"Preparações para caldos e sopas; caldos e sopas preparados; preparações alimentícias compostas homogeneizadas."}},{"id":"SH4:2105","tipo":"SH4","props":{"codigo":"2105","descricao":null}},{"id":"SH4:2106","tipo":"SH4","props":{"codigo":"2106","descricao":"Preparações alimentícias não especificadas nem compreendidas noutras posições."}},{"id":"SH4:2201","tipo":"SH4","props":{"codigo":"2201","descricao":"Águas, incluindo as águas minerais, naturais ou artificiais, e as águas gaseificadas, não adicionadas de açúcar ou de outros edulcorantes nem aromatizadas; gelo e neve."}},{"id":"SH4:2202","tipo":"SH4","props":{"codigo":"2202","descricao":"Águas, incluindo as águas minerais e as águas gaseificadas, adicionadas de açúcar ou de outros edulcorantes ou aromatizadas e outras bebidas não alcoólicas, exceto sucos (sumos) de fruta ou de produtos hortícolas da posição 20.09."}},{"id":"SH4:2203","tipo":"SH4","props":{"codigo":"2203","descricao":null}},{"id":"SH4:2204","tipo":"SH4","props":{"codigo":"2204","descricao":"Vinhos de uvas frescas, incluindo os vinhos enriquecidos com álcool; mostos de uvas, excluindo os da posição 20.09."}},{"id":"SH4:2205","tipo":"SH4","props":{"codigo":"2205","descricao":"Vermutes e outros vinhos de uvas frescas aromatizados por plantas ou substâncias aromáticas."}},{"id":"SH4:2206","tipo":"SH4","props":{"codigo":"2206","descricao":null}},{"id":"SH4:2207","tipo":"SH4","props":{"codigo":"2207","descricao":"Álcool etílico não desnaturado, com um teor alcoólico, em volume, igual ou superior a 80 % vol.; álcool etílico e aguardentes, desnaturados, com qualquer teor alcoólico."}},{"id":"SH4:2208","tipo":"SH4","props":{"codigo":"2208","descricao":"Álcool etílico não desnaturado, com um teor alcoólico, em volume, inferior a 80 % vol.; aguardentes, licores e outras bebidas espirituosas."}},{"id":"SH4:2209","tipo":"SH4","props":{"codigo":"2209","descricao":null}},{"id":"SH4:2301","tipo":"SH4","props":{"codigo":"2301","descricao":"Farinhas, pós e <i>pellets</i>, de carnes, miudezas, peixes ou crustáceos, moluscos ou de outros invertebrados aquáticos, impróprios para alimentação humana; torresmos."}},{"id":"SH4:2302","tipo":"SH4","props":{"codigo":"2302","descricao":"Sêmeas, farelos e outros resíduos, mesmo em <i>pellets</i>, da peneiração, moagem ou de outros tratamentos de cereais ou de leguminosas."}},{"id":"SH4:2303","tipo":"SH4","props":{"codigo":"2303","descricao":"Resíduos da fabricação do amido e resíduos semelhantes, polpas de beterraba, bagaços de cana-de-açúcar e outros desperdícios da indústria do açúcar, borras e desperdícios da indústria da cerveja e das destilarias, mesmo em <i>pellets</i>."}},{"id":"SH4:2304","tipo":"SH4","props":{"codigo":"2304","descricao":null}},{"id":"SH4:2305","tipo":"SH4","props":{"codigo":"2305","descricao":null}},{"id":"SH4:2306","tipo":"SH4","props":{"codigo":"2306","descricao":"Tortas (bagaços) e outros resíduos sólidos, mesmo triturados ou em <i>pellets</i>, da extração de gorduras ou óleos vegetais ou de origem microbiana, exceto os das posições 23.04 ou 23.05."}},{"id":"SH4:2307","tipo":"SH4","props":{"codigo":"2307","descricao":null}},{"id":"SH4:2308","tipo":"SH4","props":{"codigo":"2308","descricao":null}},{"id":"SH4:2309","tipo":"SH4","props":{"codigo":"2309","descricao":"Preparações do tipo utilizado na alimentação de animais."}},{"id":"SH4:2401","tipo":"SH4","props":{"codigo":"2401","descricao":"Tabaco não manufaturado; desperdícios de tabaco."}},{"id":"SH4:2402","tipo":"SH4","props":{"codigo":"2402","descricao":"Charutos, cigarrilhas e cigarros, de tabaco ou dos seus sucedâneos."}},{"id":"SH4:2403","tipo":"SH4","props":{"codigo":"2403","descricao":"Outros produtos de tabaco e seus sucedâneos, manufaturados; tabaco \"homogeneizado\" ou \"reconstituído\"; extratos e molhos de tabaco."}},{"id":"SH4:2404","tipo":"SH4","props":{"codigo":"2404","descricao":"Produtos que contenham tabaco, tabaco reconstituído, nicotina ou sucedâneos do tabaco ou da nicotina, destinados à inalação sem combustão; outros produtos que contenham nicotina destinados à absorção da nicotina pelo corpo humano."}},{"id":"SH4:2501","tipo":"SH4","props":{"codigo":"2501","descricao":null}},{"id":"SH4:2502","tipo":"SH4","props":{"codigo":"2502","descricao":null}},{"id":"SH4:2503","tipo":"SH4","props":{"codigo":"2503","descricao":null}},{"id":"SH4:2504","tipo":"SH4","props":{"codigo":"2504","descricao":"Grafita natural."}},{"id":"SH4:2505","tipo":"SH4","props":{"codigo":"2505","descricao":"Areias naturais de qualquer espécie, mesmo coradas, exceto areias metalíferas do Capítulo 26."}},{"id":"SH4:2506","tipo":"SH4","props":{"codigo":"2506","descricao":"Quartzo (exceto areias naturais); quartzitos, mesmo desbastados ou simplesmente cortados, à serra ou por outro meio, em blocos ou placas de forma quadrada ou retangular."}},{"id":"SH4:2507","tipo":"SH4","props":{"codigo":"2507","descricao":null}},{"id":"SH4:2508","tipo":"SH4","props":{"codigo":"2508","descricao":"Outras argilas (exceto argilas expandidas da posição 68.06), andaluzita, cianita, silimanita, mesmo calcinadas; mulita; barro cozido em pó (terra de <i>chamotte</i>) e terra de dinas."}},{"id":"SH4:2509","tipo":"SH4","props":{"codigo":"2509","descricao":null}},{"id":"SH4:2510","tipo":"SH4","props":{"codigo":"2510","descricao":"Fosfatos de cálcio naturais, fosfatos aluminocálcicos naturais e cré fosfatado."}},{"id":"SH4:2511","tipo":"SH4","props":{"codigo":"2511","descricao":"Sulfato de bário natural (baritina); carbonato de bário natural (witherita), mesmo calcinado, exceto o óxido de bário da posição 28.16."}},{"id":"SH4:2512","tipo":"SH4","props":{"codigo":"2512","descricao":null}},{"id":"SH4:2513","tipo":"SH4","props":{"codigo":"2513","descricao":"Pedra-pomes; esmeril; corindo natural, granada natural e outros abrasivos naturais, mesmo tratados termicamente."}},{"id":"SH4:2514","tipo":"SH4","props":{"codigo":"2514","descricao":null}},{"id":"SH4:2515","tipo":"SH4","props":{"codigo":"2515","descricao":"Mármores, travertinos, granitos belgas e outras pedras calcárias de cantaria ou de construção, de densidade aparente igual ou superior a 2,5, e alabastro, mesmo desbastados ou simplesmente cortados à serra ou por outro meio, em blocos ou placas de forma quadrada ou retangular."}},{"id":"SH4:2516","tipo":"SH4","props":{"codigo":"2516","descricao":"Granito, pórfiro, basalto, arenito (grés) e outras pedras de cantaria ou de construção, mesmo desbastados ou simplesmente cortados à serra ou por outro meio, em blocos ou placas de forma quadrada ou retangular."}},{"id":"SH4:2517","tipo":"SH4","props":{"codigo":"2517","descricao":"Calhaus, cascalho, pedras britadas, do tipo normalmente utilizado em concreto (betão) ou para empedramento de estradas, de vias férreas ou outros balastros, seixos rolados e sílex, mesmo tratados termicamente; macadame de escórias de altos-fornos, de outras escórias ou de resíduos industriais semelhantes, mesmo que contenham matérias incluídas na primeira parte do texto desta posição; tarmacadame; grânulos, lascas e pós, das pedras das posições 25.15 ou 25.16, mesmo tratados termicamente."}},{"id":"SH4:2518","tipo":"SH4","props":{"codigo":"2518","descricao":"Dolomita, mesmo sinterizada ou calcinada, incluindo a dolomita desbastada ou simplesmente cortada à serra ou por outro meio, em blocos ou placas de forma quadrada ou retangular."}},{"id":"SH4:2519","tipo":"SH4","props":{"codigo":"2519","descricao":"Carbonato de magnésio natural (magnesita); magnésia eletrofundida; magnésia calcinada a fundo (sinterizada), mesmo que contenha pequenas quantidades de outros óxidos adicionados antes da sinterização; outro óxido de magnésio, mesmo puro."}},{"id":"SH4:2520","tipo":"SH4","props":{"codigo":"2520","descricao":"Gipsita; anidrita; gesso, mesmo corado ou adicionado de pequenas quantidades de aceleradores ou retardadores."}},{"id":"SH4:2521","tipo":"SH4","props":{"codigo":"2521","descricao":null}},{"id":"SH4:2522","tipo":"SH4","props":{"codigo":"2522","descricao":"Cal viva, cal apagada e cal hidráulica, com exclusão do óxido e do hidróxido de cálcio da posição 28.25."}},{"id":"SH4:2523","tipo":"SH4","props":{"codigo":"2523","descricao":"Cimentos hidráulicos (incluindo os cimentos não pulverizados, denominados <i>clinkers</i>), mesmo corados."}},{"id":"SH4:2524","tipo":"SH4","props":{"codigo":"2524","descricao":"Amianto."}},{"id":"SH4:2525","tipo":"SH4","props":{"codigo":"2525","descricao":"Mica, incluindo a mica clivada em lamelas irregulares (<i>splittings</i>); desperdícios de mica."}},{"id":"SH4:2526","tipo":"SH4","props":{"codigo":"2526","descricao":"Esteatita natural, mesmo desbastada ou simplesmente cortada à serra ou por outro meio, em blocos ou placas de forma quadrada ou retangular; talco."}},{"id":"SH4:2528","tipo":"SH4","props":{"codigo":"2528","descricao":null}},{"id":"SH4:2529","tipo":"SH4","props":{"codigo":"2529","descricao":"Feldspato; leucita; nefelina e nefelina-sienito; espatoflúor."}},{"id":"SH4:2530","tipo":"SH4","props":{"codigo":"2530","descricao":"Matérias minerais não especificadas nem compreendidas noutras posições."}},{"id":"SH4:2601","tipo":"SH4","props":{"codigo":"2601","descricao":"Minérios de ferro e seus concentrados, incluindo as piritas de ferro ustuladas (cinzas de piritas)."}},{"id":"SH4:2602","tipo":"SH4","props":{"codigo":"2602","descricao":null}},{"id":"SH4:2603","tipo":"SH4","props":{"codigo":"2603","descricao":null}},{"id":"SH4:2604","tipo":"SH4","props":{"codigo":"2604","descricao":null}},{"id":"SH4:2605","tipo":"SH4","props":{"codigo":"2605","descricao":null}},{"id":"SH4:2606","tipo":"SH4","props":{"codigo":"2606","descricao":null}},{"id":"SH4:2607","tipo":"SH4","props":{"codigo":"2607","descricao":null}},{"id":"SH4:2608","tipo":"SH4","props":{"codigo":"2608","descricao":null}},{"id":"SH4:2609","tipo":"SH4","props":{"codigo":"2609","descricao":null}},{"id":"SH4:2610","tipo":"SH4","props":{"codigo":"2610","descricao":null}},{"id":"SH4:2611","tipo":"SH4","props":{"codigo":"2611","descricao":null}},{"id":"SH4:2612","tipo":"SH4","props":{"codigo":"2612","descricao":"Minérios de urânio ou de tório, e seus concentrados."}},{"id":"SH4:2613","tipo":"SH4","props":{"codigo":"2613","descricao":"Minérios de molibdênio e seus concentrados."}},{"id":"SH4:2614","tipo":"SH4","props":{"codigo":"2614","descricao":null}},{"id":"SH4:2615","tipo":"SH4","props":{"codigo":"2615","descricao":"Minérios de nióbio (colômbio), tântalo, vanádio ou de zircônio, e seus concentrados."}},{"id":"SH4:2616","tipo":"SH4","props":{"codigo":"2616","descricao":"Minérios de metais preciosos e seus concentrados."}},{"id":"SH4:2617","tipo":"SH4","props":{"codigo":"2617","descricao":"Outros minérios e seus concentrados."}},{"id":"SH4:2618","tipo":"SH4","props":{"codigo":"2618","descricao":null}},{"id":"SH4:2619","tipo":"SH4","props":{"codigo":"2619","descricao":null}},{"id":"SH4:2620","tipo":"SH4","props":{"codigo":"2620","descricao":"Escórias, cinzas e resíduos (exceto os provenientes da fabricação de ferro fundido, ferro ou aço), que contenham metais, arsênio, ou os seus compostos."}},{"id":"SH4:2621","tipo":"SH4","props":{"codigo":"2621","descricao":"Outras escórias e cinzas, incluindo as cinzas de algas; cinzas e resíduos provenientes da incineração de resíduos municipais."}},{"id":"SH4:2701","tipo":"SH4","props":{"codigo":"2701","descricao":"Hulhas; briquetes, bolas em aglomerados e combustíveis sólidos semelhantes, obtidos a partir da hulha."}},{"id":"SH4:2702","tipo":"SH4","props":{"codigo":"2702","descricao":"Linhitas, mesmo aglomeradas, exceto azeviche."}},{"id":"SH4:2703","tipo":"SH4","props":{"codigo":"2703","descricao":null}},{"id":"SH4:2704","tipo":"SH4","props":{"codigo":"2704","descricao":null}},{"id":"SH4:2705","tipo":"SH4","props":{"codigo":"2705","descricao":null}},{"id":"SH4:2706","tipo":"SH4","props":{"codigo":"2706","descricao":null}},{"id":"SH4:2707","tipo":"SH4","props":{"codigo":"2707","descricao":"Óleos e outros produtos provenientes da destilação dos alcatrões de hulha a alta temperatura; produtos análogos em que os constituintes aromáticos predominem, em peso, relativamente aos constituintes não aromáticos."}},{"id":"SH4:2708","tipo":"SH4","props":{"codigo":"2708","descricao":"Breu e coque de breu obtidos a partir do alcatrão de hulha ou de outros alcatrões minerais."}},{"id":"SH4:2709","tipo":"SH4","props":{"codigo":"2709","descricao":null}},{"id":"SH4:2710","tipo":"SH4","props":{"codigo":"2710","descricao":"Óleos de petróleo ou de minerais betuminosos, exceto óleos brutos; preparações não especificadas nem compreendidas noutras posições, que contenham, como constituintes básicos, 70 % ou mais, em peso, de óleos de petróleo ou de minerais betuminosos; resíduos de óleos."}},{"id":"SH4:2711","tipo":"SH4","props":{"codigo":"2711","descricao":"Gás de petróleo e outros hidrocarbonetos gasosos."}},{"id":"SH4:2712","tipo":"SH4","props":{"codigo":"2712","descricao":"Vaselina; parafina, cera de petróleo microcristalina, <i>slack wax</i>, ozocerite, cera de linhita, cera de turfa, outras ceras minerais e produtos semelhantes obtidos por síntese ou por outros processos, mesmo corados."}},{"id":"SH4:2713","tipo":"SH4","props":{"codigo":"2713","descricao":"Coque de petróleo, betume de petróleo e outros resíduos dos óleos de petróleo ou de minerais betuminosos."}},{"id":"SH4:2714","tipo":"SH4","props":{"codigo":"2714","descricao":"Betumes e asfaltos, naturais; xistos e areias betuminosos; asfaltitas e rochas asfálticas."}},{"id":"SH4:2715","tipo":"SH4","props":{"codigo":"2715","descricao":null}},{"id":"SH4:2716","tipo":"SH4","props":{"codigo":"2716","descricao":null}},{"id":"SH4:2801","tipo":"SH4","props":{"codigo":"2801","descricao":"Flúor, cloro, bromo e iodo."}},{"id":"SH4:2802","tipo":"SH4","props":{"codigo":"2802","descricao":null}},{"id":"SH4:2803","tipo":"SH4","props":{"codigo":"2803","descricao":null}},{"id":"SH4:2804","tipo":"SH4","props":{"codigo":"2804","descricao":"Hidrogênio, gases raros e outros elementos não metálicos."}},{"id":"SH4:2805","tipo":"SH4","props":{"codigo":"2805","descricao":"Metais alcalinos ou alcalinoterrosos; metais de terras raras, escândio e ítrio, mesmo misturados ou ligados entre si; mercúrio."}},{"id":"SH4:2806","tipo":"SH4","props":{"codigo":"2806","descricao":"Cloreto de hidrogênio (ácido clorídrico); ácido clorossulfúrico."}},{"id":"SH4:2807","tipo":"SH4","props":{"codigo":"2807","descricao":null}},{"id":"SH4:2808","tipo":"SH4","props":{"codigo":"2808","descricao":null}},{"id":"SH4:2809","tipo":"SH4","props":{"codigo":"2809","descricao":"Pentóxido de difósforo; ácido fosfórico; ácidos polifosfóricos, de constituição química definida ou não."}},{"id":"SH4:2810","tipo":"SH4","props":{"codigo":"2810","descricao":null}},{"id":"SH4:2811","tipo":"SH4","props":{"codigo":"2811","descricao":"Outros ácidos inorgânicos e outros compostos oxigenados inorgânicos dos elementos não metálicos."}},{"id":"SH4:2812","tipo":"SH4","props":{"codigo":"2812","descricao":"Halogenetos e oxialogenetos dos elementos não metálicos."}},{"id":"SH4:2813","tipo":"SH4","props":{"codigo":"2813","descricao":"Sulfetos dos elementos não metálicos; trissulfeto de fósforo comercial."}},{"id":"SH4:2814","tipo":"SH4","props":{"codigo":"2814","descricao":"Amoníaco anidro ou em solução aquosa (amônia)."}},{"id":"SH4:2815","tipo":"SH4","props":{"codigo":"2815","descricao":"Hidróxido de sódio (soda cáustica); hidróxido de potássio (potassa cáustica); peróxidos de sódio ou de potássio."}},{"id":"SH4:2816","tipo":"SH4","props":{"codigo":"2816","descricao":"Hidróxido e peróxido de magnésio; óxidos, hidróxidos e peróxidos, de estrôncio ou de bário."}},{"id":"SH4:2817","tipo":"SH4","props":{"codigo":"2817","descricao":null}},{"id":"SH4:2818","tipo":"SH4","props":{"codigo":"2818","descricao":"Corindo artificial, de constituição química definida ou não; óxido de alumínio; hidróxido de alumínio."}},{"id":"SH4:2819","tipo":"SH4","props":{"codigo":"2819","descricao":"Óxidos e hidróxidos de cromo."}},{"id":"SH4:2820","tipo":"SH4","props":{"codigo":"2820","descricao":"Óxidos de manganês."}},{"id":"SH4:2821","tipo":"SH4","props":{"codigo":"2821","descricao":"Óxidos e hidróxidos de ferro; terras corantes que contenham, em peso, 70 % ou mais de ferro combinado, expresso em Fe<sub>2</sub>O<sub>3</sub>."}},{"id":"SH4:2822","tipo":"SH4","props":{"codigo":"2822","descricao":null}},{"id":"SH4:2823","tipo":"SH4","props":{"codigo":"2823","descricao":null}},{"id":"SH4:2824","tipo":"SH4","props":{"codigo":"2824","descricao":"Óxidos de chumbo; mínio (zarcão) e mínio-laranja (<i>mine-orange</i>)."}},{"id":"SH4:2825","tipo":"SH4","props":{"codigo":"2825","descricao":"Hidrazina e hidroxilamina, e seus sais inorgânicos; outras bases inorgânicas; outros óxidos, hidróxidos e peróxidos, de metais."}},{"id":"SH4:2826","tipo":"SH4","props":{"codigo":"2826","descricao":"Fluoretos; fluorossilicatos, fluoraluminatos e outros sais complexos de flúor."}},{"id":"SH4:2827","tipo":"SH4","props":{"codigo":"2827","descricao":"Cloretos, oxicloretos e hidroxicloretos; brometos e oxibrometos; iodetos e oxiodetos."}},{"id":"SH4:2828","tipo":"SH4","props":{"codigo":"2828","descricao":"Hipocloritos; hipoclorito de cálcio comercial; cloritos; hipobromitos."}},{"id":"SH4:2829","tipo":"SH4","props":{"codigo":"2829","descricao":"Cloratos e percloratos; bromatos e perbromatos; iodatos e periodatos."}},{"id":"SH4:2830","tipo":"SH4","props":{"codigo":"2830","descricao":"Sulfetos; polissulfetos, de constituição química definida ou não."}},{"id":"SH4:2831","tipo":"SH4","props":{"codigo":"2831","descricao":"Ditionitos e sulfoxilatos."}},{"id":"SH4:2832","tipo":"SH4","props":{"codigo":"2832","descricao":"Sulfitos; tiossulfatos."}},{"id":"SH4:2833","tipo":"SH4","props":{"codigo":"2833","descricao":"Sulfatos; alumes; peroxossulfatos (persulfatos)."}},{"id":"SH4:2834","tipo":"SH4","props":{"codigo":"2834","descricao":"Nitritos; nitratos."}},{"id":"SH4:2835","tipo":"SH4","props":{"codigo":"2835","descricao":"Fosfinatos (hipofosfitos), fosfonatos (fosfitos) e fosfatos; polifosfatos de constituição química definida ou não."}},{"id":"SH4:2836","tipo":"SH4","props":{"codigo":"2836","descricao":"Carbonatos; peroxocarbonatos (percarbonatos); carbonato de amônio comercial que contenha carbamato de amônio."}},{"id":"SH4:2837","tipo":"SH4","props":{"codigo":"2837","descricao":"Cianetos, oxicianetos e cianetos complexos."}},{"id":"SH4:2839","tipo":"SH4","props":{"codigo":"2839","descricao":"Silicatos; silicatos dos metais alcalinos comerciais."}},{"id":"SH4:2840","tipo":"SH4","props":{"codigo":"2840","descricao":"Boratos; peroxoboratos (perboratos)."}},{"id":"SH4:2841","tipo":"SH4","props":{"codigo":"2841","descricao":"Sais dos ácidos oxometálicos ou peroxometálicos."}},{"id":"SH4:2842","tipo":"SH4","props":{"codigo":"2842","descricao":"Outros sais dos ácidos ou peroxoácidos inorgânicos (incluindo os aluminossilicatos de constituição química definida ou não), exceto as azidas."}},{"id":"SH4:2843","tipo":"SH4","props":{"codigo":"2843","descricao":"Metais preciosos no estado coloidal; compostos inorgânicos ou orgânicos de metais preciosos, de constituição química definida ou não; amálgamas de metais preciosos."}},{"id":"SH4:2844","tipo":"SH4","props":{"codigo":"2844","descricao":"Elementos químicos radioativos e isótopos radioativos (incluindo os elementos químicos e isótopos físseis (cindíveis) ou férteis), e seus compostos; misturas e resíduos que contenham esses produtos."}},{"id":"SH4:2845","tipo":"SH4","props":{"codigo":"2845","descricao":"Isótopos não incluídos na posição 28.44; seus compostos, inorgânicos ou orgânicos, de constituição química definida ou não."}},{"id":"SH4:2846","tipo":"SH4","props":{"codigo":"2846","descricao":"Compostos, inorgânicos ou orgânicos, dos metais das terras raras, de ítrio ou de escândio ou das misturas destes metais."}},{"id":"SH4:2847","tipo":"SH4","props":{"codigo":"2847","descricao":null}},{"id":"SH4:2849","tipo":"SH4","props":{"codigo":"2849","descricao":"Carbonetos de constituição química definida ou não."}},{"id":"SH4:2850","tipo":"SH4","props":{"codigo":"2850","descricao":null}},{"id":"SH4:2852","tipo":"SH4","props":{"codigo":"2852","descricao":"Compostos, inorgânicos ou orgânicos, de mercúrio, de constituição química definida ou não, exceto as amálgamas."}},{"id":"SH4:2853","tipo":"SH4","props":{"codigo":"2853","descricao":"Fosfetos, de constituição química definida ou não, exceto ferrofósforos; outros compostos inorgânicos (incluindo as águas destiladas ou de condutibilidade e águas de igual grau de pureza); ar líquido (incluindo o ar líquido cujos gases raros foram eliminados); ar comprimido; amálgamas, exceto de metais preciosos."}},{"id":"SH4:2901","tipo":"SH4","props":{"codigo":"2901","descricao":"Hidrocarbonetos acíclicos."}},{"id":"SH4:2902","tipo":"SH4","props":{"codigo":"2902","descricao":"Hidrocarbonetos cíclicos."}},{"id":"SH4:2903","tipo":"SH4","props":{"codigo":"2903","descricao":"Derivados halogenados dos hidrocarbonetos."}},{"id":"SH4:2904","tipo":"SH4","props":{"codigo":"2904","descricao":"Derivados sulfonados, nitrados ou nitrosados dos hidrocarbonetos, mesmo halogenados."}},{"id":"SH4:2905","tipo":"SH4","props":{"codigo":"2905","descricao":"Álcoois acíclicos e seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2906","tipo":"SH4","props":{"codigo":"2906","descricao":"Álcoois cíclicos e seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2907","tipo":"SH4","props":{"codigo":"2907","descricao":"Fenóis; fenóis-álcoois."}},{"id":"SH4:2908","tipo":"SH4","props":{"codigo":"2908","descricao":"Derivados halogenados, sulfonados, nitrados ou nitrosados dos fenóis ou dos fenóis-álcoois."}},{"id":"SH4:2909","tipo":"SH4","props":{"codigo":"2909","descricao":"Éteres, éteres-álcoois, éteres-fenóis, éteres-álcoois-fenóis, peróxidos de álcoois, peróxidos de éteres, peróxidos de acetais e de hemiacetais, peróxidos de cetonas (de constituição química definida ou não), e seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2910","tipo":"SH4","props":{"codigo":"2910","descricao":"Epóxidos, epoxiálcoois, epoxifenóis e epoxiéteres, com três átomos no ciclo, e seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2911","tipo":"SH4","props":{"codigo":"2911","descricao":null}},{"id":"SH4:2912","tipo":"SH4","props":{"codigo":"2912","descricao":"Aldeídos, mesmo que contenham outras funções oxigenadas; polímeros cíclicos dos aldeídos; paraformaldeído."}},{"id":"SH4:2913","tipo":"SH4","props":{"codigo":"2913","descricao":null}},{"id":"SH4:2914","tipo":"SH4","props":{"codigo":"2914","descricao":"Cetonas e quinonas, mesmo que contenham outras funções oxigenadas, e seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2915","tipo":"SH4","props":{"codigo":"2915","descricao":"Ácidos monocarboxílicos acíclicos saturados e seus anidridos, halogenetos, peróxidos e peroxiácidos; seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2916","tipo":"SH4","props":{"codigo":"2916","descricao":"Ácidos monocarboxílicos acíclicos não saturados e ácidos monocarboxílicos cíclicos, seus anidridos, halogenetos, peróxidos e peroxiácidos; seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2917","tipo":"SH4","props":{"codigo":"2917","descricao":"Ácidos policarboxílicos, seus anidridos, halogenetos, peróxidos e peroxiácidos; seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2918","tipo":"SH4","props":{"codigo":"2918","descricao":"Ácidos carboxílicos que contenham funções oxigenadas suplementares e seus anidridos, halogenetos, peróxidos e peroxiácidos; seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2919","tipo":"SH4","props":{"codigo":"2919","descricao":"Ésteres fosfóricos e seus sais, incluindo os lactofosfatos; seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2920","tipo":"SH4","props":{"codigo":"2920","descricao":"Ésteres dos outros ácidos inorgânicos de não metais (exceto os ésteres de halogenetos de hidrogênio) e seus sais; seus derivados halogenados, sulfonados, nitrados ou nitrosados."}},{"id":"SH4:2921","tipo":"SH4","props":{"codigo":"2921","descricao":"Compostos de função amina."}},{"id":"SH4:2922","tipo":"SH4","props":{"codigo":"2922","descricao":"Compostos aminados de funções oxigenadas."}},{"id":"SH4:2923","tipo":"SH4","props":{"codigo":"2923","descricao":"Sais e hidróxidos de amônio quaternários; lecitinas e outros fosfoaminolipídios, de constituição química definida ou não."}},{"id":"SH4:2924","tipo":"SH4","props":{"codigo":"2924","descricao":"Compostos de função carboxiamida; compostos de função amida do ácido carbônico."}},{"id":"SH4:2925","tipo":"SH4","props":{"codigo":"2925","descricao":"Compostos de função carboxiimida (incluindo a sacarina e seus sais) ou de função imina."}},{"id":"SH4:2926","tipo":"SH4","props":{"codigo":"2926","descricao":"Compostos de função nitrila."}},{"id":"SH4:2927","tipo":"SH4","props":{"codigo":"2927","descricao":null}},{"id":"SH4:2928","tipo":"SH4","props":{"codigo":"2928","descricao":null}},{"id":"SH4:2929","tipo":"SH4","props":{"codigo":"2929","descricao":"Compostos de outras funções nitrogenadas (azotadas)."}},{"id":"SH4:2930","tipo":"SH4","props":{"codigo":"2930","descricao":"Tiocompostos orgânicos."}},{"id":"SH4:2931","tipo":"SH4","props":{"codigo":"2931","descricao":"Outros compostos organo-inorgânicos."}},{"id":"SH4:2932","tipo":"SH4","props":{"codigo":"2932","descricao":"Compostos heterocíclicos exclusivamente de heteroátomo(s) de oxigênio."}},{"id":"SH4:2933","tipo":"SH4","props":{"codigo":"2933","descricao":"Compostos heterocíclicos exclusivamente de heteroátomo(s) de nitrogênio (azoto)."}},{"id":"SH4:2934","tipo":"SH4","props":{"codigo":"2934","descricao":"Ácidos nucleicos e seus sais, de constituição química definida ou não; outros compostos heterocíclicos."}},{"id":"SH4:2935","tipo":"SH4","props":{"codigo":"2935","descricao":"Sulfonamidas."}},{"id":"SH4:2936","tipo":"SH4","props":{"codigo":"2936","descricao":"Provitaminas e vitaminas, naturais ou reproduzidas por síntese (incluindo os concentrados naturais), bem como os seus derivados utilizados principalmente como vitaminas, misturados ou não entre si, mesmo em quaisquer soluções."}},{"id":"SH4:2937","tipo":"SH4","props":{"codigo":"2937","descricao":"Hormônios, prostaglandinas, tromboxanas e leucotrienos, naturais ou reproduzidos por síntese; seus derivados e análogos estruturais, incluindo os polipeptídios de cadeia modificada, utilizados principalmente como hormônios."}},{"id":"SH4:2938","tipo":"SH4","props":{"codigo":"2938","descricao":"Heterosídeos, naturais ou reproduzidos por síntese, seus sais, éteres, ésteres e outros derivados."}},{"id":"SH4:2939","tipo":"SH4","props":{"codigo":"2939","descricao":"Alcaloides, naturais ou reproduzidos por síntese, seus sais, éteres, ésteres e outros derivados."}},{"id":"SH4:2940","tipo":"SH4","props":{"codigo":"2940","descricao":null}},{"id":"SH4:2941","tipo":"SH4","props":{"codigo":"2941","descricao":"Antibióticos."}},{"id":"SH4:2942","tipo":"SH4","props":{"codigo":"2942","descricao":null}},{"id":"SH4:3001","tipo":"SH4","props":{"codigo":"3001","descricao":"Glândulas e outros órgãos para usos opoterápicos, dessecados, mesmo em pó; extratos de glândulas ou de outros órgãos ou das suas secreções, para usos opoterápicos; heparina e seus sais; outras substâncias humanas ou animais preparadas para fins terapêuticos ou profiláticos, não especificadas nem compreendidas noutras posições."}},{"id":"SH4:3002","tipo":"SH4","props":{"codigo":"3002","descricao":"Sangue humano; sangue animal preparado para usos terapêuticos, profiláticos ou de diagnóstico; antissoros, outras frações do sangue e produtos imunológicos, mesmo modificados ou obtidos por via biotecnológica; vacinas, toxinas, culturas de microrganismos (exceto leveduras) e produtos semelhantes; culturas de células, mesmo modificadas."}},{"id":"SH4:3003","tipo":"SH4","props":{"codigo":"3003","descricao":"Medicamentos (exceto os produtos das posições 30.02, 30.05 ou 30.06) constituídos por produtos misturados entre si, preparados para fins terapêuticos ou profiláticos, mas não apresentados em doses nem acondicionados para venda a retalho."}},{"id":"SH4:3004","tipo":"SH4","props":{"codigo":"3004","descricao":"Medicamentos (exceto os produtos das posições 30.02, 30.05 ou 30.06) constituídos por produtos misturados ou não misturados, preparados para fins terapêuticos ou profiláticos, apresentados em doses (incluindo os destinados a serem administrados por via percutânea) ou acondicionados para venda a retalho."}},{"id":"SH4:3005","tipo":"SH4","props":{"codigo":"3005","descricao":"Pastas (<i>ouates</i>), gazes, ataduras (ligaduras) e artigos análogos (por exemplo, curativos (pensos), esparadrapos, sinapismos), impregnados ou recobertos de substâncias farmacêuticas ou acondicionados para venda a retalho para usos medicinais, cirúrgicos, odontológicos ou veterinários."}},{"id":"SH4:3006","tipo":"SH4","props":{"codigo":"3006","descricao":"Preparações e artigos farmacêuticos indicados na Nota 4 deste Capítulo."}},{"id":"SH4:3101","tipo":"SH4","props":{"codigo":"3101","descricao":null}},{"id":"SH4:3102","tipo":"SH4","props":{"codigo":"3102","descricao":"Adubos (fertilizantes) minerais ou químicos, nitrogenados (azotados)."}},{"id":"SH4:3103","tipo":"SH4","props":{"codigo":"3103","descricao":"Adubos (fertilizantes) minerais ou químicos, fosfatados."}},{"id":"SH4:3104","tipo":"SH4","props":{"codigo":"3104","descricao":"Adubos (fertilizantes) minerais ou químicos, potássicos."}},{"id":"SH4:3105","tipo":"SH4","props":{"codigo":"3105","descricao":"Adubos (fertilizantes) minerais ou químicos, que contenham dois ou três dos seguintes elementos fertilizantes: nitrogênio (azoto), fósforo e potássio; outros adubos (fertilizantes); produtos do presente Capítulo apresentados em tabletes ou formas semelhantes, ou ainda em embalagens de peso bruto não superior a 10 kg."}},{"id":"SH4:3201","tipo":"SH4","props":{"codigo":"3201","descricao":"Extratos tanantes de origem vegetal; taninos e seus sais, éteres, ésteres e outros derivados."}},{"id":"SH4:3202","tipo":"SH4","props":{"codigo":"3202","descricao":"Produtos tanantes orgânicos sintéticos; produtos tanantes inorgânicos; preparações tanantes, mesmo que contenham produtos tanantes naturais; preparações enzimáticas para a pré-curtimenta."}},{"id":"SH4:3203","tipo":"SH4","props":{"codigo":"3203","descricao":null}},{"id":"SH4:3204","tipo":"SH4","props":{"codigo":"3204","descricao":"Matérias corantes orgânicas sintéticas, mesmo de constituição química definida; preparações indicadas na Nota 3 do presente Capítulo, à base de matérias corantes orgânicas sintéticas; produtos orgânicos sintéticos do tipo utilizado como agentes de avivamento fluorescentes ou como luminóforos, mesmo de constituição química definida."}},{"id":"SH4:3205","tipo":"SH4","props":{"codigo":"3205","descricao":null}},{"id":"SH4:3206","tipo":"SH4","props":{"codigo":"3206","descricao":"Outras matérias corantes; preparações indicadas na Nota 3 do presente Capítulo, exceto das posições 32.03, 32.04 ou 32.05; produtos inorgânicos do tipo utilizado como luminóforos, mesmo de constituição química definida."}},{"id":"SH4:3207","tipo":"SH4","props":{"codigo":"3207","descricao":"Pigmentos, opacificantes e cores preparados, composições vitrificáveis, engobos, polimentos (esmaltes metálicos*) líquidos e preparações semelhantes, do tipo utilizado nas indústrias da cerâmica, do esmalte e do vidro; fritas de vidro e outros vidros, em pó, em grânulos, em lamelas ou em flocos."}},{"id":"SH4:3208","tipo":"SH4","props":{"codigo":"3208","descricao":"Tintas e vernizes, à base de polímeros sintéticos ou de polímeros naturais modificados, dispersos ou dissolvidos em meio não aquoso; soluções definidas na Nota 4 do presente Capítulo."}},{"id":"SH4:3209","tipo":"SH4","props":{"codigo":"3209","descricao":"Tintas e vernizes, à base de polímeros sintéticos ou de polímeros naturais modificados, dispersos ou dissolvidos num meio aquoso."}},{"id":"SH4:3210","tipo":"SH4","props":{"codigo":"3210","descricao":null}},{"id":"SH4:3211","tipo":"SH4","props":{"codigo":"3211","descricao":null}},{"id":"SH4:3212","tipo":"SH4","props":{"codigo":"3212","descricao":"Pigmentos (incluindo os pós e flocos metálicos) dispersos em meios não aquosos, no estado líquido ou pastoso, do tipo utilizado na fabricação de tintas; folhas para marcar a ferro; tinturas e outras matérias corantes apresentadas em formas ou embalagens para venda a retalho."}},{"id":"SH4:3213","tipo":"SH4","props":{"codigo":"3213","descricao":"Cores para pintura artística, atividades educativas, pintura de tabuletas, modificação de tonalidades, recreação e cores semelhantes, em pastilhas, tubos, potes, frascos, godês ou acondicionamentos semelhantes."}},{"id":"SH4:3214","tipo":"SH4","props":{"codigo":"3214","descricao":"Mástique de vidraceiro, cimentos de resina e outras mástiques; indutos utilizados em pintura; indutos não refratários do tipo utilizado em alvenaria."}},{"id":"SH4:3215","tipo":"SH4","props":{"codigo":"3215","descricao":"Tintas de impressão, tintas de escrever ou de desenhar e outras tintas, mesmo concentradas ou no estado sólido."}},{"id":"SH4:3301","tipo":"SH4","props":{"codigo":"3301","descricao":"Óleos essenciais (desterpenados ou não), incluindo os denominados \"concretos\" ou \"absolutos\"; resinoides; oleorresinas de extração; soluções concentradas de óleos essenciais em gorduras, em óleos fixos, em ceras ou em matérias análogas, obtidas por tratamento de flores através de substâncias gordas ou por maceração; subprodutos terpênicos residuais da desterpenação dos óleos essenciais; águas destiladas aromáticas e soluções aquosas de óleos essenciais."}},{"id":"SH4:3302","tipo":"SH4","props":{"codigo":"3302","descricao":"Misturas de substâncias odoríferas e misturas (incluindo as soluções alcoólicas) à base de uma ou mais destas substâncias, do tipo utilizado como matérias básicas para a indústria; outras preparações à base de substâncias odoríferas, do tipo utilizado para fabricação de bebidas."}},{"id":"SH4:3303","tipo":"SH4","props":{"codigo":"3303","descricao":null}},{"id":"SH4:3304","tipo":"SH4","props":{"codigo":"3304","descricao":"Produtos de beleza ou de maquiagem preparados e preparações para conservação ou cuidados da pele (exceto medicamentos), incluindo as preparações antissolares e os bronzeadores; preparações para manicuros e pedicuros."}},{"id":"SH4:3305","tipo":"SH4","props":{"codigo":"3305","descricao":"Preparações capilares."}},{"id":"SH4:3306","tipo":"SH4","props":{"codigo":"3306","descricao":"Preparações para higiene bucal ou dentária, incluindo os pós e cremes para facilitar a aderência de dentaduras; fios utilizados para limpar os espaços interdentais (fios dentais), em embalagens individuais para venda a retalho."}},{"id":"SH4:3307","tipo":"SH4","props":{"codigo":"3307","descricao":"Preparações para barbear (antes, durante ou após), desodorantes (desodorizantes) corporais, preparações para banhos, depilatórios, outros produtos de perfumaria ou de toucador preparados e outras preparações cosméticas, não especificados nem compreendidos noutras posições; desodorantes (desodorizantes) de ambiente, preparados, mesmo não perfumados, mesmo com propriedades desinfetantes."}},{"id":"SH4:3401","tipo":"SH4","props":{"codigo":"3401","descricao":"Sabões; produtos e preparações orgânicos tensoativos utilizados como sabão, em barras, pães, pedaços ou figuras moldadas, mesmo que contenham sabão; produtos e preparações orgânicos tensoativos para lavagem da pele, sob a forma de líquido ou de creme, acondicionados para venda a retalho, mesmo que contenham sabão; papel, pastas (<i>ouates</i>), feltros e falsos tecidos (tecidos não tecidos), impregnados, revestidos ou recobertos de sabão ou de detergentes."}},{"id":"SH4:3402","tipo":"SH4","props":{"codigo":"3402","descricao":"Agentes orgânicos de superfície (exceto sabões); preparações tensoativas, preparações para lavagem (incluindo as preparações auxiliares para lavagem) e preparações para limpeza, mesmo que contenham sabão, exceto as da posição 34.01."}},{"id":"SH4:3403","tipo":"SH4","props":{"codigo":"3403","descricao":"Preparações lubrificantes (incluindo os óleos de corte, as preparações antiaderentes de porcas e parafusos, as preparações antiferrugem ou anticorrosão e as preparações para desmoldagem, à base de lubrificantes) e preparações do tipo utilizado para lubrificar e amaciar matérias têxteis, para untar couros, peles com pelo e outras matérias, exceto as que contenham, como constituintes de base, 70 % ou mais, em peso, de óleos de petróleo ou de minerais betuminosos."}},{"id":"SH4:3404","tipo":"SH4","props":{"codigo":"3404","descricao":"Ceras artificiais e ceras preparadas."}},{"id":"SH4:3405","tipo":"SH4","props":{"codigo":"3405","descricao":"Pomadas e cremes para calçado, encáusticas, preparações para dar brilho a pinturas de carroçarias, vidros ou metais, pastas e pós para arear e preparações semelhantes (mesmo apresentados em papel, pastas (<i>ouates</i>), feltros, falsos tecidos (tecidos não tecidos), plástico alveolar ou borracha alveolar, impregnados, revestidos ou recobertos daquelas preparações), com exclusão das ceras da posição 34.04."}},{"id":"SH4:3406","tipo":"SH4","props":{"codigo":"3406","descricao":null}},{"id":"SH4:3407","tipo":"SH4","props":{"codigo":"3407","descricao":null}},{"id":"SH4:3501","tipo":"SH4","props":{"codigo":"3501","descricao":"Caseínas, caseinatos e outros derivados das caseínas; colas de caseína."}},{"id":"SH4:3502","tipo":"SH4","props":{"codigo":"3502","descricao":"Albuminas (incluindo os concentrados de várias proteínas de soro de leite, que contenham, em peso, calculado sobre a matéria seca, mais de 80 % de proteínas de soro de leite), albuminatos e outros derivados das albuminas."}},{"id":"SH4:3503","tipo":"SH4","props":{"codigo":"3503","descricao":null}},{"id":"SH4:3504","tipo":"SH4","props":{"codigo":"3504","descricao":null}},{"id":"SH4:3505","tipo":"SH4","props":{"codigo":"3505","descricao":"Dextrina e outros amidos e féculas modificados (por exemplo, amidos e féculas pré-gelatinizados ou esterificados); colas à base de amidos ou de féculas, de dextrina ou de outros amidos ou féculas modificados."}},{"id":"SH4:3506","tipo":"SH4","props":{"codigo":"3506","descricao":"Colas e outros adesivos preparados, não especificados nem compreendidos noutras posições; produtos de qualquer espécie utilizados como colas ou adesivos, acondicionados para venda a retalho como colas ou adesivos, de peso líquido não superior a 1 kg."}},{"id":"SH4:3507","tipo":"SH4","props":{"codigo":"3507","descricao":"Enzimas; enzimas preparadas não especificadas nem compreendidas noutras posições."}},{"id":"SH4:3601","tipo":"SH4","props":{"codigo":"3601","descricao":null}},{"id":"SH4:3602","tipo":"SH4","props":{"codigo":"3602","descricao":null}},{"id":"SH4:3603","tipo":"SH4","props":{"codigo":"3603","descricao":"Estopins e rastilhos, de segurança; cordéis (cordões) detonantes; escorvas e cápsulas fulminantes; inflamadores; detonadores elétricos."}},{"id":"SH4:3604","tipo":"SH4","props":{"codigo":"3604","descricao":"Fogos de artifício, foguetes de sinalização ou contra o granizo e semelhantes, bombas, petardos e outros artigos de pirotecnia."}},{"id":"SH4:3605","tipo":"SH4","props":{"codigo":"3605","descricao":null}},{"id":"SH4:3606","tipo":"SH4","props":{"codigo":"3606","descricao":"Ferrocério e outras ligas pirofóricas, sob quaisquer formas; artigos de matérias inflamáveis indicados na Nota 2 do presente Capítulo."}},{"id":"SH4:3701","tipo":"SH4","props":{"codigo":"3701","descricao":"Chapas e filmes planos, fotográficos, sensibilizados, não impressionados, de matérias diferentes do papel, cartão ou dos têxteis; filmes fotográficos planos, de revelação e cópia instantâneas, sensibilizados, não impressionados, mesmo em cartuchos."}},{"id":"SH4:3702","tipo":"SH4","props":{"codigo":"3702","descricao":"Filmes fotográficos sensibilizados, não impressionados, em rolos, de matérias diferentes do papel, cartão ou dos têxteis; filmes fotográficos de revelação e cópia instantâneas, em rolos, sensibilizados, não impressionados."}},{"id":"SH4:3703","tipo":"SH4","props":{"codigo":"3703","descricao":"Papéis, cartões e têxteis, fotográficos, sensibilizados, não impressionados."}},{"id":"SH4:3704","tipo":"SH4","props":{"codigo":"3704","descricao":null}},{"id":"SH4:3705","tipo":"SH4","props":{"codigo":"3705","descricao":null}},{"id":"SH4:3706","tipo":"SH4","props":{"codigo":"3706","descricao":"Filmes cinematográficos impressionados e revelados, que contenham ou não gravação de som ou que contenham apenas gravação de som."}},{"id":"SH4:3707","tipo":"SH4","props":{"codigo":"3707","descricao":"Preparações químicas para usos fotográficos, exceto vernizes, colas, adesivos e preparações semelhantes; produtos não misturados, quer doseados tendo em vista usos fotográficos, quer acondicionados para venda a retalho para esses mesmos usos e prontos para utilização."}},{"id":"SH4:3801","tipo":"SH4","props":{"codigo":"3801","descricao":"Grafita artificial; grafita coloidal ou semicoloidal; preparações à base de grafita ou de outros carbonos, em pastas, blocos, plaquetas ou outros produtos intermediários."}},{"id":"SH4:3802","tipo":"SH4","props":{"codigo":"3802","descricao":"Carvões ativados; matérias minerais naturais ativadas; negros de origem animal, incluindo o negro animal esgotado."}},{"id":"SH4:3803","tipo":"SH4","props":{"codigo":"3803","descricao":null}},{"id":"SH4:3804","tipo":"SH4","props":{"codigo":"3804","descricao":null}},{"id":"SH4:3805","tipo":"SH4","props":{"codigo":"3805","descricao":"Essências de terebintina, de pinheiro ou provenientes da fabricação da pasta de papel ao sulfato e outras essências terpênicas provenientes da destilação ou de outros tratamentos das madeiras de coníferas; dipenteno em bruto; essência proveniente da fabricação da pasta de papel ao bissulfito e outros paracimenos em bruto; óleo de pinho que contenha alfa-terpineol como constituinte principal."}},{"id":"SH4:3806","tipo":"SH4","props":{"codigo":"3806","descricao":"Colofônias e ácidos resínicos, e seus derivados; essência de colofônia e óleos de colofônia; gomas fundidas."}},{"id":"SH4:3807","tipo":"SH4","props":{"codigo":"3807","descricao":null}},{"id":"SH4:3808","tipo":"SH4","props":{"codigo":"3808","descricao":"Inseticidas, rodenticidas, fungicidas, herbicidas, inibidores de germinação e reguladores de crescimento para plantas, desinfetantes e produtos semelhantes, apresentados em formas ou embalagens para venda a retalho ou como preparações ou ainda sob a forma de artigos, tais como fitas, mechas e velas sulfuradas e papel mata-moscas."}},{"id":"SH4:3809","tipo":"SH4","props":{"codigo":"3809","descricao":"Agentes de apresto ou de acabamento, aceleradores de tingimento ou de fixação de matérias corantes e outros produtos e preparações (por exemplo, aprestos preparados e preparações mordentes) do tipo utilizado na indústria têxtil, na indústria do papel, na indústria do couro ou em indústrias semelhantes, não especificados nem compreendidos noutras posições."}},{"id":"SH4:3810","tipo":"SH4","props":{"codigo":"3810","descricao":"Preparações para decapagem de metais; fluxos para soldar e outras preparações auxiliares para soldar metais; pastas e pós para soldar, compostos de metal e de outras matérias; preparações do tipo utilizado para enchimento ou revestimento de eletrodos ou de varetas para soldar."}},{"id":"SH4:3811","tipo":"SH4","props":{"codigo":"3811","descricao":"Preparações antidetonantes, inibidores de oxidação, aditivos peptizantes, beneficiadores de viscosidade, aditivos anticorrosivos e outros aditivos preparados, para óleos minerais (incluindo a gasolina) ou para outros líquidos utilizados para os mesmos fins que os óleos minerais."}},{"id":"SH4:3812","tipo":"SH4","props":{"codigo":"3812","descricao":"Preparações denominadas \"aceleradores de vulcanização\"; plastificantes compostos para borracha ou plástico, não especificados nem compreendidos noutras posições; preparações antioxidantes e outros estabilizadores compostos, para borracha ou plástico."}},{"id":"SH4:3813","tipo":"SH4","props":{"codigo":"3813","descricao":null}},{"id":"SH4:3814","tipo":"SH4","props":{"codigo":"3814","descricao":null}},{"id":"SH4:3815","tipo":"SH4","props":{"codigo":"3815","descricao":"Iniciadores de reação, aceleradores de reação e preparações catalíticas, não especificados nem compreendidos noutras posições."}},{"id":"SH4:3816","tipo":"SH4","props":{"codigo":"3816","descricao":null}},{"id":"SH4:3817","tipo":"SH4","props":{"codigo":"3817","descricao":null}},{"id":"SH4:3818","tipo":"SH4","props":{"codigo":"3818","descricao":null}},{"id":"SH4:3819","tipo":"SH4","props":{"codigo":"3819","descricao":null}},{"id":"SH4:3820","tipo":"SH4","props":{"codigo":"3820","descricao":null}},{"id":"SH4:3821","tipo":"SH4","props":{"codigo":"3821","descricao":null}},{"id":"SH4:3822","tipo":"SH4","props":{"codigo":"3822","descricao":"Reagentes de diagnóstico ou de laboratório em qualquer suporte e reagentes de diagnóstico ou de laboratório preparados, mesmo num suporte, mesmo apresentados sob a forma de estojos, exceto os da posição 30.06; materiais de referência certificados."}},{"id":"SH4:3823","tipo":"SH4","props":{"codigo":"3823","descricao":"Ácidos graxos (gordos) monocarboxílicos industriais; óleos ácidos de refinação; álcoois graxos (gordos) industriais."}},{"id":"SH4:3824","tipo":"SH4","props":{"codigo":"3824","descricao":"Aglutinantes preparados para moldes ou para núcleos de fundição; produtos químicos e preparações das indústrias químicas ou das indústrias conexas (incluindo os constituídos por misturas de produtos naturais), não especificados nem compreendidos noutras posições."}},{"id":"SH4:3825","tipo":"SH4","props":{"codigo":"3825","descricao":"Produtos residuais das indústrias químicas ou das indústrias conexas, não especificados nem compreendidos noutras posições; resíduos municipais; lamas de tratamento de esgotos (lamas de depuração*); outros resíduos mencionados na Nota 6 deste Capítulo."}},{"id":"SH4:3826","tipo":"SH4","props":{"codigo":"3826","descricao":null}},{"id":"SH4:3827","tipo":"SH4","props":{"codigo":"3827","descricao":"Misturas que contenham derivados halogenados do metano, do etano ou do propano, não especificadas nem compreendidas noutras posições."}},{"id":"SH4:3901","tipo":"SH4","props":{"codigo":"3901","descricao":"Polímeros de etileno, em formas primárias."}},{"id":"SH4:3902","tipo":"SH4","props":{"codigo":"3902","descricao":"Polímeros de propileno ou de outras olefinas, em formas primárias."}},{"id":"SH4:3903","tipo":"SH4","props":{"codigo":"3903","descricao":"Polímeros de estireno, em formas primárias."}},{"id":"SH4:3904","tipo":"SH4","props":{"codigo":"3904","descricao":"Polímeros de cloreto de vinila ou de outras olefinas halogenadas, em formas primárias."}},{"id":"SH4:3905","tipo":"SH4","props":{"codigo":"3905","descricao":"Polímeros de acetato de vinila ou de outros ésteres de vinila, em formas primárias; outros polímeros de vinila, em formas primárias."}},{"id":"SH4:3906","tipo":"SH4","props":{"codigo":"3906","descricao":"Polímeros acrílicos, em formas primárias."}},{"id":"SH4:3907","tipo":"SH4","props":{"codigo":"3907","descricao":"Poliacetais, outros poliéteres e resinas epóxidas, em formas primárias; policarbonatos, resinas alquídicas, poliésteres alílicos e outros poliésteres, em formas primárias."}},{"id":"SH4:3908","tipo":"SH4","props":{"codigo":"3908","descricao":"Poliamidas em formas primárias."}},{"id":"SH4:3909","tipo":"SH4","props":{"codigo":"3909","descricao":"Resinas amínicas, resinas fenólicas e poliuretanos, em formas primárias."}},{"id":"SH4:3910","tipo":"SH4","props":{"codigo":"3910","descricao":null}},{"id":"SH4:3911","tipo":"SH4","props":{"codigo":"3911","descricao":"Resinas de petróleo, resinas de cumarona-indeno, politerpenos, polissulfetos, polissulfonas e outros produtos mencionados na Nota 3 do presente Capítulo, não especificados nem compreendidos noutras posições, em formas primárias."}},{"id":"SH4:3912","tipo":"SH4","props":{"codigo":"3912","descricao":"Celulose e seus derivados químicos, não especificados nem compreendidos noutras posições, em formas primárias."}},{"id":"SH4:3913","tipo":"SH4","props":{"codigo":"3913","descricao":"Polímeros naturais (ácido algínico, por exemplo) e polímeros naturais modificados (por exemplo, proteínas endurecidas, derivados químicos da borracha natural), não especificados nem compreendidos noutras posições, em formas primárias."}},{"id":"SH4:3914","tipo":"SH4","props":{"codigo":"3914","descricao":null}},{"id":"SH4:3915","tipo":"SH4","props":{"codigo":"3915","descricao":"Desperdícios, resíduos e aparas, de plástico."}},{"id":"SH4:3916","tipo":"SH4","props":{"codigo":"3916","descricao":"Monofilamentos cuja maior dimensão da seção transversal seja superior a 1 mm (monofios), varas, bastões e perfis, mesmo trabalhados à superfície, mas não trabalhados de outro modo, de plástico."}},{"id":"SH4:3917","tipo":"SH4","props":{"codigo":"3917","descricao":"Tubos e seus acessórios (por exemplo, juntas, cotovelos, flanges, uniões), de plástico."}},{"id":"SH4:3918","tipo":"SH4","props":{"codigo":"3918","descricao":"Revestimentos para pisos (pavimentos), de plástico, mesmo autoadesivos, em rolos ou em forma de ladrilhos ou de placas (lajes); revestimentos para paredes ou para tetos, de plástico, definidos na Nota 9 do presente Capítulo."}},{"id":"SH4:3919","tipo":"SH4","props":{"codigo":"3919","descricao":"Chapas, folhas, tiras, fitas, películas e outras formas planas, autoadesivas, de plástico, mesmo em rolos."}},{"id":"SH4:3920","tipo":"SH4","props":{"codigo":"3920","descricao":"Outras chapas, folhas, películas, tiras e lâminas, de plástico não alveolar, não reforçadas nem estratificadas, sem suporte, nem associadas de forma semelhante a outras matérias."}},{"id":"SH4:3921","tipo":"SH4","props":{"codigo":"3921","descricao":"Outras chapas, folhas, películas, tiras e lâminas, de plástico."}},{"id":"SH4:3922","tipo":"SH4","props":{"codigo":"3922","descricao":"Banheiras, boxes para chuveiros (polibãs*), pias, lavatórios, bidés, sanitários e seus assentos e tampas, caixas de descarga (autoclismos*) e artigos semelhantes para usos sanitários ou higiênicos, de plástico."}},{"id":"SH4:3923","tipo":"SH4","props":{"codigo":"3923","descricao":"Artigos de transporte ou de embalagem, de plástico; rolhas, tampas, cápsulas e outros dispositivos para fechar recipientes, de plástico."}},{"id":"SH4:3924","tipo":"SH4","props":{"codigo":"3924","descricao":"Serviços de mesa, artigos de cozinha, outros artigos de uso doméstico e artigos de higiene ou de toucador, de plástico."}},{"id":"SH4:3925","tipo":"SH4","props":{"codigo":"3925","descricao":"Artigos para apetrechamento de construções, de plástico, não especificados nem compreendidos noutras posições."}},{"id":"SH4:3926","tipo":"SH4","props":{"codigo":"3926","descricao":"Outras obras de plástico e obras de outras matérias das posições 39.01 a 39.14."}},{"id":"SH4:4001","tipo":"SH4","props":{"codigo":"4001","descricao":"Borracha natural, balata, guta-percha, guaiúle, chicle e gomas naturais análogas, em formas primárias ou em chapas, folhas ou tiras."}},{"id":"SH4:4002","tipo":"SH4","props":{"codigo":"4002","descricao":"Borracha sintética e borracha artificial derivada dos óleos, em formas primárias ou em chapas, folhas ou tiras; misturas dos produtos da posição 40.01 com produtos da presente posição, em formas primárias ou em chapas, folhas ou tiras."}},{"id":"SH4:4003","tipo":"SH4","props":{"codigo":"4003","descricao":null}},{"id":"SH4:4004","tipo":"SH4","props":{"codigo":"4004","descricao":null}},{"id":"SH4:4005","tipo":"SH4","props":{"codigo":"4005","descricao":"Borracha misturada, não vulcanizada, em formas primárias ou em chapas, folhas ou tiras."}},{"id":"SH4:4006","tipo":"SH4","props":{"codigo":"4006","descricao":"Outras formas (por exemplo, varetas, tubos, perfis) e artigos (por exemplo, discos, arruelas (anilhas)), de borracha não vulcanizada."}},{"id":"SH4:4007","tipo":"SH4","props":{"codigo":"4007","descricao":null}},{"id":"SH4:4008","tipo":"SH4","props":{"codigo":"4008","descricao":"Chapas, folhas, tiras, varetas e perfis, de borracha vulcanizada não endurecida."}},{"id":"SH4:4009","tipo":"SH4","props":{"codigo":"4009","descricao":"Tubos de borracha vulcanizada não endurecida, mesmo providos dos respectivos acessórios (por exemplo, juntas, cotovelos, flanges, uniões)."}},{"id":"SH4:4010","tipo":"SH4","props":{"codigo":"4010","descricao":"Correias transportadoras ou de transmissão, de borracha vulcanizada."}},{"id":"SH4:4011","tipo":"SH4","props":{"codigo":"4011","descricao":"Pneumáticos novos, de borracha."}},{"id":"SH4:4012","tipo":"SH4","props":{"codigo":"4012","descricao":"Pneumáticos recauchutados ou usados, de borracha; pneus maciços ou ocos, bandas de rodagem para pneumáticos e <i>flaps</i>, de borracha."}},{"id":"SH4:4013","tipo":"SH4","props":{"codigo":"4013","descricao":"Câmaras de ar de borracha."}},{"id":"SH4:4014","tipo":"SH4","props":{"codigo":"4014","descricao":"Artigos de higiene ou de farmácia (incluindo os bicos (tetinas) para mamadeiras (biberões)), de borracha vulcanizada não endurecida, mesmo com partes de borracha endurecida."}},{"id":"SH4:4015","tipo":"SH4","props":{"codigo":"4015","descricao":"Vestuário e seus acessórios (incluindo as luvas, mitenes e semelhantes), de borracha vulcanizada não endurecida, para quaisquer usos."}},{"id":"SH4:4016","tipo":"SH4","props":{"codigo":"4016","descricao":"Outras obras de borracha vulcanizada não endurecida."}},{"id":"SH4:4017","tipo":"SH4","props":{"codigo":"4017","descricao":null}},{"id":"SH4:4101","tipo":"SH4","props":{"codigo":"4101","descricao":"Couros e peles em bruto de bovinos (incluindo os búfalos) ou de equídeos (frescos ou salgados, secos, tratados pela cal, piquelados ou conservados de outro modo, mas não curtidos, nem apergaminhados, nem preparados de outro modo), mesmo depilados ou divididos."}},{"id":"SH4:4102","tipo":"SH4","props":{"codigo":"4102","descricao":"Peles em bruto de ovinos (frescas ou salgadas, secas, tratadas pela cal, piqueladas ou conservadas de outro modo, mas não curtidas, nem apergaminhadas, nem preparadas de outro modo), mesmo depiladas ou divididas, com exceção das excluídas pela Nota 1 c) do presente Capítulo."}},{"id":"SH4:4103","tipo":"SH4","props":{"codigo":"4103","descricao":"Outros couros e peles em bruto (frescos ou salgados, secos, tratados pela cal, piquelados ou conservados de outro modo, mas não curtidos, nem apergaminhados, nem preparados de outro modo), mesmo depilados ou divididos, com exceção dos excluídos pelas Notas 1 b) ou 1 c) do presente Capítulo."}},{"id":"SH4:4104","tipo":"SH4","props":{"codigo":"4104","descricao":"Couros e peles curtidos ou <i>crust</i>, de bovinos (incluindo os búfalos) ou de equídeos, depilados, mesmo divididos, mas não preparados de outro modo."}},{"id":"SH4:4105","tipo":"SH4","props":{"codigo":"4105","descricao":"Peles curtidas ou <i>crust</i> de ovinos, depiladas, mesmo divididas, mas não preparadas de outro modo."}},{"id":"SH4:4106","tipo":"SH4","props":{"codigo":"4106","descricao":"Couros e peles, depilados, de outros animais e peles de animais desprovidos de pelos, curtidos ou <i>crust</i>, mesmo divididos, mas não preparados de outro modo."}},{"id":"SH4:4107","tipo":"SH4","props":{"codigo":"4107","descricao":"Couros preparados após curtimenta ou após secagem (<i>crusting</i>) e couros e peles apergaminhados, de bovinos (incluindo os búfalos) ou de equídeos, depilados, mesmo divididos, exceto os da posição 41.14."}},{"id":"SH4:4112","tipo":"SH4","props":{"codigo":"4112","descricao":null}},{"id":"SH4:4113","tipo":"SH4","props":{"codigo":"4113","descricao":"Couros preparados após curtimenta ou após secagem (<i>crusting</i>) e couros e peles apergaminhados, de outros animais, depilados, e couros preparados após curtimenta e couros e peles apergaminhados, de animais desprovidos de pelos, mesmo divididos, exceto os da posição 41.14."}},{"id":"SH4:4114","tipo":"SH4","props":{"codigo":"4114","descricao":"Couros e peles acamurçados (incluindo a camurça combinada); couros e peles envernizados ou revestidos; couros e peles metalizados."}},{"id":"SH4:4115","tipo":"SH4","props":{"codigo":"4115","descricao":"Couro reconstituído, à base de couro ou de fibras de couro, em chapas, folhas ou tiras, mesmo enroladas; aparas e outros desperdícios de couros ou de peles preparados ou de couro reconstituído, não utilizáveis para fabricação de obras de couro; serragem, pó e farinha, de couro."}},{"id":"SH4:4201","tipo":"SH4","props":{"codigo":"4201","descricao":null}},{"id":"SH4:4202","tipo":"SH4","props":{"codigo":"4202","descricao":"Baús (arcas) para viagem, malas e maletas, incluindo as maletas de toucador e as maletas e pastas de documentos e para estudantes, os estojos para óculos, binóculos, câmeras fotográficas e de filmar, instrumentos musicais, armas e artigos semelhantes; sacos de viagem, sacos isolantes para gêneros alimentícios e bebidas, bolsas de toucador, mochilas, bolsas, sacolas (sacos para compras), carteiras, porta-moedas, porta-cartões, cigarreiras, tabaqueiras, estojos para ferramentas, bolsas e sacos para artigos de esporte, estojos para frascos ou para joias, caixas para pó de arroz, estojos para ourivesaria e artigos semelhantes, de couro natural ou reconstituído, de folhas de plástico, de matérias têxteis, de fibra vulcanizada ou de cartão, ou recobertos, no todo ou na maior parte, dessas mesmas matérias ou de papel."}},{"id":"SH4:4203","tipo":"SH4","props":{"codigo":"4203","descricao":"Vestuário e seus acessórios, de couro natural ou reconstituído."}},{"id":"SH4:4205","tipo":"SH4","props":{"codigo":"4205","descricao":null}},{"id":"SH4:4206","tipo":"SH4","props":{"codigo":"4206","descricao":null}},{"id":"SH4:4301","tipo":"SH4","props":{"codigo":"4301","descricao":"Peles com pelo em bruto (incluindo as cabeças, caudas, patas e outras partes utilizáveis na indústria de peles), exceto as peles em bruto das posições 41.01, 41.02 ou 41.03."}},{"id":"SH4:4302","tipo":"SH4","props":{"codigo":"4302","descricao":"Peles com pelo curtidas ou acabadas (incluindo as cabeças, caudas, patas e outras partes, desperdícios e aparas), não reunidas (não montadas) ou reunidas (montadas) sem adição de outras matérias, com exceção das da posição 43.03."}},{"id":"SH4:4303","tipo":"SH4","props":{"codigo":"4303","descricao":"Vestuário, seus acessórios e outros artigos de peles com pelo."}},{"id":"SH4:4304","tipo":"SH4","props":{"codigo":"4304","descricao":null}},{"id":"SH4:4401","tipo":"SH4","props":{"codigo":"4401","descricao":"Lenha em qualquer forma; madeira em estilhas ou em partículas; serragem (serradura), desperdícios e resíduos, de madeira, mesmo aglomerados em toras (toros), briquetes, <i>pellets</i> ou em formas semelhantes."}},{"id":"SH4:4402","tipo":"SH4","props":{"codigo":"4402","descricao":"Carvão vegetal (incluindo o carvão de cascas ou de caroços), mesmo aglomerado."}},{"id":"SH4:4403","tipo":"SH4","props":{"codigo":"4403","descricao":"Madeira em bruto, mesmo descascada, desalburnada ou esquadriada."}},{"id":"SH4:4404","tipo":"SH4","props":{"codigo":"4404","descricao":"Arcos de madeira; estacas fendidas; estacas aguçadas, não serradas longitudinalmente; madeira simplesmente desbastada ou arredondada, não torneada, não recurvada nem trabalhada de qualquer outro modo, para fabricação de bengalas, guarda-chuvas, cabos de ferramentas e semelhantes; madeira em fasquias, lâminas, fitas e semelhantes."}},{"id":"SH4:4405","tipo":"SH4","props":{"codigo":"4405","descricao":null}},{"id":"SH4:4406","tipo":"SH4","props":{"codigo":"4406","descricao":"Dormentes de madeira para vias férreas ou semelhantes."}},{"id":"SH4:4407","tipo":"SH4","props":{"codigo":"4407","descricao":"Madeira serrada ou fendida longitudinalmente, cortada transversalmente ou desenrolada, mesmo aplainada, lixada ou unida pelas extremidades, de espessura superior a 6 mm."}},{"id":"SH4:4408","tipo":"SH4","props":{"codigo":"4408","descricao":"Folhas para folheados (incluindo as obtidas por corte de madeira estratificada), folhas para compensados (contraplacados) ou para madeiras estratificadas semelhantes e outras madeiras, serradas longitudinalmente, cortadas transversalmente ou desenroladas, mesmo aplainadas, lixadas, unidas pelas bordas ou pelas extremidades, de espessura não superior a 6 mm."}},{"id":"SH4:4409","tipo":"SH4","props":{"codigo":"4409","descricao":"Madeira (incluindo os tacos e frisos de parquê, não montados) perfilada (com espigas, ranhuras, filetes, entalhes, chanfrada, com juntas em V, com cercadura, boleada ou semelhantes) ao longo de uma ou mais bordas, faces ou extremidades, mesmo aplainada, lixada ou unida pelas extremidades."}},{"id":"SH4:4410","tipo":"SH4","props":{"codigo":"4410","descricao":"Painéis de partículas, painéis denominados <i>oriented strand board</i> (OSB) e painéis semelhantes (<i>waferboard</i>, por exemplo), de madeira ou de outras matérias lenhosas, mesmo aglomeradas com resinas ou com outros aglutinantes orgânicos."}},{"id":"SH4:4411","tipo":"SH4","props":{"codigo":"4411","descricao":"Painéis de fibras de madeira ou de outras matérias lenhosas, mesmo aglomeradas com resinas ou com outros aglutinantes orgânicos."}},{"id":"SH4:4412","tipo":"SH4","props":{"codigo":"4412","descricao":"Madeira compensada (contraplacada), madeira folheada, e madeiras estratificadas semelhantes."}},{"id":"SH4:4413","tipo":"SH4","props":{"codigo":"4413","descricao":null}},{"id":"SH4:4414","tipo":"SH4","props":{"codigo":"4414","descricao":"Molduras de madeira para quadros, fotografias, espelhos ou objetos semelhantes."}},{"id":"SH4:4415","tipo":"SH4","props":{"codigo":"4415","descricao":"Caixotes, caixas, engradados, barricas e embalagens semelhantes, de madeira; carretéis para cabos, de madeira; paletes simples, paletes-caixas e outros estrados para carga, de madeira; taipais de paletes de madeira."}},{"id":"SH4:4416","tipo":"SH4","props":{"codigo":"4416","descricao":null}},{"id":"SH4:4417","tipo":"SH4","props":{"codigo":"4417","descricao":null}},{"id":"SH4:4418","tipo":"SH4","props":{"codigo":"4418","descricao":"Obras de marcenaria e peças de carpintaria para construções, incluindo os painéis celulares, os painéis montados para revestimento de pisos (pavimentos) e as fasquias para telhados (<i>shingles</i> e <i>shakes</i>), de madeira."}},{"id":"SH4:4419","tipo":"SH4","props":{"codigo":"4419","descricao":"Artigos de madeira para mesa ou cozinha."}},{"id":"SH4:4420","tipo":"SH4","props":{"codigo":"4420","descricao":"Madeira marchetada e madeira incrustada; estojos e guarda-joias para joalheria e ourivesaria, e obras semelhantes, de madeira; estatuetas e outros objetos de ornamentação, de madeira; artigos de mobiliário, de madeira, que não se incluam no Capítulo 94."}},{"id":"SH4:4421","tipo":"SH4","props":{"codigo":"4421","descricao":"Outras obras em madeira."}},{"id":"SH4:4501","tipo":"SH4","props":{"codigo":"4501","descricao":"Cortiça natural, em bruto ou simplesmente preparada; desperdícios de cortiça; cortiça triturada, granulada ou pulverizada."}},{"id":"SH4:4502","tipo":"SH4","props":{"codigo":"4502","descricao":null}},{"id":"SH4:4503","tipo":"SH4","props":{"codigo":"4503","descricao":"Obras de cortiça natural."}},{"id":"SH4:4504","tipo":"SH4","props":{"codigo":"4504","descricao":"Cortiça aglomerada (mesmo com aglutinantes) e suas obras."}},{"id":"SH4:4601","tipo":"SH4","props":{"codigo":"4601","descricao":"Tranças e artigos semelhantes, de matérias para entrançar, mesmo reunidos em tiras; matérias para entrançar, tranças e artigos semelhantes, de matérias para entrançar, tecidos ou paralelizados, em formas planas, mesmo acabados (por exemplo, esteiras, capachos e divisórias)."}},{"id":"SH4:4602","tipo":"SH4","props":{"codigo":"4602","descricao":"Obras de cestaria obtidas diretamente na sua forma a partir de matérias para entrançar ou fabricadas com artigos da posição 46.01; obras de bucha (lufa*)."}},{"id":"SH4:4701","tipo":"SH4","props":{"codigo":"4701","descricao":null}},{"id":"SH4:4702","tipo":"SH4","props":{"codigo":"4702","descricao":null}},{"id":"SH4:4703","tipo":"SH4","props":{"codigo":"4703","descricao":"Pastas químicas de madeira, à soda ou ao sulfato, exceto pastas para dissolução."}},{"id":"SH4:4704","tipo":"SH4","props":{"codigo":"4704","descricao":"Pastas químicas de madeira, ao bissulfito, exceto pastas para dissolução."}},{"id":"SH4:4705","tipo":"SH4","props":{"codigo":"4705","descricao":null}},{"id":"SH4:4706","tipo":"SH4","props":{"codigo":"4706","descricao":"Pastas de fibras obtidas a partir de papel ou cartão reciclados (desperdícios e resíduos) ou de outras matérias fibrosas celulósicas."}},{"id":"SH4:4707","tipo":"SH4","props":{"codigo":"4707","descricao":"Papel ou cartão para reciclar (desperdícios e resíduos)."}},{"id":"SH4:4801","tipo":"SH4","props":{"codigo":"4801","descricao":null}},{"id":"SH4:4802","tipo":"SH4","props":{"codigo":"4802","descricao":"Papel e cartão, não revestidos, do tipo utilizado para escrita, impressão ou outros fins gráficos, e papel e cartão para fabricar cartões ou tiras perfurados, não perfurados, em rolos ou em folhas de forma quadrada ou retangular, de qualquer dimensão, com exclusão do papel das posições 48.01 ou 48.03; papel e cartão feitos à mão (folha a folha)."}},{"id":"SH4:4803","tipo":"SH4","props":{"codigo":"4803","descricao":null}},{"id":"SH4:4804","tipo":"SH4","props":{"codigo":"4804","descricao":"Papel e cartão, <i>Kraft</i>, não revestidos, em rolos ou em folhas, exceto os das posições 48.02 e 48.03."}},{"id":"SH4:4805","tipo":"SH4","props":{"codigo":"4805","descricao":"Outro papel e cartão, não revestidos, em rolos ou em folhas, não tendo sofrido trabalho complementar nem tratamentos, exceto os especificados na Nota 3 do presente Capítulo."}},{"id":"SH4:4806","tipo":"SH4","props":{"codigo":"4806","descricao":"Papel-pergaminho e cartão-pergaminho (sulfurizados), papel impermeável a gorduras, papel vegetal, papel cristal e outro papel calandrado transparente ou translúcido, em rolos ou em folhas."}},{"id":"SH4:4807","tipo":"SH4","props":{"codigo":"4807","descricao":null}},{"id":"SH4:4808","tipo":"SH4","props":{"codigo":"4808","descricao":"Papel e cartão ondulados (canelados*) (mesmo recobertos por colagem), encrespados, plissados, gofrados, estampados ou perfurados, em rolos ou em folhas, exceto o papel do tipo descrito no texto da posição 48.03."}},{"id":"SH4:4809","tipo":"SH4","props":{"codigo":"4809","descricao":"Papel-carbono (papel químico), papel autocopiativo e outro papel para cópia ou duplicação (incluindo o revestido ou impregnado, para estênceis ou para chapas ofsete), mesmo impresso, em rolos ou em folhas."}},{"id":"SH4:4810","tipo":"SH4","props":{"codigo":"4810","descricao":"Papel e cartão revestidos de caulim (caulino) ou de outras substâncias inorgânicas numa ou nas duas faces, mesmo com aglutinantes, sem qualquer outro revestimento, mesmo coloridos à superfície, decorados à superfície ou impressos, em rolos ou em folhas de forma quadrada ou retangular, de qualquer dimensão."}},{"id":"SH4:4811","tipo":"SH4","props":{"codigo":"4811","descricao":"Papel, cartão, pasta (<i>ouate</i>) de celulose e mantas de fibras de celulose, revestidos, impregnados, recobertos, coloridos à superfície, decorados à superfície ou impressos, em rolos ou em folhas de forma quadrada ou retangular, de qualquer dimensão, exceto os produtos do tipo descrito nos textos das posições 48.03, 48.09 ou 48.10."}},{"id":"SH4:4812","tipo":"SH4","props":{"codigo":"4812","descricao":null}},{"id":"SH4:4813","tipo":"SH4","props":{"codigo":"4813","descricao":"Papel para cigarros, mesmo cortado nas dimensões próprias, em cadernos ou em tubos."}},{"id":"SH4:4814","tipo":"SH4","props":{"codigo":"4814","descricao":"Papel de parede e revestimentos para parede semelhantes; papel para vitrais."}},{"id":"SH4:4816","tipo":"SH4","props":{"codigo":"4816","descricao":"Papel-carbono (papel químico), papel autocopiativo e outro papel para cópia ou duplicação (exceto os da posição 48.09), estênceis completos e chapas ofsete, de papel, mesmo acondicionados em caixas."}},{"id":"SH4:4817","tipo":"SH4","props":{"codigo":"4817","descricao":"Envelopes, aerogramas, cartões-postais não ilustrados e cartões para correspondência, de papel ou cartão; caixas, sacos e semelhantes, de papel ou cartão, que contenham um sortido de artigos para correspondência."}},{"id":"SH4:4818","tipo":"SH4","props":{"codigo":"4818","descricao":"Papel do tipo utilizado para papel higiênico e papel semelhante, pasta (ouate) de celulose ou mantas de fibras de celulose, do tipo utilizado para fins domésticos ou sanitários, em rolos de largura não superior a 36 cm, ou cortados em forma própria; lenços, lenços (toalhitas) demaquilantes, toalhas de mão, toalhas de mesa, guardanapos, lençóis e artigos semelhantes, de uso doméstico, de toucador, higiênicos ou hospitalares, vestuário e seus acessórios, de pasta de papel, papel, pasta (<i>ouate</i>) de celulose ou de mantas de fibras de celulose."}},{"id":"SH4:4819","tipo":"SH4","props":{"codigo":"4819","descricao":"Caixas, sacos, bolsas, cartuchos e outras embalagens, de papel, cartão, pasta (<i>ouate</i>) de celulose ou de mantas de fibras de celulose; cartonagens para escritórios, lojas e estabelecimentos semelhantes."}},{"id":"SH4:4820","tipo":"SH4","props":{"codigo":"4820","descricao":"Livros de registro e de contabilidade, blocos de notas, de encomendas, de recibos, de apontamentos, de papel para cartas, agendas e artigos semelhantes, cadernos, classificadores, encadernações (de folhas soltas ou outras), capas de processos e outros artigos escolares, de escritório ou de papelaria, incluindo os formulários em blocos de papel múltiplas vias, mesmo com folhas intercaladas de papel-carbono (papel químico), de papel ou cartão; álbuns para amostras ou para coleções e capas para livros, de papel ou cartão."}},{"id":"SH4:4821","tipo":"SH4","props":{"codigo":"4821","descricao":"Etiquetas de qualquer espécie, de papel ou cartão, impressas ou não."}},{"id":"SH4:4822","tipo":"SH4","props":{"codigo":"4822","descricao":"Carretéis, bobinas, canelas e suportes semelhantes, de pasta de papel, papel ou cartão, mesmo perfurados ou endurecidos."}},{"id":"SH4:4823","tipo":"SH4","props":{"codigo":"4823","descricao":"Outro papel, cartão, pasta (<i>ouate</i>) de celulose e mantas de fibras de celulose, cortados em forma própria; outras obras de pasta de papel, papel, cartão, pasta (<i>ouate</i>) de celulose ou de mantas de fibras de celulose."}},{"id":"SH4:4901","tipo":"SH4","props":{"codigo":"4901","descricao":"Livros, brochuras e impressos semelhantes, mesmo em folhas soltas."}},{"id":"SH4:4902","tipo":"SH4","props":{"codigo":"4902","descricao":"Jornais e publicações periódicas, impressos, mesmo ilustrados ou que contenham publicidade."}},{"id":"SH4:4903","tipo":"SH4","props":{"codigo":"4903","descricao":null}},{"id":"SH4:4904","tipo":"SH4","props":{"codigo":"4904","descricao":null}},{"id":"SH4:4905","tipo":"SH4","props":{"codigo":"4905","descricao":"Obras cartográficas de qualquer espécie, incluindo as cartas murais, as plantas topográficas e os globos, impressas."}},{"id":"SH4:4906","tipo":"SH4","props":{"codigo":"4906","descricao":null}},{"id":"SH4:4907","tipo":"SH4","props":{"codigo":"4907","descricao":null}},{"id":"SH4:4908","tipo":"SH4","props":{"codigo":"4908","descricao":"Decalcomanias de qualquer espécie."}},{"id":"SH4:4909","tipo":"SH4","props":{"codigo":"4909","descricao":null}},{"id":"SH4:4910","tipo":"SH4","props":{"codigo":"4910","descricao":null}},{"id":"SH4:4911","tipo":"SH4","props":{"codigo":"4911","descricao":"Outros impressos, incluindo as estampas, gravuras e fotografias."}},{"id":"SH4:5001","tipo":"SH4","props":{"codigo":"5001","descricao":null}},{"id":"SH4:5002","tipo":"SH4","props":{"codigo":"5002","descricao":null}},{"id":"SH4:5003","tipo":"SH4","props":{"codigo":"5003","descricao":null}},{"id":"SH4:5004","tipo":"SH4","props":{"codigo":"5004","descricao":null}},{"id":"SH4:5005","tipo":"SH4","props":{"codigo":"5005","descricao":null}},{"id":"SH4:5006","tipo":"SH4","props":{"codigo":"5006","descricao":null}},{"id":"SH4:5007","tipo":"SH4","props":{"codigo":"5007","descricao":"Tecidos de seda ou de desperdícios de seda."}},{"id":"SH4:5101","tipo":"SH4","props":{"codigo":"5101","descricao":"Lã não cardada nem penteada."}},{"id":"SH4:5102","tipo":"SH4","props":{"codigo":"5102","descricao":"Pelos finos ou grosseiros, não cardados nem penteados."}},{"id":"SH4:5103","tipo":"SH4","props":{"codigo":"5103","descricao":"Desperdícios de lã ou de pelos finos ou grosseiros, incluindo os desperdícios de fios e excluindo os fiapos."}},{"id":"SH4:5104","tipo":"SH4","props":{"codigo":"5104","descricao":null}},{"id":"SH4:5105","tipo":"SH4","props":{"codigo":"5105","descricao":"Lã, pelos finos ou grosseiros, cardados ou penteados (incluindo a \"lã penteada a granel\")."}},{"id":"SH4:5106","tipo":"SH4","props":{"codigo":"5106","descricao":"Fios de lã cardada, não acondicionados para venda a retalho."}},{"id":"SH4:5107","tipo":"SH4","props":{"codigo":"5107",