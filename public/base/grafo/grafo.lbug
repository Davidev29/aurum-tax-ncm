":"10","descricao":"Cereais."}},{"id":"Capitulo:11","tipo":"Capitulo","props":{"codigo":"11","descricao":"Produtos da indústria de moagem; malte; amidos e féculas; inulina; glúten de trigo."}},{"id":"Capitulo:12","tipo":"Capitulo","props":{"codigo":"12","descricao":"Sementes e frutos oleaginosos; grãos, sementes e frutos diversos; plantas industriais ou medicinais; palhas e forragens."}},{"id":"Capitulo:13","tipo":"Capitulo","props":{"codigo":"13","descricao":"Gomas, resinas e outros sucos e extratos vegetais."}},{"id":"Capitulo:14","tipo":"Capitulo","props":{"codigo":"14","descricao":"Matérias para entrançar e outros produtos de origem vegetal, não especificados nem compreendidos noutros Capítulos."}},{"id":"Capitulo:15","tipo":"Capitulo","props":{"codigo":"15","descricao":"Gorduras e óleos animais, vegetais ou de origem microbiana e produtos da sua dissociação; gorduras alimentícias elaboradas; ceras de origem animal ou vegetal."}},{"id":"Capitulo:16","tipo":"Capitulo","props":{"codigo":"16","descricao":"Preparações de carne, peixes, crustáceos, moluscos, outros invertebrados aquáticos ou de insetos."}},{"id":"Capitulo:17","tipo":"Capitulo","props":{"codigo":"17","descricao":"Açúcares e produtos de confeitaria."}},{"id":"Capitulo:18","tipo":"Capitulo","props":{"codigo":"18","descricao":"Cacau e suas preparações."}},{"id":"Capitulo:19","tipo":"Capitulo","props":{"codigo":"19","descricao":"Preparações à base de cereais, farinhas, amidos, féculas ou leite; produtos de pastelaria."}},{"id":"Capitulo:20","tipo":"Capitulo","props":{"codigo":"20","descricao":"Preparações de produtos hortícolas, fruta ou de outras partes de plantas."}},{"id":"Capitulo:21","tipo":"Capitulo","props":{"codigo":"21","descricao":"Preparações alimentícias diversas."}},{"id":"Capitulo:22","tipo":"Capitulo","props":{"codigo":"22","descricao":"Bebidas, líquidos alcoólicos e vinagres."}},{"id":"Capitulo:23","tipo":"Capitulo","props":{"codigo":"23","descricao":"Resíduos e desperdícios das indústrias