# Identidade do produto + endpoints Aurumbit (camada src/aurum/).
#
# COMO USAR: copie para `.env.local` (ignorado pelo git) e ajuste por produto.
# Tudo aqui é embutido no build (Vite) — o usuário nunca preenche em tela.
# Sem este arquivo, valem os padrões de src/aurum/config.ts.

# --- Bases (JÁ incluem o prefixo) ---
# BFF do portal p/ CONTA: activate {productId}, invoices, checkout e /auth/*.
VITE_AURUM_BFF_URL=https://seu-portal/api/me
# Nest direto p/ /v1/*: activate-by-key, validate, access/check, products/plans.
VITE_AURUM_API_URL=https://api.aurumbit.com/v1

# --- Identidade (code EXATO do admin em /produtos, case-sensitive) ---
# ID = CODE. Enviado como `productId` (activate) e `productCode` (checkout).
VITE_AURUM_PRODUCT_ID=AURUM_TAX_NCM
# Omita se igual ao ID (cai no PRODUCT_ID).
VITE_AURUM_PRODUCT_CODE=AURUM_TAX_NCM
# Só display (faixa da ativação, aba Conta).
VITE_AURUM_PRODUCT_NAME=Aurum Tax NCM
# UUID do plano p/ renovar em 1 toque. Vazio = a tela lista os ACTIVE em
# GET /v1/products/:code/plans e deixa escolher.
VITE_AURUM_PLAN_ID=

# Painel onde o usuário libera slots (409 DEVICE_LIMIT → /dashboard/sistemas).
# Vazio = raiz do portal (BFF sem o /api/me final).
VITE_AURUM_DASHBOARD_URL=
