{
  "name": "aurum-tax-ncm",
  "productName": "Aurum Tax NCM",
  "version": "1.0.0",
  "description": "Aurum Tax NCM — Classificador fiscal da Reforma Tributária (LC 214/2025). Classifica por NCM e gera relatórios.",
  "author": "Aurum Bit Labs & Studios LTDA",
  "copyright": "© Aurum Bit Labs & Studios LTDA. Todos os direitos reservados.",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Davidev29/aurum-tax-ncm.git"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "base": "node scripts/build-base.mjs",
    "base:completa": "node scripts/build-base.mjs && node scripts/preparar-dados-ia.mjs && node scripts/gerar-indice-ia.mjs --lexical && node scripts/validar-conhecimento.mjs",
    "ia:indice": "node scripts/gerar-indice-ia.mjs",
    "ia:embeddings": "node scripts/gerar-embeddings.mjs",
    "ia:testar-indice": "node scripts/testar-indice-ia.mjs",
    "ia:validar-conhecimento": "node scripts/validar-conhecimento.mjs",
    "ia:finetuning": "node scripts/gerar-finetuning-ncm.mjs",
    "ia:finetuning-nbs": "node scripts/gerar-finetuning-nbs.mjs",
    "ia:finetuning-cnae": "node scripts/gerar-finetuning-cnae.mjs",
    "ia:finetuning-tudo": "node scripts/gerar-finetuning-ncm.mjs && node scripts/gerar-finetuning-nbs.mjs && node scripts/gerar-finetuning-cnae.mjs",
    "grafo:rebuild": "node scripts/build-grafo.mjs --forcar",
    "ia:cobertura": "node scripts/cobertura-traducao.mjs --min 8 --top 25",
    "ofuscar": "node scripts/ofuscar-build.cjs",
    "ofuscar:check": "node scripts/ofuscar-build.cjs --check",
    "verificar": "node scripts/verificar-build.mjs",
    "verificar:pre": "node scripts/verificar-build.mjs --pre",
    "predev": "node scripts/kill-port.mjs 5173 && npm run base && npm run build:electron",
    "dev": "concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "prestart": "npm run build",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron": "npm run build:electron && wait-on -t 60000 tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:web": "vite",
    "build:electron": "node electron/esbuild.mjs",
    "build": "npm run base:completa && tsc --noEmit && vite build && npm run build:electron && node scripts/ofuscar-build.cjs && node scripts/verificar-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "icon": "node scripts/make-icon.mjs",
    "ia:catalogo": "node scripts/gerar-catalogo-rag.mjs --check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^13.4.6",
    "node-llama-cpp": "^3.22.1",
    "pdfmake": "^0.3.11",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "javascript-obfuscator": "^5.8.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "br.com.aurumbitlabs.aurumtaxncm",
    "productName": "Aurum Tax NCM",
    "publish": [
      {
        "provider": "github",
        "owner": "Davidev29",
        "repo": "aurum-tax-ncm",
        "private": true,
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/.planning/**",
      "!**/docs/**",
      "!**/tests/**",
      "!**/scripts/**",
      "!**/electron/spike/**",
      "!**/recursos-ia/modelo/**",
      "!**/recursos-ia/embedding/**"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack-ia.cjs",
    "extraResources": [
      {
        "from": "recursos-ia/dados-brutos",
        "to": "recursos-ia/dados-brutos",
        "filter": [
          "**/*",
          "!**/.gitkeep"
        ]
      },
      {
        "from": "recursos-ia/indice-ncm/indice-lexical.json",
        "to": "recursos-ia/indice-ncm/indice-lexical.json"
      },
      {
        "from": "recursos-ia/indice-ncm/.manifest-hash",
        "to": "recursos-ia/indice-ncm/.manifest-hash"
      },
      {
        "from": "recursos-ia/indice-ncm/sinonimos-gerados.json",
        "to": "recursos-ia/indice-ncm/sinonimos-gerados.json"
      },
      {
        "from": "recursos-ia/conhecimento",
        "to": "recursos-ia/conhecimento",
        "filter": [
          "**/*.json",
          "**/*.md"
        ]
      },
      {
        "from": "recursos-ia/CHECKSUMS.txt",
        "to": "recursos-ia/CHECKSUMS.txt"
      },
      {
        "from": "recursos-ia/modelo",
        "to": "recursos-ia/modelo",
        "filter": [
          "**/*.gguf",
          "**/*.json"
        ]
      },
      {
        "from": "public/base/grafo/grafo.lbug",
        "to": "recursos-ia/grafo/grafo.lbug"
      },
      {
        "from": "public/base/grafo/grafo.lbug.json",
        "to": "recursos-ia/grafo/grafo.lbug.json"
      },
      {
        "from": "public/base/grafo/MANIFEST.grafo.json",
        "to": "recursos-ia/grafo/MANIFEST.grafo.json"
      },
      {
        "from": "public/base/grafo/vetores.json",
        "to": "recursos-ia/grafo/vetores.json"
      },
      {
        "from": "recursos-ia/embedding/vetores-ncm.json",
        "to": "recursos-ia/embedding/vetores-ncm.json"
      },
      {
        "from": "recursos-ia/embedding/MANIFEST-embedding.json",
        "to": "recursos-ia/embedding/MANIFEST-embedding.json"
      }
    ],
    "asarUnpack": [
      "electron/dist/ia-worker.cjs",
      "electron/dist/caminhos-ia.cjs",
      "electron/dist/modelo-seguro.cjs",
      "electron/dist/perfil-modelo.cjs",
      "electron/dist/grafo-service.cjs",
      "dist/base/grafo/grafo.lbug"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AurumTaxNCM-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurum Tax NCM",
      "language": "1046",
      "license": "build/LICENCA.rtf",
      "installerHeaderIcon": "build/icon.ico",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "menuCategory": "Aurum Tax",
      "runAfterFinish": true,
      "artifactName": "AurumTaxNCM-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AurumTaxNCM-Portatil-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": null,
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
